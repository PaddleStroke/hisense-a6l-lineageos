+/*
+ * spmi_haptics_write_int_pwm() - program the internal PWM drive carrier.
+ *
+ * The stock A6L qpnp-haptic driver programs HAP_INT_PWM_REG (0x56) and
+ * HAP_PWM_CAP_REG (0x58) to the board value (qcom,int-pwm-freq-khz = 505 kHz)
+ * for LRA direct-mode drive synthesis. The pmi8998 mainline driver never wrote
+ * these, leaving the PM660 carrier at its reset default. A zero freq means the
+ * property was absent: keep prior (unprogrammed) behavior so this is opt-in.
+ */
+static int spmi_haptics_write_int_pwm(struct spmi_haptics *haptics)
+{
+	u8 sel, val;
+	int ret;
+
+	if (!haptics->int_pwm_freq_khz)
+		return 0;
+
+	switch (haptics->int_pwm_freq_khz) {
+	case HAP_INT_PWM_FREQ_253_KHZ:  sel = 0; break;
+	case HAP_INT_PWM_FREQ_505_KHZ:  sel = 1; break;
+	case HAP_INT_PWM_FREQ_739_KHZ:  sel = 2; break;
+	case HAP_INT_PWM_FREQ_1076_KHZ: sel = 3; break;
+	default:
+		dev_err(haptics->dev, "unsupported qcom,int-pwm-freq-khz: %u\n",
+			haptics->int_pwm_freq_khz);
+		return -EINVAL;
+	}
+
+	val = FIELD_PREP(HAP_INT_PWM_FREQ_MASK, sel);
+	ret = spmi_haptics_write_masked(haptics, haptics->base + HAP_INT_PWM_REG,
+					HAP_INT_PWM_FREQ_MASK, val);
+	if (ret < 0)
+		return ret;
+
+	val = FIELD_PREP(HAP_PWM_CAP_MASK, sel);
+	return spmi_haptics_write_masked(haptics, haptics->base + HAP_PWM_CAP_REG,
+					 HAP_PWM_CAP_MASK, val);
+}
