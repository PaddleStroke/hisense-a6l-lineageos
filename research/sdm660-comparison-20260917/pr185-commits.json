[{"sha":"bc41d2d94fc0638b8b98f732fce555c9d734a051","node_id":"C_kwDOS6XaSdoAKGJjNDFkMmQ5NGZjMDYzOGI4Yjk4ZjczMmZjZTU1NWM5ZDczNGEwNTE","commit":{"author":{"name":"Adrian Nguyen","email":"thenguyen1024@gmail.com","date":"2026-06-14T15:23:05Z"},"committer":{"name":"Adrian Nguyen","email":"thenguyen1024@gmail.com","date":"2026-06-14T15:23:05Z"},"message":"dt-bindings: display: panel: himax,hx83112a: add Vsmart Active 1 panel\n\nAdd a compatible for the DJN HX83112A 1080x2160 panel on the Vsmart\nActive 1 (PQ6001 / BQ Aquaris X2 Pro). Turn the single compatible into an\nenum so it holds both the existing Fairphone 3 panel and the new one.\n\nAssisted-by: Claude:claude-opus-4-8\nSigned-off-by: Adrian Nguyen <thenguyen1024@gmail.com>","tree":{"sha":"1fb6b7d60162e20b02878ef2613ceba0ff96a0f6","url":"https://api.github.com/repos/sdm660-mainline/linux/git/trees/1fb6b7d60162e20b02878ef2613ceba0ff96a0f6"},"url":"https://api.github.com/repos/sdm660-mainline/linux/git/commits/bc41d2d94fc0638b8b98f732fce555c9d734a051","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/sdm660-mainline/linux/commits/bc41d2d94fc0638b8b98f732fce555c9d734a051","html_url":"https://github.com/sdm660-mainline/linux/commit/bc41d2d94fc0638b8b98f732fce555c9d734a051","comments_url":"https://api.github.com/repos/sdm660-mainline/linux/commits/bc41d2d94fc0638b8b98f732fce555c9d734a051/comments","author":{"login":"fudio101","id":38380477,"node_id":"MDQ6VXNlcjM4MzgwNDc3","avatar_url":"https://avatars.githubusercontent.com/u/38380477?v=4","gravatar_id":"","url":"https://api.github.com/users/fudio101","html_url":"https://github.com/fudio101","followers_url":"https://api.github.com/users/fudio101/followers","following_url":"https://api.github.com/users/fudio101/following{/other_user}","gists_url":"https://api.github.com/users/fudio101/gists{/gist_id}","starred_url":"https://api.github.com/users/fudio101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fudio101/subscriptions","organizations_url":"https://api.github.com/users/fudio101/orgs","repos_url":"https://api.github.com/users/fudio101/repos","events_url":"https://api.github.com/users/fudio101/events{/privacy}","received_events_url":"https://api.github.com/users/fudio101/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"fudio101","id":38380477,"node_id":"MDQ6VXNlcjM4MzgwNDc3","avatar_url":"https://avatars.githubusercontent.com/u/38380477?v=4","gravatar_id":"","url":"https://api.github.com/users/fudio101","html_url":"https://github.com/fudio101","followers_url":"https://api.github.com/users/fudio101/followers","following_url":"https://api.github.com/users/fudio101/following{/other_user}","gists_url":"https://api.github.com/users/fudio101/gists{/gist_id}","starred_url":"https://api.github.com/users/fudio101/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fudio101/subscriptions","organizations_url":"https://api.github.com/users/fudio101/orgs","repos_url":"https://api.github.com/users/fudio101/repos","events_url":"https://api.github.com/users/fudio101/events{/privacy}","received_events_url":"https://api.github.com/users/fudio101/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a587e4f18b483d0a17579e6325c861b303988bda","url":"https://api.github.com/repos/sdm660-mainline/linux/commits/a587e4f18b483d0a17579e6325c861b303988bda","html_url":"https://github.com/sdm660-mainline/linux/commit/a587e4f18b483d0a17579e6325c861b303988bda"}]},{"sha":"9852b7465598d794a3b691214e2eb347aeb2fe32","node_id":"C_kwDOS6XaSdoAKDk4NTJiNzQ2NTU5OGQ3OTRhM2I2OTEyMTRlMmViMzQ3YWViMmZlMzI","commit":{"author":{"name":"Adrian Nguyen","email":"thenguyen1024@gmail.com","date":"2026-06-14T15:23:06Z"},"committer":{"name":"Adrian Nguyen","email":"thenguyen1024@gmail.com","date":"2026-06-14T15:23:06Z"},"message":"drm/panel: himax-hx83112a: add Vsmart Active 1 DJN 1080x2160 variant\n\nThe Vsmart Active 1 uses a DJN HX83112A panel in a 1080x2160 mode that\ndiffers from the Fairphone 3 (1080x2340). Convert the driver to a\nmulti-variant driver driven by a panel descriptor (display mode, DSI\nmode flags, pixel format, lane count, init sequence and whether to pulse\nreset), keeping the existing djn,9a-3r063-1102b behaviour byte-for-byte.\n\nThis is a TDDI panel whose full HX83112A register init is performed by\nthe bootloader. The downstream vendor kernel device tree confirms this is\nby design: it ships the same minimal on-command (exit-sleep + display-on\nonly) for this panel and its HX83112A siblings (DJN, Truly and DJN11),\nwith no register programming in DT. So the new djn,a1-hx83112a variant\nonly issues those two commands and leaves the reset line deasserted to\npreserve the bootloader init; pulsing reset would require the full\nsequence, which the vendor never exposes in DT.\n\nAssisted-by: Claude:claude-opus-4-8\nSigned-off-by: Adrian Nguyen <thenguyen1024@gmail.com>","tree":{"sha":"ddb7533fc6eafe6dd114057173534239afa427b4","url":"https://api.github.com/repos/sdm660-mainline/linux/git/trees/ddb7533fc6eafe6dd114057173534239afa427b4"},"url":"https://api.github.com/repos/sdm660-mainline/linux/git/commits/9852b7465598d794a3b691214e2eb347aeb2fe32","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/sdm660-mainline/linux/commits/9852b7465598d794a3b691214e2eb347aeb2fe32","html_url":"https://github.com/sdm660-mainline/linux/commit/9852b7465598d794a3b691214e2eb347aeb2fe32","comments_url":"https://api.github.com/repos/sdm660-mainline/linux/commits/9852b7465598d794a3b691214e2eb347aeb2fe32/comments","author":{"login":"fudio101","id":38380477,"node_id":"MDQ6VXNlcjM4MzgwNDc3","avatar_url":"https://avatars.githubusercontent.com/u/38380477?v=4","gravatar_id":"","url":"https://api.github.c