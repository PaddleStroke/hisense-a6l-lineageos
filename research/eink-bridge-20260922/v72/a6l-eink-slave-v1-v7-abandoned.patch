+/* Hisense A6L: on the SDM660 14nm PHY pair the DSI1 lanes can only be clocked from DSI0's PLL
+ * (stock always configures ctrl1 as PLL slave). Enabled with msm.a6l_eink_slave=1. */
+static bool a6l_eink_slave;
+module_param(a6l_eink_slave, bool, 0444);
+MODULE_PARM_DESC(a6l_eink_slave, "Hisense A6L: clock the DSI1 PHY lanes from the DSI0 PLL");
+
+static void a6l_apply_usecase(void)
+{
+	struct msm_dsi *d0 = dsi_mgr_get_dsi(DSI_0), *d1 = dsi_mgr_get_dsi(DSI_1);
+
+	if (!a6l_eink_slave || !d0 || !d1)
+		return;
+	msm_dsi_phy_set_usecase(d0->phy, MSM_DSI_PHY_MASTER);
+	msm_dsi_phy_set_usecase(d1->phy, MSM_DSI_PHY_SLAVE);
+	pr_info("a6l_eink_slave: DSI0 PHY = PLL master, DSI1 PHY = PLL slave\n");
+}
+
+static bool a6l_phys_on;	/* both PHYs currently enabled through the pair path */
+
+static bool a6l_pair(void)
+{
+	return a6l_eink_slave && dsi_mgr_get_dsi(DSI_CLOCK_MASTER) && dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+}
