 							msm_dsi : other_dsi;
@@ -146,7 +172,22 @@ dsi_mgr_phy_enable(int id,
 	 * will silently reset those PHY1 registers. Therefore we need to reset
 	 * and enable both PHYs before any PLL clock operation.
 	 */
-	if (IS_BONDED_DSI() && mdsi && sdsi) {
+	if (a6l_pair() && mdsi && sdsi) {
+		if (!a6l_phys_on) {
+			msm_dsi_host_reset_phy(mdsi->host);
+			msm_dsi_host_reset_phy(sdsi->host);
+			ret = enable_phy(mdsi, &shared_timings[DSI_CLOCK_MASTER]);
+			if (ret)
+				return ret;
+			ret = enable_phy(sdsi, &shared_timings[DSI_CLOCK_SLAVE]);
+			if (ret) {
+				msm_dsi_phy_disable(mdsi->phy);
+				return ret;
+			}
+			a6l_phys_on = true;
+			pr_info("a6l_eink_slave: PHY pair enabled (by DSI%d)\n", id);
+		}
+	} else if (IS_BONDED_DSI() && mdsi && sdsi) {
 		if (!mdsi->phy_enabled && !sdsi->phy_enabled) {
 			msm_dsi_host_reset_phy(mdsi->host);
 			msm_dsi_host_reset_phy(sdsi->host);
@@ -185,7 +226,14 @@ static void dsi_mgr_phy_disable(int id)
 	 * first controller only when the second controller is disabled.
 	 */
 	msm_dsi->phy_enabled = false;
-	if (IS_BONDED_DSI() && mdsi && sdsi) {
+	if (a6l_pair() && mdsi && sdsi) {
+		if (a6l_phys_on && !mdsi->phy_enabled && !sdsi->phy_enabled) {
+			msm_dsi_phy_disable(sdsi->phy);
+			msm_dsi_phy_disable(mdsi->phy);
+			a6l_phys_on = false;
+			pr_info("a6l_eink_slave: PHY pair disabled (by DSI%d)\n", id);
+		}
+	} else if (IS_BONDED_DSI() && mdsi && sdsi) {
 		if (!mdsi->phy_enabled && !sdsi->phy_enabled) {
 			msm_dsi_phy_disable(sdsi->phy);
 			msm_dsi_phy_disable(mdsi->phy);
@@ -224,12 +272,23 @@ static int dsi_mgr_bridge_power_on(struct drm_bridge *bridge)
 	if (ret)
 		goto phy_en_fail;
 
+	if (a6l_eink_slave && id == DSI_1 && dsi_mgr_get_dsi(DSI_0))
+		msm_dsi_host_a6l_src_pll(host, dsi_mgr_get_dsi(DSI_0)->host);
+
 	ret = msm_dsi_host_power_on(host, &phy_shared_timings[id], is_bonded_dsi, msm_dsi->phy);
 	if (ret) {
 		pr_err("%s: power on host %d failed, %d\n", __func__, id, ret);
 		goto host_on_fail;
 	}
 
+	if (a6l_eink_slave && id == DSI_1 && dsi_mgr_get_dsi(DSI_0)) {
+		struct msm_dsi *d0 = dsi_mgr_get_dsi(DSI_0);
+		u32 v = msm_dsi_host_a6l_postdiv_val(host, d0->host);
+		u32 o0 = msm_dsi_phy_a6l_clkcfg0(d0->phy, !!v, v), o1 = msm_dsi_phy_a6l_clkcfg0(msm_dsi->phy, !!v, v);
+
