+/* Hisense A6L (SDM660, 14nm PHY): DSI1 lanes are clocked from DSI0's PLL, so the DSI1 controller
+ * byte/pixel RCGs must be parented to DSI0's PLL outputs as well. */
+int msm_dsi_host_a6l_src_pll(struct mipi_dsi_host *host, struct mipi_dsi_host *src)
+{
+	struct msm_dsi_host *mh = to_msm_dsi_host(host), *sh = to_msm_dsi_host(src);
+	struct clk *bsrc = clk_get_parent(sh->byte_clk), *psrc = clk_get_parent(sh->pixel_clk);
+	struct clk *bpll = bsrc ? clk_get_parent(bsrc) : NULL, *ppll = psrc ? clk_get_parent(psrc) : NULL;
+	struct clk *mb = clk_get_parent(mh->byte_clk), *mp = clk_get_parent(mh->pixel_clk);
+	int r1, r2;
+
+	if (!bpll || !ppll || !mb || !mp) {
+		pr_err("a6l_src_pll: clocks missing (%p %p %p %p)\n", bpll, ppll, mb, mp);
+		return -ENODEV;
+	}
+	r1 = clk_set_parent(mb, bpll);
+	r2 = clk_set_parent(mp, ppll);
+	pr_info("a6l_src_pll: %s -> %s (%d), %s -> %s (%d)\n", __clk_get_name(mb), __clk_get_name(bpll), r1,
+		__clk_get_name(mp), __clk_get_name(ppll), r2);
+	/* retune PLL0 to this host's link rates. The 14nm PLL reports rate 0 while unlocked, which makes the
+	 * post-divider maths wrong, so lock it first, set byte (owns the VCO) then pixel (n2 only), release. */
+	r1 = clk_prepare_enable(bpll);
+	if (r1)
+		pr_err("a6l_src_pll: prepare %s failed %d\n", __clk_get_name(bpll), r1);
+	/* nudge away and back: the cached-state restore programs the VCO with a 0 reference rate and the
+	 * framework would otherwise skip our request as "already at that rate" */
+	r1 = clk_set_rate(bpll, mh->byte_clk_rate - 100000);
+	pr_info("a6l_src_pll: nudge byte -> %lu (%d)\n", clk_get_rate(bpll), r1);
+	r1 = clk_set_rate(bpll, mh->byte_clk_rate);
+	r2 = clk_set_rate(ppll, mh->pixel_clk_rate);
+	pr_info("a6l_src_pll: byte %lu -> %lu (%d), pixel %lu -> %lu (%d)\n", mh->byte_clk_rate, clk_get_rate(bpll), r1,
+		mh->pixel_clk_rate, clk_get_rate(ppll), r2);
+	clk_disable_unprepare(bpll);
+	return r1 ? r1 : r2;
+}
+
+
+u32 msm_dsi_host_a6l_postdiv_val(struct mipi_dsi_host *host, struct mipi_dsi_host *src)
+{
+	struct msm_dsi_host *mh = to_msm_dsi_host(host), *sh = to_msm_dsi_host(src);
+	struct clk *bsrc = clk_get_parent(sh->byte_clk), *bpll = bsrc ? clk_get_parent(bsrc) : NULL;
+	struct clk *n1 = bpll ? clk_get_parent(bpll) : NULL, *vco = n1 ? clk_get_parent(n1) : NULL;
+	unsigned long vrate = vco ? clk_get_rate(vco) : 0;
+	u32 d1, d2;
+
+	if (!vrate || !mh->byte_clk_rate || !mh->pixel_clk_rate)
+		return 0;
+	d1 = DIV_ROUND_CLOSEST(vrate, mh->byte_clk_rate * 8);
+	d2 = DIV_ROUND_CLOSEST(vrate / d1 / 2, mh->pixel_clk_rate);
+	pr_info("a6l_postdiv: vco %lu byte %lu pixel %lu -> n1=%u n2=%u\n", vrate, mh->byte_clk_rate, mh->pixel_clk_rate, d1, d2);
+	if (d1 < 1 || d1 > 15 || d2 < 1 || d2 > 15)
+		return 0;
+	return d1 | (d2 << 4);
+}
