+
+/* Hisense A6L experiment: read/write the 14nm CMN CLK_CFG0 post-divider register directly. */
+u32 msm_dsi_phy_a6l_clkcfg0(struct msm_dsi_phy *phy, int write, u32 val)
+{
+	u32 old = readl(phy->base + 0x10);
+
+	if (write)
+		writel(val, phy->base + 0x10);
+	return old;
+}
