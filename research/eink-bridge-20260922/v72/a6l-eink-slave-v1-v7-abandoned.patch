 static int dsi_mgr_setup_components(int id)
 {
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
@@ -84,6 +109,7 @@ static int dsi_mgr_setup_components(int id)
 		ret = msm_dsi_host_register(msm_dsi->host);
 		if (ret)
