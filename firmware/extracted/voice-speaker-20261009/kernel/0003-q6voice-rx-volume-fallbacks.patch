+/*
+ * A6L voice-speaker-20261009: the CVP rejects VSS_IVOLUME_CMD_SET_STEP with APR EFAILED (no volume calibration
+ * registered). Runtime-writable experiment, logged as "A6L_Q6VOICE rx volume ...":
+ *   rx_vol_mode -1 = auto: SET_STEP; on failure SET_NUMBER_OF_STEPS(rx_vol_nsteps) + SET_STEP; on failure
+ *                    SET_RX_VOLUME_INDEX (each ADSP failure is one quick APR error reply)
+ *                0 = SET_STEP only (the r5 F37 behaviour), 1 = SET_NUMBER_OF_STEPS + SET_STEP, 2 = SET_RX_VOLUME_INDEX
+ */
+static int rx_vol_mode = -1;
+module_param(rx_vol_mode, int, 0644);
+MODULE_PARM_DESC(rx_vol_mode, "A6L RX volume command: -1 auto, 0 SET_STEP, 1 NUMBER_OF_STEPS+SET_STEP, 2 RX_VOLUME_INDEX");
+static int rx_vol_nsteps = 6;
+module_param(rx_vol_nsteps, int, 0644);
+MODULE_PARM_DESC(rx_vol_nsteps, "A6L steps announced with VSS_IVOLUME_CMD_SET_NUMBER_OF_STEPS (a6l-q6voiced -V 5 = 6 steps)");
+
