 #define VSS_IVOLUME_CMD_SET_STEP			0x000112C2
+/*
+ * A6L voice-speaker-20261009: SET_STEP fails with APR status 1 (EFAILED, not 3 EUNSUPPORTED) on every step, before and
+ * after MVM start: the command exists but the vocproc has nothing to index (stock registers the ACDB volume table with
+ * VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA; this driver registers no calibration). Two in-band alternatives of the
+ * same interface family, tried by q6voice (module parameter rx_vol_mode) to settle it on the phone:
+ *   VSS_IVOLUME_CMD_SET_NUMBER_OF_STEPS (u32 steps), the client's step count, sent before SET_STEP;
+ *   VSS_IVOCPROC_CMD_SET_RX_VOLUME_INDEX (u16 index), the pre-SET_STEP vocproc volume command (msm-3.x voice.c).
+ */
+#define VSS_IVOLUME_CMD_SET_NUMBER_OF_STEPS		0x000112C1
+#define VSS_IVOCPROC_CMD_SET_RX_VOLUME_INDEX		0x000110EE
 
