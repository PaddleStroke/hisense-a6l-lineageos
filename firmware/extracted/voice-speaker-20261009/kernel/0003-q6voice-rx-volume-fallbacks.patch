+/* A6L voice-speaker-20261009: downlink volume step on the vocproc with the rx_vol_mode fallbacks; 0 or -errno */
+static int q6voice_cvp_rx_volume(struct device *dev, struct q6voice_session *cvp, int step, u16 ramp_ms)
+{
+	int mode = rx_vol_mode, n, r1, ret = -EINVAL;
+
+	if (mode <= 0) {
+		ret = q6cvp_set_rx_vol_step(cvp, step, ramp_ms);
+		if (!ret || mode == 0)
+			return ret;
+	}
+	if (mode < 0 || mode == 1) {
+		n = clamp(rx_vol_nsteps, 1, Q6VOICE_RX_VOL_STEP_MAX + 1);
+		r1 = q6cvp_set_num_vol_steps(cvp, n);
+		ret = q6cvp_set_rx_vol_step(cvp, min(step, n - 1), ramp_ms);
+		dev_info(dev, "A6L_Q6VOICE rx volume SET_NUMBER_OF_STEPS(%d): %d, then SET_STEP(%d): %d\n",
+			 n, r1, min(step, n - 1), ret);
+		if (!ret || mode == 1)
+			return ret;
+	}
+	ret = q6cvp_set_rx_vol_index(cvp, step);
+	dev_info(dev, "A6L_Q6VOICE rx volume SET_RX_VOLUME_INDEX(%d): %d\n", step, ret);
+	return ret;
+}
