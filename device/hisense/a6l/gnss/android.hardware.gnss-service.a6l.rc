# A6L AIDL GNSS HAL (agent gnss, 24 Sep 2026). Talks to the modem's QMI LOC service over AF_QIPCRTR. Harmless while the
# radio is off (persist.vendor.a6l.radio=0): it waits for the LOC service to appear on the QRTR name service.
# seclabel: rom-v1 is permissive without the vendor sepolicy; with gnss/sepolicy/vendor in BOARD_VENDOR_SEPOLICY_DIRS the
# file label hal_gnss_default_exec gives the same domain.
service vendor.gnss-a6l /vendor/bin/hw/android.hardware.gnss-service.a6l
    class hal
    user gps
    group gps system inet
    seclabel u:r:hal_gnss_default:s0
