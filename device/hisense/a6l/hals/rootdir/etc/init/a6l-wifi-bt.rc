# Hisense A6L Wi-Fi (ath10k_snoc, WCN3990 via nl80211) and Bluetooth (WCN3990 over serdev hci_uart/QCA) glue.
# agent hals, 24 Sep 2026. Wi-Fi needs the modem up (a6l-radio.rc, RF gate persist.vendor.a6l.radio.enable=1).

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

on boot
    setprop wifi.interface wlan0
    setprop wifi.direct.interface p2p-dev-wlan0
    # BT: give hci0 a public address so the kernel marks it configured (AOSP HAL lists configured controllers only)
    start vendor.a6l-bt-addr

# Started by the Wi-Fi framework through the supplicant AIDL interface (lazy).
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1p2p_device=1 \
        -m/vendor/etc/wifi/p2p_supplicant.conf \
        -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    group system wifi inet
    user root
    disabled
    oneshot

# Factory WLAN MAC from persist (Intf0MacAddress=), applied while wlan0 is still down. Started by a6l-modem.sh
# once the modem runs; waits up to 120 s for wlan0 (created when the modem's WLAN fw service comes up).
service vendor.a6l-wlan-mac /vendor/bin/a6l_macs wlan -i wlan0 -w 120
    user root
    group root system
    disabled
    oneshot

service vendor.a6l-bt-addr /vendor/bin/a6l_macs bt -x 0 -w 30
    user root
    group root bluetooth net_admin
    capabilities NET_ADMIN
    disabled
    oneshot
