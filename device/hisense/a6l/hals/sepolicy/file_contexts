# Hisense A6L mainline HAL layer (agent hals). Standard AOSP default-HAL binaries are labelled by system/sepolicy/vendor.
/vendor/bin/rmtfs                  u:object_r:a6l_rmtfs_exec:s0
/vendor/bin/tqftpserv              u:object_r:a6l_tqftpserv_exec:s0
/vendor/bin/diag-router            u:object_r:a6l_diag_exec:s0
/vendor/bin/a6l-modem\.sh          u:object_r:a6l_modem_exec:s0
/vendor/bin/a6l_macs               u:object_r:a6l_macs_exec:s0
/vendor/bin/hw/android\.hardware\.usb\.gadget-service\.a6l   u:object_r:hal_usb_gadget_default_exec:s0
/vendor/bin/hw/android\.hardware\.light-service\.lineage     u:object_r:hal_light_default_exec:s0
/vendor/bin/hw/android\.hardware\.usb-service\.basic         u:object_r:hal_usb_default_exec:s0
/mnt/vendor/rmtfs(/.*)?            u:object_r:a6l_rmtfs_data_file:s0
/data/vendor/tmp/tqftpserv(/.*)?   u:object_r:a6l_tqftpserv_data_file:s0
/dev/qcom_rmtfs_mem[0-9]*          u:object_r:a6l_rmtfs_mem_device:s0
/dev/block/platform/soc/c0c4000\.sdhci/by-name/(modemst1|modemst2|fsg|fsc|persist)  u:object_r:a6l_modem_block_device:s0
/vendor/bin/a6l-sensors\.sh        u:object_r:a6l_modem_exec:s0
