cc_binary {
    name: "a6l_present_services",
    srcs: ["diagnostic/present_services.c"],
    static_executable: true,
    compile_multilib: "64",
    system_shared_libs: [],
    static_libs: ["libc"],
    stl: "none",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "a6l_present_client",
    srcs: ["diagnostic/present_client.cpp"],
    vendor: true,
    compile_multilib: "64",
    header_libs: ["libhardware_headers"],
    shared_libs: ["android.hardware.graphics.composer3-V5-ndk", "libbinder_ndk", "libui", "libutils", "libcutils", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

