# A6L USB device mode (android-usb, 29 Sep 2026; was rom-v1 "agent flash"). docs/android-usb-20260929.md
# Mainline dwc3 "a800000.usb" + configfs. The system init.usb.configfs.rc (sys.usb.configfs=1) cannot work here: it
# links the Android-kernel-only mtp.gs0/ptp.gs1/accessory.gs2 functions and never creates the gadget or the FunctionFS
# mounts. sys.usb.configfs=2 = vendor owns configfs (Pixel convention): this file builds the gadget skeleton and the
# FunctionFS mounts (adb/mtp/ptp), brings adb up before the framework, and the gadget HAL
# (android.hardware.usb.gadget-service.a6l, device/hisense/a6l/usb) switches functions afterwards.
# The kernel runs with a6l_manual_usb=1: every UDC bind is followed by soft_connect "connect" (D+ pull-up).
#
# RAM-CONTAINER GUARD: with androidboot.a6l.container=1 (LineageOS inside the diagnostic recovery) configfs is the
# recovery's; nothing here touches it and the gadget HAL is not started.

on early-init
    setprop vendor.a6l.usb.managed 1
    setprop vendor.a6l.usb.hal 0

on early-init && property:ro.boot.a6l.container=1
    setprop vendor.a6l.usb.managed 0

on early-boot && property:vendor.a6l.usb.managed=1
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    write /config/usb_gadget/g1/bcdDevice 0x0440
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno:-A6L0000000}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer:-Hisense}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model:-A6L}
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    # functions: FunctionFS (adbd, MtpServer via system_server/MediaProvider), tethering, MIDI (usb_f_midi.ko is a
    # module that is NOT staged yet: this mkdir fails until it is, and the HAL reports MIDI unsupported)
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.ptp
    mkdir /config/usb_gadget/g1/functions/rndis.gs4
    write /config/usb_gadget/g1/functions/rndis.gs4/os_desc/interface.rndis/compatible_id "RNDIS"
    write /config/usb_gadget/g1/functions/rndis.gs4/os_desc/interface.rndis/sub_compatible_id "5162001"
    mkdir /config/usb_gadget/g1/functions/ncm.gs9
    mkdir /config/usb_gadget/g1/functions/midi.gs5
    mkdir /dev/usb-ffs 0775 shell system
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    mkdir /dev/usb-ffs/ptp 0770 mtp mtp
    mount functionfs ptp /dev/usb-ffs/ptp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1
    # r6c (30 Sep 2026, docs/rom-r6c-20260930.md): the gadget HAL runs as user system (not root). configfs creates every
    # attribute root:root 0644 (fs/configfs/inode.c: no inherited owner) and the UDC's soft_connect is root 0200
    # (DEVICE_ATTR_WO), so in r6b the HAL's first write (idVendor) failed with EACCES, it never linked/bound anything, and
    # its takeover (vendor.a6l.usb.hal=1, set by usbd's boot call) had already disabled the early-adb rules below: no USB.
    # Hand the HAL exactly the files it writes (a6l_gadget_core.cpp Gadget::apply/bind/unbind). Links go into
    # configs/b.1 (shell 0770; the HAL has group shell).
    chown system system /config/usb_gadget/g1/UDC
    chown system system /config/usb_gadget/g1/idVendor
    chown system system /config/usb_gadget/g1/idProduct
    chown system system /config/usb_gadget/g1/bDeviceClass
    chown system system /config/usb_gadget/g1/bDeviceSubClass
    chown system system /config/usb_gadget/g1/bDeviceProtocol
    chown system system /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration
    chown system system /sys/class/udc/a800000.usb/soft_connect
    chmod 0220 /sys/class/udc/a800000.usb/soft_connect
    setprop sys.usb.controller a800000.usb
    setprop sys.usb.configfs 2

# Early adb (before system_server and the gadget HAL): only until the HAL takes over (vendor.a6l.usb.hal=1).
# r6c: the HAL ADOPTS an adb binding made here when usbd asks for adb (no unbind/re-bind), and hands the gadget back
# (vendor.a6l.usb.hal=0 -> these rules run again, also on a later sys.usb.ffs.ready=1) if it cannot apply a composition.
# adbd sets sys.usb.ffs.ready=1 right after writing its FunctionFS descriptors (packages/modules/adb daemon/usb_ffs.cpp).
on property:sys.usb.config=adb && property:sys.usb.configfs=2 && property:vendor.a6l.usb.hal=0
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=2 && property:vendor.a6l.usb.hal=0
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    write /sys/class/udc/${sys.usb.controller}/soft_connect connect
    setprop sys.usb.state ${sys.usb.config}

# r6c: an adbd crash before the HAL took over closes FunctionFS (the kernel unbinds the gadget) and the restarted adbd sets
# sys.usb.ffs.ready=1 again - no property change, so the bind rule above would not run again. Reset it on the restart
# (the platform only does this for init.svc.adbd=stopped, init.usb.configfs.rc).
on property:init.svc.adbd=restarting && property:vendor.a6l.usb.hal=0
    setprop sys.usb.ffs.ready 0
