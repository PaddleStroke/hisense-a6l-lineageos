+#include <v4l2_codec2/v4l2/V4L2Device.h>
 
 namespace android {
 
+namespace {
+// A6L: only publish an encoder that a present V4L2 device can actually provide.
+bool hasEncoderDevice(VideoCodec codec) {
+    const bool present = !V4L2Device::queryEncodingCapabilities(codec).supportedProfiles.empty();
+    if (!present) ALOGW("No V4L2 encoder device for %s: not advertised", VideoCodecToString(codec));
+    return present;
+}
+}  // namespace
+
