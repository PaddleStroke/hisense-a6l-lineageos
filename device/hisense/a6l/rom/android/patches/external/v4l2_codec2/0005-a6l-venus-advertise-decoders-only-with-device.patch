+// A6L patch 0005: same rule for decoders.
+bool hasDecoderDevice(VideoCodec codec) {
+    const bool present = !V4L2Device::queryDecodingCapabilities(codec).supportedProfiles.empty();
+    if (!present) ALOGW("No V4L2 decoder device for %s: not advertised", VideoCodecToString(codec));
+    return present;
+}
