+    const uint32_t codedWidth = (widthInMbsMinus1 + 1) * 16;
+    const uint32_t codedHeight = (heightInMapUnitsMinus1 + 1) * 16 * (2 - frameMbsOnlyFlag);
+    uint32_t cropUnitX = 1;
+    uint32_t cropUnitY = 2 - frameMbsOnlyFlag;
