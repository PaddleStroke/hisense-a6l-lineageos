+    rect->codedWidth = codedWidth;
+    rect->codedHeight = codedHeight;
+    rect->left = cropUnitX * cropLeft;
+    rect->top = cropUnitY * cropTop;
+    rect->width = codedWidth - cropUnitX * (cropLeft + cropRight);
+    rect->height = codedHeight - cropUnitY * (cropTop + cropBottom);
+    return true;
+}
