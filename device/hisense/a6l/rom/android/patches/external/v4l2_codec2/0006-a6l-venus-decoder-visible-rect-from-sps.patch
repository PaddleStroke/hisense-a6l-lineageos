+void V4L2Decoder::parseBitstreamVisibleRect(const C2ConstLinearBlock& input) {
+    // Until a rectangle is known the whole buffer is searched for an SPS; afterwards only the
+    // start of each buffer, where a key frame carries its in-band SPS.
+    constexpr size_t kInBandSearchBytes = 4096;
+    C2ReadView view = input.map().get();
+    if (view.error() != C2_OK || view.capacity() == 0) return;
+    const size_t length =
+            mBitstreamRect ? std::min<size_t>(view.capacity(), kInBandSearchBytes) : view.capacity();
+    std::unique_ptr<NalParser> parser;
+    if (mCodec == VideoCodec::H264)
+        parser = std::make_unique<H264NalParser>(view.data(), length);
+    else
+        parser = std::make_unique<HEVCNalParser>(view.data(), length);
+    NalParser::VisibleRect r;
+    if (!parser->locateSPS() || !parser->findVisibleRect(&r)) return;
+    const ui::Size coded(static_cast<int32_t>(r.codedWidth), static_cast<int32_t>(r.codedHeight));
+    const Rect visible(static_cast<int32_t>(r.left), static_cast<int32_t>(r.top),
+                       static_cast<int32_t>(r.left + r.width), static_cast<int32_t>(r.top + r.height));
+    if (mBitstreamRect && mBitstreamRect->first == coded && mBitstreamRect->second == visible) return;
+    ALOGI("Bitstream SPS: coded size %s, visible rect %s", toString(coded).c_str(),
+          toString(visible).c_str());
+    mBitstreamRect = std::make_pair(coded, visible);
+}
