+// A6L patch 0010: pick the CAPTURE slot that a new output buffer may take over, if any is safe:
+// not queued, not waiting in the post-flush reuse queue, and either dequeued before the last key
+// frame came out, idle long enough to have left the DPB, or (nothing at the device for
+// kStarvationRebindNs) the least recently used one.
+std::optional<size_t> V4L2Decoder::findReusableSlot(const char** reason) {
+    if (!mReuseFrameQueue.empty()) return std::nullopt;
+
+    std::optional<size_t> best;
+    uint64_t bestSeq = UINT64_MAX;
+    for (const auto& [slot, block] : mV4L2IdToBlockId) {
+        if (mFrameAtDevice.find(slot) != mFrameAtDevice.end()) continue;
+        auto it = mLastDequeueSeq.find(slot);
+        const uint64_t seq = (it == mLastDequeueSeq.end()) ? 0 : it->second;
+        if (seq < bestSeq) {
+            bestSeq = seq;
+            best = slot;
+        }
+    }
+    if (!best) return std::nullopt;
+
+    const uint64_t idleFrames = mOutputSeq - bestSeq;
+    const uint64_t minIdle = (mCodec == VideoCodec::H264 || mCodec == VideoCodec::HEVC)
+                                     ? kSlotIdleFramesAvcHevc
+                                     : kSlotIdleFramesOther;
+    if (bestSeq < mLastKeyFrameOutputSeq) {
+        *reason = "dequeued before the last key frame";
+        return best;
+    }
+    if (idleFrames >= minIdle) {
+        *reason = "idle";
+        return best;
+    }
+    if (mUnboundSinceNs != 0 && (mFrameAtDevice.empty() || mOutputSeq == mUnboundSinceSeq) &&
+        systemTime(SYSTEM_TIME_MONOTONIC) - mUnboundSinceNs >= kStarvationRebindNs) {
+        *reason = "no output progress, least recently used";
+        return best;
+    }
+    return std::nullopt;
+}
