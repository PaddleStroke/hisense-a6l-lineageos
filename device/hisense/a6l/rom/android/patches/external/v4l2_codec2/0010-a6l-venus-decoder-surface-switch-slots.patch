+void V4L2Decoder::noteKeyFrame(const C2ConstLinearBlock& input, int32_t bitstreamId) {
+    C2ReadView view = input.map().get();
+    if (view.error() != C2_OK || view.capacity() == 0) return;
+    const uint8_t* data = view.data();
+    const size_t length = std::min<size_t>(view.capacity(), kKeyFrameScanBytes);
+    bool key = false;
+    switch (mCodec) {
+    case VideoCodec::H264: {
+        H264NalParser parser(data, length);
+        key = parser.locateIDR();
+        break;
+    }
+    case VideoCodec::HEVC: {
+        HEVCNalParser parser(data, length);
+        key = parser.locateIDR();
+        break;
+    }
+    case VideoCodec::VP8:
+        key = (data[0] & 0x1) == 0;  // frame tag: key_frame == 0
+        break;
+    case VideoCodec::VP9: {
+        // frame_marker(2) profile(2) show_existing_frame(1) frame_type(1), profiles 0-2 only.
