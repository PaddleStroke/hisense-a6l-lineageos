+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.util;
+
+import android.os.SystemProperties;
+
+/**
+ * A6L only. While the rear e-ink is the screen, WindowManager shows a white wallpaper layer there (frameworks/base
+ * 0002, persist.sys.a6l.eink.wallpaper=white) instead of the wallpaper whose colours SystemUI extracted. The keyguard
+ * then picked its light-text theme from the (dark) LCD lock wallpaper: the big clock (system_accent1_100) and the date
+ * were drawn near-white on white and vanished on the e-ink (8 Oct 2026, round 17 video "3:10" invisible).
+ */
+public final class A6lEinkWallpaper {
+    private A6lEinkWallpaper() { }
+
+    /** True when the keyguard text sits on the e-ink's white wallpaper layer: use the dark-text theme. */
+    public static boolean whiteOnEink() {
+        if (SystemProperties.get("ro.vendor.a6l.rom.build", "").isEmpty()) return false;
+        if (!SystemProperties.get("vendor.dualux.state", "lcd").startsWith("eink")) return false;
+        return !"lcd".equals(SystemProperties.get("persist.sys.a6l.eink.wallpaper", "white"))
+                && SystemProperties.getBoolean("persist.sys.a6l.eink.keyguard_dark_text", true);
+    }
+}
