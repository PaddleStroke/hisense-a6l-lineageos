+        boolean changed = false;
+        if (mA6lWhiteWallpaper == null) {
+            mA6lWhiteWallpaper = makeChildSurface(null).setName("A6L rear white wallpaper")
+                    .setColorLayer().setCallsite("WallpaperWindowToken.updateA6lWhiteWallpaper")
+                    .build();
+            mA6lWhiteParent = parent;
+            t.setLayer(mA6lWhiteWallpaper, Integer.MAX_VALUE)
+                    .setColor(mA6lWhiteWallpaper, new float[]{1f, 1f, 1f})
+                    .setAlpha(mA6lWhiteWallpaper, 1f);
+            changed = true;
+        }
+        Rect bounds = getBounds();
+        if (!mA6lWhiteBounds.equals(bounds)) {
+            mA6lWhiteBounds.set(bounds);
+            t.setPosition(mA6lWhiteWallpaper, 0, 0)
+                    .setWindowCrop(mA6lWhiteWallpaper, bounds.width(), bounds.height());
+            changed = true;
+        }
+        if (white != mA6lWhiteVisible) {
+            t.setVisibility(mA6lWhiteWallpaper, white);
+            mA6lWhiteVisible = white;
+            changed = true;
+        }
+        return changed;
+    }
