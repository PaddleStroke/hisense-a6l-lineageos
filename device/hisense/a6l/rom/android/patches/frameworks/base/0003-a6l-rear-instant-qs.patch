+// SPDX-License-Identifier: Apache-2.0
+package com.android.systemui.util;
+import android.os.SystemProperties;
+/** A6L only: gesture interpolation shows endpoints instead of intermediate transforms. */
+public final class A6lEinkAnimations {
+    private A6lEinkAnimations() { }
+    public static boolean disabled() {
+        return SystemProperties.getBoolean("sys.a6l.eink.no_animations", false);
+    }
+    public static float position(float fraction) {
+        return disabled() ? (fraction < 0.5f ? 0f : 1f) : fraction;
+    }
+}
