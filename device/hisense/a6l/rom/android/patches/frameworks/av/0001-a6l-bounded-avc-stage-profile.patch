+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace android {
+
+// A bounded diagnostic only. No pixels, native handles or addresses are retained.
+struct A6lAvcProfileRecord {
+    uint64_t frame = 0;
+    int64_t ptsUs = 0;
+    int64_t entryNs = 0;
+    int64_t wallNs = 0;
+    std::array<int64_t, 4> stageNs{}; // map, output allocation/map, prepare, libavc
+    uint32_t calls = 0;
+    uint32_t width = 0, height = 0, cropWidth = 0, cropHeight = 0;
+    int32_t layoutType = -1;
+    uint32_t numPlanes = 0, rootPlanes = 0;
+    std::array<int32_t, 4> rowInc{}, colInc{};
+    int32_t result = 0;
+    uint32_t outputBytes = 0;
+    bool inputPresent = false, outputPresent = false;
+};
+
+class A6lAvcProfile {
+public:
+    using Clock = int64_t (*)();
+    using Sink = void (*)(const A6lAvcProfileRecord &);
+    static bool gate(const char *board, const char *debuggable, const char *requested) {
+        return !std::strcmp(board, "a6l") && !std::strcmp(debuggable, "1") &&
+               !std::strcmp(requested, "1");
+    }
+    A6lAvcProfile(bool enabled, uint32_t &count, uint64_t frame, int64_t ptsUs,
+                  Clock clock, Sink sink) : clock_(clock), sink_(sink) {
+        if (!enabled || count >= 128) return;
+        const uint32_t call = count++;
+        sampled_ = call < 4 || call % 8 == 0;
+        if (!sampled_) return;
+        record.frame = frame;
+        record.ptsUs = ptsUs;
+        start_ = clock_();
+        record.entryNs = start_;
+    }
+    ~A6lAvcProfile() {
+        if (!sampled_) return;
+        record.wallNs = clock_() - start_;
+        sink_(record);
+    }
+    A6lAvcProfile(const A6lAvcProfile &) = delete;
+    A6lAvcProfile &operator=(const A6lAvcProfile &) = delete;
+    bool sampled() const { return sampled_; }
+    template<class Layout> void noteLayout(const Layout &layout) {
+        if (!sampled_) return;
+        record.layoutType = static_cast<int32_t>(layout.type);
+        record.numPlanes = layout.numPlanes;
+        record.rootPlanes = layout.rootPlanes;
+        for (unsigned i = 0; i < layout.numPlanes && i < 4; ++i) {
+            record.rowInc[i] = layout.planes[i].rowInc;
+            record.colInc[i] = layout.planes[i].colInc;
+        }
+    }
+    class Stage {
+    public:
+        Stage(A6lAvcProfile &owner, unsigned stage) : owner_(owner), stage_(stage) {
+            if (owner_.sampled_) start_ = owner_.clock_();
+        }
+        ~Stage() {
+            if (owner_.sampled_) owner_.record.stageNs[stage_] += owner_.clock_() - start_;
+        }
+        Stage(const Stage &) = delete;
+        Stage &operator=(const Stage &) = delete;
+    private:
+        A6lAvcProfile &owner_;
+        unsigned stage_;
+        int64_t start_ = 0;
+    };
+    A6lAvcProfileRecord record;
+private:
+    Clock clock_;
+    Sink sink_;
+    bool sampled_ = false;
+    int64_t start_ = 0;
+};
+
+} // namespace android
