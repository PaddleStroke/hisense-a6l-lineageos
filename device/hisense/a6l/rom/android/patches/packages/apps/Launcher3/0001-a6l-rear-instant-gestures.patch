+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3.util;
+import java.lang.reflect.Method;
+/** A6L transient display policy; the ordinary LCD path is untouched. */
+public final class A6lEinkAnimations {
+    private static Method sGet;
+    private A6lEinkAnimations() { }
+    public static boolean disabled() {
+        try {
+            if (sGet == null) sGet = Class.forName("android.os.SystemProperties")
+                    .getMethod("getBoolean", String.class, boolean.class);
+            return (Boolean) sGet.invoke(null, "sys.a6l.eink.no_animations", false);
+        } catch (ReflectiveOperationException | RuntimeException e) { return false; }
+    }
+}
