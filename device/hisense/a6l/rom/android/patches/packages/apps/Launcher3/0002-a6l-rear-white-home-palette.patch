+// SPDX-License-Identifier: Apache-2.0
+package com.android.launcher3.util;
+
+import android.app.WallpaperColors;
+import android.content.Context;
+import android.view.Display;
+
+import java.lang.reflect.Method;
+
+/** Transient foreground contrast for the A6L's WM white wallpaper layer. */
+public final class A6lWallpaperPalette {
+    private static Method sGet;
+    private A6lWallpaperPalette() { }
+
+    private static String get(String name, String fallback) {
+        try {
+            if (sGet == null) sGet = Class.forName("android.os.SystemProperties")
+                    .getMethod("get", String.class, String.class);
+            return (String) sGet.invoke(null, name, fallback);
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return fallback;
+        }
+    }
+
+    public static boolean supported(Context context) {
+        try {
+            Display display = context.getDisplay();
+            return display != null && display.getDisplayId() == Display.DEFAULT_DISPLAY
+                    && !get("ro.vendor.a6l.rom.build", "").isEmpty();
+        } catch (RuntimeException e) {
+            return false; // Non-display/preview contexts retain their normal palette.
+        }
+    }
+
+    public static int effectiveHints(Context context, int original) {
+        if (!supported(context)) return original;
+        String pair = get("sys.a6l.dualux.appearance", "");
+        String prepare = get("vendor.dualux.prepare", "");
+        String state = get("vendor.dualux.state", "lcd");
+        String mode = get("persist.sys.a6l.eink.wallpaper", "white");
+        // The getter runs again at the draw boundary. Never retain a canceled epoch.
+        if (!pair.equals(get("sys.a6l.dualux.appearance", ""))
+                || !prepare.equals(get("vendor.dualux.prepare", ""))
+                || !state.equals(get("vendor.dualux.state", "lcd"))
+                || !mode.equals(get("persist.sys.a6l.eink.wallpaper", "white"))) return original;
+        return hints(original, pair, prepare, state, mode);
+    }
+
+    static int hints(int original, String pair, String prepare, String state, String mode) {
+        if (!valid(pair) || !pair.endsWith(" eink") || "lcd".equals(mode)) return original;
+        if (!prepare.isEmpty()) {
+            if (!pair.equals(prepare)) return original;
+        } else if (!state.startsWith("eink")) {
+            return original;
+        }
+        // RGB colors/Monet seeds and the WallpaperManager cache remain unchanged.
+        return (original | WallpaperColors.HINT_SUPPORTS_DARK_TEXT)
+                & ~WallpaperColors.HINT_SUPPORTS_DARK_THEME;
+    }
+
+    private static boolean valid(String pair) {
+        if (pair == null) return false;
+        int space = pair.indexOf(' ');
+        if (space < 1 || space > 19 || pair.indexOf(' ', space + 1) >= 0
+                || !(pair.endsWith(" eink") || pair.endsWith(" lcd"))) return false;
+        for (int i = 0; i < space; i++) {
+            if (pair.charAt(i) < '0' || pair.charAt(i) > '9') return false;
+        }
+        try { return Long.parseLong(pair.substring(0, space)) > 0; }
+        catch (NumberFormatException e) { return false; }
+    }
+}
