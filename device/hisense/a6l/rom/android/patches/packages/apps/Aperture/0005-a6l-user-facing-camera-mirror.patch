--- a/app/src/main/java/org/lineageos/aperture/utils/A6lUserFacing.kt
+++ b/app/src/main/java/org/lineageos/aperture/utils/A6lUserFacing.kt
@@ -0,0 +1,39 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.utils
+
+import android.os.Build
+import org.lineageos.aperture.models.CameraFacing
+
+/**
+ * Hisense A6L (LCD on the front, e-ink on the back): which camera faces the user depends on the screen in use.
+ * a6l_dualux publishes vendor.dualux.state = lcd | eink | eink-asleep. On the e-ink the rear cameras (main, wide)
+ * face the user, so they get the front-camera ("selfie") treatment: mirrored preview and the front-camera photo /
+ * video mirror settings; the LCD-side camera then behaves like a rear camera. On the LCD, on any other device, or
+ * when the property cannot be read, the lens facing decides as in upstream Aperture.
+ */
+object A6lUserFacing {
+    private const val PROP_STATE = "vendor.dualux.state"
+
+    val isA6l = Build.DEVICE.equals("a6l", ignoreCase = true)
+
+    /** The rear e-ink screen is the one in use. */
+    fun einkActive(): Boolean {
+        if (!isA6l) {
+            return false
+        }
+        return runCatching {
+            val c = Class.forName("android.os.SystemProperties")
+            val v = c.getMethod("get", String::class.java, String::class.java)
+                .invoke(null, PROP_STATE, "") as String
+            v.startsWith("eink")
+        }.getOrDefault(false)
+    }
+
+    /** This camera faces the user on the screen in use (preview mirrored, front-camera save settings). */
+    fun isUserFacing(cameraFacing: CameraFacing?, einkActive: Boolean) =
+        (cameraFacing == CameraFacing.FRONT) != einkActive
+}
