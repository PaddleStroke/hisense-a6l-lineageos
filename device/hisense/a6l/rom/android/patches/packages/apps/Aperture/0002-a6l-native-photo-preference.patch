+/* SPDX-License-Identifier: Apache-2.0 */
+package org.lineageos.aperture.utils
+
+/** Prefer an already-advertised native JPEG while retaining CameraX fallbacks. */
+object NativePhotoPolicy {
+    fun <T> prioritize(
+        device: String?,
+        cameraId: String?,
+        standardJpeg: Boolean,
+        supported: List<T>,
+        width: (T) -> Int,
+        height: (T) -> Int,
+    ): List<T> {
+        if (device?.equals("a6l", ignoreCase = true) != true || !standardJpeg) return supported
+        val native = when (cameraId) {
+            "0" -> 2872 to 2156
+            "1" -> 2296 to 1728
+            "2" -> 1624 to 1224
+            else -> return supported
+        }
+        val isNative: (T) -> Boolean = { width(it) == native.first && height(it) == native.second }
+        val preferred = supported.filter(isNative)
+        if (preferred.isEmpty()) return supported
+        return preferred + supported.filterNot(isNative)
+    }
+}
