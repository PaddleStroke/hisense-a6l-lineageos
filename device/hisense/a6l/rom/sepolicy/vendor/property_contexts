# A6L ROM-level (release-prep 27 Sep 2026). Longer prefixes owned by area dirs win: persist.vendor.a6l.ril., ro.vendor.a6l.ril.,
# vendor.a6l.voice. (radio/sepolicy).
vendor.a6l.                 u:object_r:vendor_a6l_prop:s0
persist.vendor.a6l.         u:object_r:vendor_a6l_prop:s0
ro.vendor.a6l.              u:object_r:vendor_a6l_ro_prop:s0
# Debug init owns the runtime-PM comparison; 0/1 only, existing ROM property type.
persist.vendor.a6l.gpu.pm_hold u:object_r:vendor_a6l_prop:s0 exact enum 0 1
# selinux-20261007: Mesa / minigbm runtime options (read by every graphics client; rom/selinux/sepolicy/vendor/graphics.te)
vendor.mesa.                u:object_r:vendor_a6l_gfx_prop:s0
vendor.minigbm.             u:object_r:vendor_a6l_gfx_prop:s0
# selinux-20261007 pass 2 (round 12): SurfaceFlinger reads vendor.display.vds_allow_hwc at start (SurfaceFlinger.cpp,
# r12 surfaceflinger vendor_default_prop open/getattr/map); readable by every domain like the other graphics options
vendor.display.vds_allow_hwc u:object_r:vendor_a6l_gfx_prop:s0 exact bool
# selinux-20261007 pass 4: set by the wifi HAL (WifiChip debug info)
vendor.wlan.firmware.version u:object_r:vendor_a6l_wifi_prop:s0 exact string
vendor.wlan.driver.version   u:object_r:vendor_a6l_wifi_prop:s0 exact string
