# A6L ROM-level sysfs labels (release-prep, 27 Sep 2026). ALL PATHS UNVERIFIED (mainline 7.2 device names from the V75 DT):
# first install (permissive) -> `ls -lZd <path>` and `readlink -f /sys/class/{remoteproc,drm,power_supply}/*` -> fix here.
# A wrong path only leaves the node as generic `sysfs` (denials in enforcing, harmless while permissive).
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc                u:object_r:sysfs_a6l_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/4080000.remoteproc                 u:object_r:sysfs_a6l_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/14780000.ipa                       u:object_r:sysfs_a6l_ipa:s0
genfscon sysfs /devices/platform/soc@0/c900000.display-subsystem          u:object_r:sysfs_a6l_drm:s0
# r5 bug hunt power (29 Sep 2026): the SPMI child devices are named "<spmi>:pmic@N:<node>" under spmi-0/0-0N (phone
# evidence: readlink .../spmi-0/0-03/800f000.spmi:pmic@3:leds@d800/backlight, dmesg "800f000.spmi:pmic@0:battery@4000"),
# not "0-00:pmic@0:charger" / "0-02:pmic@2:fuel-gauge" (the FG is pm660 battery@4000 on SID 0): the old lines matched
# nothing. Label = sysfs_batteryinfo, the type AOSP expects on everything the health HAL reads
# (system/sepolicy/private/hal_health.te; charger_type.te: the off-mode charger (charger_vendor), recovery and fastbootd
# read only sysfs_batteryinfo, so a private type left charger mode without battery data in enforcing).
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:charger@1000 u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:battery@4000 u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/virtual/power_supply                               u:object_r:sysfs_batteryinfo:s0
# r5 review fix F13 (28 Sep 2026): PM660L flash LED (led-controller@d300 -> leds/white:flash). UNVERIFIED path: confirm with
# `readlink -f /sys/class/leds/white:flash` + `ls -lZ` on the first permissive install (DAC comes from ueventd.rc either way).
# r5 bug hunt power (29 Sep 2026): same SPMI naming fix as the power_supply lines above ("800f000.spmi:pmic@3:...").
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-03/800f000.spmi:pmic@3:led-controller@d300 u:object_r:sysfs_a6l_flash:s0
# r5 review fix F49 (29 Sep 2026): a6l_gpio_vib (DT node /a6l-vibrator -> platform device a6l-vibrator -> leds/vibrator).
# UNVERIFIED path: confirm with `readlink -f /sys/class/leds/vibrator` + `ls -lZ` on the first permissive install.
genfscon sysfs /devices/platform/a6l-vibrator                              u:object_r:sysfs_a6l_vibrator:s0
# fastcharge-rom (29 Sep 2026): qcom_smbx parameters (a6l-chg-guard writes hvdcp_enable / hvdcp_rerun). Created when the module
# loads (charger group). Confirm with `ls -lZ /sys/module/qcom_smbx/parameters` on the first permissive install.
genfscon sysfs /module/qcom_smbx/parameters                                u:object_r:sysfs_a6l_chg_param:s0
# ---- selinux-20261007 (round 11 avc log, boot 10affa76; firmware/extracted/selinux-20261007/README.md) ----
# Paths are the realpaths printed in the r11 denials unless marked INFERRED.
# Front touch driver dir: a6l-modules.sh touch_rebind() writes its `bind` (generic sysfs: write not grantable cleanly)
genfscon sysfs /bus/i2c/drivers/edt_ft5x06                                 u:object_r:sysfs_a6l_touch:s0
# SMGR accel/gyro/mag IIO devices hang below the ADSP remoteproc (glink-edge -> IPCRTR -> 5-54 -> qcom-smgr-*/iio:deviceN)
# and were sysfs_a6l_remoteproc: sensors.a6l would need rw on the remoteproc tree (incl. its start/stop `state`).
# Label the QRTR channel subtree sysfs_a6l_iio (the type hal_extras.te already gives the sensors HAL and a6l_modules).
# genfs is prefix-only (no policycap genfs_seclabel_wildcard): ADSP is remoteproc0 in every log so far; 1-3 cover a
# different probe order of the remoteprocs (remoteproc1..3 INFERRED).
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc/remoteproc/remoteproc0/15700000.remoteproc:glink-edge/15700000.remoteproc:glink-edge.IPCRTR.-1.-1 u:object_r:sysfs_a6l_iio:s0
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc/remoteproc/remoteproc1/15700000.remoteproc:glink-edge/15700000.remoteproc:glink-edge.IPCRTR.-1.-1 u:object_r:sysfs_a6l_iio:s0
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc/remoteproc/remoteproc2/15700000.remoteproc:glink-edge/15700000.remoteproc:glink-edge.IPCRTR.-1.-1 u:object_r:sysfs_a6l_iio:s0
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc/remoteproc/remoteproc3/15700000.remoteproc:glink-edge/15700000.remoteproc:glink-edge.IPCRTR.-1.-1 u:object_r:sysfs_a6l_iio:s0
# STK3338 ALS/proximity (iio:device0 at c1b6000.i2c 2-0067; a6l-modules.sh reads its name, sensors.a6l drives it)
genfscon sysfs /devices/platform/soc@0/c1b6000.i2c/i2c-2/2-0067            u:object_r:sysfs_a6l_iio:s0
# /proc/sys/kernel/printk (a6l-modules.sh) and printk_devkmsg (init.qcom.rc write from vendor_init): prefix match
genfscon proc /sys/kernel/printk                                          u:object_r:proc_a6l_printk:s0
# eMMC queue: AOSP init.rc writes /dev/sys/block/by-name/userdata/queue/discard_max_bytes ("requires enabling selinux
# entry for sda/mmcblk0 in vendor side"; neverallow init sysfs:file write). AOSP type for block-device sysfs.
genfscon sysfs /devices/platform/soc@0/c0c4000.mmc/mmc_host/mmc1/mmc1:0001/block/mmcblk1 u:object_r:sysfs_devices_block:s0
# Adreno 512: libdrm drmGetDevice2() reads .../5000000.gpu/uevent in every GL/Vulkan client (surfaceflinger, bootanim,
# system_server, apps, mediaswcodec). sysfs_gpu = the AOSP type gpu_sphal_domain may read.
genfscon sysfs /devices/platform/soc@0/5000000.gpu                         u:object_r:sysfs_gpu:s0
# Device-backed wakeup sources: system_suspend reads /sys/class/wakeup/wakeupN/name -> realpath under the device (AOSP
