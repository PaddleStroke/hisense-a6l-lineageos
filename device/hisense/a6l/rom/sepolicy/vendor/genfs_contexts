# thermal-sensor, remoteproc, charger and hall-sensor; the rest INFERRED from the names (confirm: readlink -f /sys/class/wakeup/*).
genfscon sysfs /devices/platform/soc@0/10ae000.thermal-sensor/wakeup       u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/15700000.remoteproc/wakeup          u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/c1b6000.i2c/i2c-2/2-0067/wakeup     u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:charger@1000/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:charger@1000/power_supply/pm660-charger/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:battery@4000/power_supply/qcom-battery/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:rtc@6000/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc@0/800f000.spmi/spmi-0/0-00/800f000.spmi:pmic@0:pon@800/800f000.spmi:pmic@0:pon@800:pwrkey/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/hall-sensor/wakeup                        u:object_r:sysfs_wakeup:s0
