# A6L property namespaces not owned by an area dir (radio: vendor_a6l_ril_prop/vendor_a6l_voice_prop; eink: vendor_eink_prop)
vendor_internal_prop(vendor_a6l_prop)          # vendor.a6l.* / persist.vendor.a6l.* (feature gates: radio, charger, ipa, camera, ...)
vendor_public_prop(vendor_a6l_ro_prop)         # ro.vendor.a6l.* (build markers, audio capture pcm) - read by HALs
# selinux-20261007: in-process graphics stack options (Mesa os_get_option: vendor.mesa.*; minigbm: vendor.minigbm.debug).
# Read in EVERY GL/gralloc client process; unlabelled vendor.* = vendor_default_prop, which coredomain/appdomain may not
# read (r11: surfaceflinger, bootanim, system_server, system_app, platform_app, priv_app, gmscore_app, mediaswcodec).
vendor_public_prop(vendor_a6l_gfx_prop)
# selinux-20261007 pass 4: AOSP wifi HAL publishes vendor.wlan.{firmware,driver}.version (r22: hal_wifi_default set denied
# on vendor_default_prop, which only init/vendor_init may set: neverallow)
vendor_internal_prop(vendor_a6l_wifi_prop)
