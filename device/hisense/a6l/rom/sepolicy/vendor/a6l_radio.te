# /vendor/bin/a6l-radio.sh start|stop (service a6l_radio) and the modem companions it execs (vendor.rmtfs, vendor.tqftpserv,
# vendor.diag_router run `a6l-radio.sh <x>` which execs the binary -> domain transition below). Folds in the never-compiled
# hals/sepolicy/a6l_radio.te with the real rom-v2 paths.
type a6l_radio_ctl, domain;
init_daemon_domain(a6l_radio_ctl)
allow a6l_radio_ctl vendor_shell_exec:file rx_file_perms;
allow a6l_radio_ctl vendor_toolbox_exec:file rx_file_perms;
allow a6l_radio_ctl kmsg_device:chr_file { write append getattr };
allow a6l_radio_ctl self:capability { sys_module net_admin };
allow a6l_radio_ctl vendor_kernel_modules:system module_load;
r_dir_file(a6l_radio_ctl, vendor_kernel_modules)
allow a6l_radio_ctl vendor_configs_file:dir r_dir_perms;
allow a6l_radio_ctl vendor_configs_file:file r_file_perms;
allow a6l_radio_ctl proc_modules:file r_file_perms;
allow a6l_radio_ctl { sysfs sysfs_a6l_remoteproc sysfs_a6l_ipa sysfs_net }:dir r_dir_perms;
allow a6l_radio_ctl { sysfs sysfs_a6l_remoteproc sysfs_a6l_ipa sysfs_net }:lnk_file read;
allow a6l_radio_ctl { sysfs_a6l_remoteproc sysfs_a6l_ipa }:file rw_file_perms;
allow a6l_radio_ctl { sysfs sysfs_net }:file r_file_perms;
allow a6l_radio_ctl a6l_rmtfs_mem_device:chr_file getattr;
# wlan0 MAC from /persist/wlan_mac.bin. NOTE: `ip link set` is /system/bin/ip = a system executable that a vendor domain
# may not run (Treble neverallow): in enforcing the MAC step must move to a6l_macs (see release-prep doc 3.4).
r_dir_file(a6l_radio_ctl, a6l_persist_file)
# wifi-20261008: fstab.qcom mounts persist WITHOUT context=, so its files keep their stock xattr label (seen live:
# mnt_vendor_file on wlan_mac.bin, permissive avc from a6l_macs). Read it under either label.
r_dir_file(a6l_radio_ctl, mnt_vendor_file)
get_prop(a6l_radio_ctl, vendor_a6l_prop)
set_prop(a6l_radio_ctl, ctl_start_prop)
set_prop(a6l_radio_ctl, ctl_stop_prop)
domain_auto_trans(a6l_radio_ctl, a6l_rmtfs_exec, a6l_rmtfs)
domain_auto_trans(a6l_radio_ctl, a6l_tqftpserv_exec, a6l_tqftpserv)
domain_auto_trans(a6l_radio_ctl, a6l_diag_exec, a6l_diag)

# rmtfs: modem EFS over QRTR, shared memory /dev/qcom_rmtfs_mem1, partitions modemst1/modemst2/fsg/fsc (-P)
type a6l_rmtfs, domain;
init_daemon_domain(a6l_rmtfs)
allow a6l_rmtfs self:qipcrtr_socket create_socket_perms_no_ioctl;
allow a6l_rmtfs a6l_rmtfs_mem_device:chr_file rw_file_perms;
allow a6l_rmtfs a6l_modem_block_device:blk_file rw_file_perms;
allow a6l_rmtfs block_device:dir r_dir_perms;
allow a6l_rmtfs { sysfs sysfs_dt_firmware_android }:dir r_dir_perms;
allow a6l_rmtfs { sysfs sysfs_dt_firmware_android }:file r_file_perms;
allow a6l_rmtfs kmsg_device:chr_file { write append getattr };
get_prop(a6l_rmtfs, vendor_a6l_prop)

# tqftpserv: modem config/firmware over QRTR TFTP from /vendor/firmware, scratch in /data/vendor/tmp/tqftpserv
type a6l_tqftpserv, domain;
init_daemon_domain(a6l_tqftpserv)
allow a6l_tqftpserv self:qipcrtr_socket create_socket_perms_no_ioctl;
r_dir_file(a6l_tqftpserv, vendor_file)
allow a6l_tqftpserv a6l_tqftpserv_data_file:dir create_dir_perms;
allow a6l_tqftpserv a6l_tqftpserv_data_file:file create_file_perms;
allow a6l_tqftpserv vendor_data_file:dir search;
allow a6l_tqftpserv kmsg_device:chr_file { write append getattr };

# diag-router: DIAG over QRTR (the modem starves without it)
type a6l_diag, domain;
init_daemon_domain(a6l_diag)
allow a6l_diag self:qipcrtr_socket create_socket_perms_no_ioctl;
allow a6l_diag self:unix_stream_socket create_stream_socket_perms;
allow a6l_diag sysfs:dir r_dir_perms;
allow a6l_diag sysfs:file r_file_perms;
allow a6l_diag kmsg_device:chr_file { write append getattr };

# a6l_macs: public BD address for hci0 (bt mode, service vendor.a6l-bt-addr); Wi-Fi MAC (to replace `ip link` above)
type a6l_macs, domain;
init_daemon_domain(a6l_macs)
allow a6l_macs a6l_modem_block_device:blk_file r_file_perms;
r_dir_file(a6l_macs, a6l_persist_file)
r_dir_file(a6l_macs, mnt_vendor_file)    # wifi-20261008: see a6l_radio_ctl above
allow a6l_macs self:udp_socket create_socket_perms;
allowxperm a6l_macs self:udp_socket ioctl { SIOCGIFHWADDR SIOCSIFHWADDR SIOCGIFFLAGS SIOCSIFFLAGS };
allow a6l_macs self:bluetooth_socket create_socket_perms_no_ioctl;
allow a6l_macs self:capability { net_admin net_raw };
allow a6l_macs { sysfs sysfs_net }:dir r_dir_perms;
allow a6l_macs sysfs_net:file r_file_perms;
allow a6l_macs kmsg_device:chr_file { write append getattr };

# AOSP bluetooth-service.default in HCI_CHANNEL_USER mode (from hals/sepolicy/hal_bluetooth_default.te)
allow hal_bluetooth_default self:bluetooth_socket create_socket_perms_no_ioctl;
allow hal_bluetooth_default self:capability net_admin;
allow hal_bluetooth_default a6l_rfkill_device:chr_file rw_file_perms;
# r5 review fix F8 (28 Sep 2026): a6l-radio.sh start publishes vendor.a6l.radio.state (starting/up/failed:<reason>)
set_prop(a6l_radio_ctl, vendor_a6l_prop)

# ---- selinux-20261007 pass 3 (round 21 avc, vendor 3281849b; firmware/extracted/selinux-20261007/round21/README.md) ----
# stdio_to_kmsg on userdebug = /dev/kmsg_debug (r21: a6l-radio.sh/grep/sleep getattr+write x24, diag-router getattr x2);
# rmtfs/tqftpserv have stdio_to_kmsg too (no r21 denial: they only write on errors; inferred). TCGETS ioctl = isatty only.
allow { a6l_radio_ctl a6l_diag a6l_rmtfs a6l_tqftpserv } kmsg_debug_device:chr_file { w_file_perms getattr };
dontaudit { a6l_radio_ctl a6l_diag a6l_rmtfs a6l_tqftpserv } { kmsg_device kmsg_debug_device }:chr_file ioctl;
# diag-router finds the modem/ADSP DIAG channels with libudev (peripheral-rpmsg.c: enumerate rpmsg devices, realpath to the
# device, sysattr "name" / parent "rpmsg_name"). The rpmsg devices sit below the remoteprocs: MSS
# 4080000.remoteproc/remoteproc/remoteproc1/...glink-edge.DATA2 (sysfs_a6l_remoteproc) and the ADSP IPCRTR subtree
# (sysfs_a6l_iio since pass 1). r21: 2825 dir-search lines, re-polled every second. Without it the router sees no
# peripheral (the comment above: "the modem starves without it"). Read-only; the attribute reads are inferred (libudev).
allow a6l_diag { sysfs_a6l_remoteproc sysfs_a6l_iio }:dir r_dir_perms;
allow a6l_diag { sysfs_a6l_remoteproc sysfs_a6l_iio }:file r_file_perms;
allow a6l_diag { sysfs_a6l_remoteproc sysfs_a6l_iio }:lnk_file read;

# ---- selinux-20261007 pass 4 (round 22 avc, vendor 4f0b9938; firmware/extracted/selinux-20261007/round22/README.md) ----
# tqftpserv serves the modem's config/firmware files: translate.c reads /sys/module/firmware_class/parameters/path
# (= /vendor/firmware, labelled sysfs_a6l_fw_path) and every /sys/class/remoteproc/<rproc>/firmware attribute to find the
# directory of the remoteproc firmware. r22: path read x13, /sys/class/remoteproc list x6, 15700000.remoteproc search x3.
# Denied (enforcing) = only /lib/firmware is tried -> the modem gets none of its files from /vendor/firmware.
allow a6l_tqftpserv sysfs_a6l_fw_path:file r_file_perms;
allow a6l_tqftpserv sysfs:dir r_dir_perms;
allow a6l_tqftpserv sysfs:lnk_file read;
r_dir_file(a6l_tqftpserv, sysfs_a6l_remoteproc)
# The radio binaries live in /vendor/a6l/radio/bin, outside every linkerconfig dir.* entry, so the bionic linker
# realpath()s each entry in turn (/data/local/tmp, /data/local/tests/{product,...}) while choosing a namespace section
# (r22: rmtfs search/read/getattr on shell_data_file, shell_test_data_file + dac_read_search). An unreadable entry is
# skipped: same result as permissive. Core data / dac_read_search are neverallowed for vendor domains -> silence.
dontaudit { a6l_rmtfs a6l_tqftpserv a6l_diag a6l_radio_ctl } { shell_data_file shell_test_data_file }:dir { search read open getattr };
dontaudit { a6l_rmtfs a6l_tqftpserv a6l_diag a6l_radio_ctl } self:global_capability_class_set { dac_override dac_read_search };
# `exec $B/rmtfs` from a6l-radio.sh (domain_auto_trans): fds inherited from the a6l_radio_ctl shell (r22 rmtfs fd use x2;
# tqftpserv and diag-router are started the same way, inferred)
allow { a6l_rmtfs a6l_tqftpserv a6l_diag } a6l_radio_ctl:fd use;
