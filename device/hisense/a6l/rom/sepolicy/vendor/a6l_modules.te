# /vendor/bin/a6l-modules.sh display|adsp|misc|bootinfo (services a6l_modules_*, a6l_bootinfo). Written from reading the
# script (release-prep 27 Sep 2026); complete with `dmesg | grep avc | grep a6l_modules` from the first permissive install.
type a6l_modules, domain;
init_daemon_domain(a6l_modules)

# /vendor/bin/sh + toybox (grep, sed, cat, sleep, ls, readlink, mkdir, chown, chmod, insmod)
allow a6l_modules vendor_shell_exec:file rx_file_perms;
allow a6l_modules vendor_toolbox_exec:file rx_file_perms;
allow a6l_modules kmsg_device:chr_file { write append getattr };     # stdio_to_kmsg

# modules: /vendor/lib/modules + lists /vendor/etc/a6l/modules/*.txt
allow a6l_modules self:capability { sys_module chown fowner };   # dac_override/dac_read_search: neverallowed for vendor domains
allow a6l_modules vendor_kernel_modules:system module_load;
r_dir_file(a6l_modules, vendor_kernel_modules)
allow a6l_modules vendor_configs_file:dir r_dir_perms;
allow a6l_modules vendor_configs_file:file r_file_perms;
allow a6l_modules proc_modules:file r_file_perms;
r_dir_file(a6l_modules, proc_asound)

# remoteproc start (ADSP), connector status (e-ink off), i2c new_device (TMD3702 on c176000 = sysfs_a6l_epd), IIO chown
allow a6l_modules { sysfs sysfs_a6l_remoteproc sysfs_a6l_drm sysfs_a6l_epd sysfs_a6l_iio sysfs_leds sysfs_a6l_power_supply }:dir r_dir_perms;
allow a6l_modules { sysfs sysfs_a6l_remoteproc sysfs_a6l_drm sysfs_a6l_epd sysfs_a6l_iio sysfs_leds sysfs_a6l_power_supply }:lnk_file read;
allow a6l_modules { sysfs_a6l_remoteproc sysfs_a6l_drm sysfs_a6l_epd }:file rw_file_perms;
allow a6l_modules { sysfs sysfs_leds sysfs_a6l_power_supply }:file r_file_perms;
# r5 bug hunt power (29 Sep 2026): charger/FG power_supply nodes are now sysfs_batteryinfo (genfs_contexts); misc/offcharge log them
r_dir_file(a6l_modules, sysfs_batteryinfo)
allow a6l_modules sysfs_a6l_iio:file { r_file_perms setattr };
allow a6l_modules iio_device:chr_file { getattr setattr };
allow a6l_modules sysfs_dt_firmware_android:file r_file_perms;

# /dev/a6l/eink-mode (hand-off to a6l_epdd)
type_transition a6l_modules device:dir a6l_dev_file "a6l";
allow a6l_modules device:dir { add_name write search };
allow a6l_modules a6l_dev_file:dir create_dir_perms;
allow a6l_modules a6l_dev_file:file create_file_perms;
allow a6l_epdd a6l_dev_file:dir r_dir_perms;
allow a6l_epdd a6l_dev_file:file r_file_perms;

# properties: feature gates, lease-socket probe. Setting persist.graphics.egl is NEVERALLOWED for vendor domains
# (graphics_config_writable_prop: system/sepolicy/private/gpuservice.te) -> r5 F11: the script only publishes the boot-scoped
# vendor.a6l.gpu=mesa|angle and init.qcom.rc (vendor_init) copies it into persist.graphics.egl at post-fs-data.
get_prop(a6l_modules, vendor_a6l_prop)
set_prop(a6l_modules, vendor_a6l_prop)
get_prop(a6l_modules, vendor_a6l_ro_prop)
get_prop(a6l_modules, vendor_default_prop)

# ---- selinux-20261007 (round 11 vendor, boot 10affa76, permissive; firmware/extracted/selinux-20261007/README.md) ----
# The r11 rc files still carry `seclabel u:r:vendor_modprobe:s0`, so every a6l-modules.sh access below was logged as
# vendor_modprobe (the entrypoint denial on a6l_modules_exec proves the file label is already on the image). With the rc
# transform (tools/release/a6l_selinux_prep.py T1, A6L_SELINUX_PREP=1) the script runs here instead; these are the
# accesses the r11 log shows that this domain did not have yet, plus what vendor_modprobe had silently from AOSP
# (system/sepolicy/vendor/vendor_modprobe.te: proc_cmdline, kernel keyring search) that the script also uses.
# stdio_to_kmsg on userdebug = /dev/kmsg_debug (child getattr from sleep/grep/insmod; TCGETS from the shell's isatty)
allow a6l_modules kmsg_debug_device:chr_file { w_file_perms getattr };
dontaudit a6l_modules { kmsg_device kmsg_debug_device }:chr_file ioctl;
allow a6l_modules proc_cmdline:file r_file_perms;              # grep a6l.dpu_virtual_planes=1 /proc/cmdline
allow a6l_modules kernel:key search;                           # module signature keyring (as vendor_modprobe)
# insmod qrtr.ko: qrtr_ns_init() binds the QRTR control port in the insmod task -> CAP_NET_ADMIN (r11 33.99 s, right after
# "NET: Registered PF_QIPCRTR protocol family" in r8/r10). Denied = no QRTR name service = no ADSP/SMGR/modem services.
allow a6l_modules self:capability net_admin;
# chmod 0664 on the SMGR IIO buffer files: CAP_FSETID is only checked to keep a setgid bit we never set
dontaudit a6l_modules self:capability fsetid;
# /proc/sys/kernel/printk: loglevel 7 around insmod msm.ko (restart-hang console trace), restored afterwards
allow a6l_modules proc_a6l_printk:file rw_file_perms;
# eink-round6e touch_rebind(): echo 1-0038 > /sys/bus/i2c/drivers/edt_ft5x06/bind (front touch lost its probe race)
allow a6l_modules sysfs_a6l_touch:dir r_dir_perms;
allow a6l_modules sysfs_a6l_touch:file w_file_perms;
# misc group presence checks ([ -e .../brightness ], [ -e .../activate ]): e-ink frontlight and vibrator LED class devices
allow a6l_modules sysfs_a6l_dualux:dir search;
allow a6l_modules sysfs_a6l_dualux:file getattr;
allow a6l_modules sysfs_a6l_vibrator:dir search;
allow a6l_modules sysfs_a6l_vibrator:file getattr;
# debug builds (ro.vendor.a6l.krec=1): wait for /dev/a6l-krec.ready, created by a6l-krec (su) and labelled a6l_dev_file
# by the userdebug type_transition in rom/selinux/sepolicy/vendor/a6l_debug.te (was `device`: [ -e ] fails when enforcing
# = the display group would wait its full 5 s on every debug boot)
allow a6l_modules a6l_dev_file:file r_file_perms;
# selinux-20261007 pass 2 (round 12): `[ -e /sys/class/drm/renderD128 ]` resolves into 5000000.gpu/drm (sysfs_gpu since
# pass 1). Denied in enforcing = "NO renderD128 -> EGL angle (software)" for the whole boot. Directories only.
allow a6l_modules sysfs_gpu:dir r_dir_perms;
# selinux-20261007 pass 3 (round 21): cfg80211.ko (wifi-20261008 0001: loaded by the misc group before wificond) creates
# its .builtin_regdb_keys keyring in the insmod task (key labelled a6l_modules, write), and the regulatory worker later
# searches it to verify regulatory.db (kernel search). Denied = no signed regdb -> world regulatory domain only.
allow a6l_modules self:key write;
allow kernel a6l_modules:key search;
