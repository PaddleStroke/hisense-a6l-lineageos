+/*
+ * A6L ipa2fix (24 Sep 2026): the first MODE=load reset the phone with no log. Every hardware phase of the
+ * probe is now preceded by a "A6L_IPA_STEP <n> <what>" pr_emerg line and a pause (stream it with dmesg -w).
+ *   stop_at=N       return -ECANCELED just BEFORE step N (0 = run everything); after a clean stop the
+ *                   driver can be removed and re-inserted with a larger N in the same boot.
+ *   step_ms         pause after each marker (default 50 ms; msleep so the dmesg -w reader can run)
+ *   no_ipa_reset    skip the IPA_COMP_SW_RESET pulse (step 6)
+ *   no_bam_reset    skip the BAM global BAM_SW_RST pulse (step 8)
+ *   no_sram_direct  skip the direct SRAM canary writes / uc_loaded read (step 10; layout still computed)
+ *   comp_cfg        value written to IPA_COMP_CFG (stock SDM660 ipa_init_hw writes 0x11; msm8953 ipa2-lite 0x1)
+ */
+static uint stop_at;
+module_param(stop_at, uint, 0644);
+MODULE_PARM_DESC(stop_at, "stop the probe just before step N (0 = no stop)");
+static uint step_ms = 50;
+module_param(step_ms, uint, 0644);
+static bool no_ipa_reset;
+module_param(no_ipa_reset, bool, 0444);
+static bool no_bam_reset;
+module_param(no_bam_reset, bool, 0444);
+static bool no_sram_direct;
+module_param(no_sram_direct, bool, 0444);
+static uint comp_cfg = 0x11;
+module_param(comp_cfg, uint, 0444);
+static u32 a6l_uc_loaded_dummy;
+
+static int a6l_step(unsigned int n, const char *what)
+{
+	if (stop_at && n >= stop_at) {
+		pr_emerg("A6L_IPA_STEP %u STOP (stop_at=%u) before: %s\n", n, stop_at, what);
+		return -ECANCELED;
+	}
+	pr_emerg("A6L_IPA_STEP %u %s\n", n, what);
+	if (step_ms)
+		msleep(step_ms);
+	return 0;
+}
