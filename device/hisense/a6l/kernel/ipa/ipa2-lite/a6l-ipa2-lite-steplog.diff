+/* A6L ipa2fix: on a stop_at/error exit after the BAM was enabled, leave the pipes and the BAM disabled
+ * before devm frees the descriptor FIFOs (nothing may DMA into freed memory). */
+static void a6l_quiesce(struct ipa *ipa, int last_step)
+{
+	int id;
+
+	if (last_step < 9)
+		return;
+	if (last_step >= 11)
+		for (id = 0; id < EP_NUM; id++)
+			iowrite32(0, ipa->mmio + REG_BAM_P_CTRL(id));
+	rmw32(ipa->mmio + REG_BAM_CTRL, BAM_EN, 0);
+	pr_emerg("A6L_IPA quiesced after step %d: bam_ctrl 0x%08x\n", last_step,
+		 ioread32(ipa->mmio + REG_BAM_CTRL));
 }
 
