+#include <linux/ktime.h>
+#include <linux/of.h>
+#include <linux/workqueue.h>
+#include <drm/drm_panel.h>
 
 #define WORK_REGISTER_THRESHOLD		0x00
 #define WORK_REGISTER_REPORT_RATE	0x08
@@ -146,6 +151,29 @@
