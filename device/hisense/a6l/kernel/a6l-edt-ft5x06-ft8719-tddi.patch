+	bool a6l;
+	bool a6l_following;		/* registered as a drm_panel follower of the LCD */
+	bool a6l_lcd_on;		/* LCD half prepared: the touch half scans */
+	bool a6l_kick;			/* one discarded read after an LCD power-on */
+	bool a6l_replay_guard;		/* drop frames identical to the last one before the LCD went off */
+	bool a6l_dying;
+	struct mutex a6l_lock;		/* ISR, follower callbacks and the work: one reporter at a time */
+	struct drm_panel_follower a6l_follower;
+	struct delayed_work a6l_work;	/* point report check + post-power-on read */
+	struct delayed_work a6l_follow_work;
+	unsigned int a6l_follow_tries;
+	unsigned long a6l_last_frame;	/* jiffies of the last successful read */
+	unsigned long a6l_settle_until;
+	ktime_t a6l_on_time;
+	unsigned int a6l_trace_left;
+	u8 a6l_last[63];
+	u8 a6l_off_frame[63];
+	struct {
+		u32 lcd_on, lcd_off, frames, off_irqs, settle, replay, abnormal, reset, read_errors;
+		u32 lifted_lcd, prc_reads, prc_recovered, prc_lifted;
+	} a6l_st;
 };
 
