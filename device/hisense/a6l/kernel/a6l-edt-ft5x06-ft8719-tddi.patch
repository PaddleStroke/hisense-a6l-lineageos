+}
+
+/*
+ * A6L (Hisense A6L, firmware/extracted/wake-touch-20261011): the front touchscreen is the touch half of the FT8719
+ * TDDI. It only scans while the LCD half is powered and initialised, and the LCD panel driver resets the chip at every
+ * screen-on. This driver never learns about it, so:
+ *  - a contact that is down when the LCD goes off (or that the controller reports while the LCD is switched off or
+ *    re-initialised) never gets its lift: the slot stays active, InputReader re-reads it at the next wake
+ *    (EVIOCGMTSLOTS) and the first swipe is swallowed as a move of that stale pointer, or the stale pointer lands
+ *    before any window is touchable and the gesture is dropped ("swipe ignored, swipe again");
+ *  - nothing ever lifts a contact whose lift event was lost.
+ * The stock focaltech driver lifts every finger at LCD suspend and resume, lifts fingers missing from a frame and
+ * lifts everything after 200 ms without a report while fingers are down (FTS_POINT_REPORT_CHECK). This does the same,
+ * for "focaltech,ft8719" only (the rear touchscreen keeps the upstream behaviour):
+ *  - follows the LCD panel (drm_panel_follower): lift all at unprepare and at prepare, no I2C while the LCD is off,
+ *    drop frames for a6l_settle_ms after the LCD is up and frames that replay the last pre-off frame, then one
+ *    discarded read (releases an interrupt the controller may still hold);
+ *  - lifts slots missing from a frame (input_mt_drop_unused), drops implausible frames (vendor checks);
+ *  - point report check: a6l_prc_ms without an interrupt while contacts are down -> one read; new data is reported
+ *    (lost edge), unchanged data lifts every contact.
+ */
+static bool a6l_tddi = true;
+module_param(a6l_tddi, bool, 0444);
+MODULE_PARM_DESC(a6l_tddi, "A6L: FT8719 TDDI handling (follow the LCD, lift stale contacts)");
+static char *a6l_panel = "mdss,ft8719-tianma-1080x2340";
+module_param(a6l_panel, charp, 0444);
+MODULE_PARM_DESC(a6l_panel, "A6L: compatible of the LCD panel to follow when the DT has no \"panel\" phandle (empty: none)");
+static unsigned int a6l_settle_ms = 50;
+module_param(a6l_settle_ms, uint, 0644);
+MODULE_PARM_DESC(a6l_settle_ms, "A6L: frames dropped for this long after the LCD is prepared");
+static unsigned int a6l_prc_ms = 200;
+module_param(a6l_prc_ms, uint, 0644);
+MODULE_PARM_DESC(a6l_prc_ms, "A6L: point report check, ms without an interrupt while contacts are down (0: off)");
+static unsigned int a6l_trace_frames;
+module_param(a6l_trace_frames, uint, 0644);
+MODULE_PARM_DESC(a6l_trace_frames, "A6L: log the first N frames after each LCD power-on (0: off)");
+
+static unsigned int edt_a6l_active(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct input_mt *mt = tsdata->input->mt;
+	unsigned int i, n = 0;
+
+	for (i = 0; i < mt->num_slots; i++)
+		if (input_mt_is_active(&mt->slots[i]))
+			n++;
+	return n;
+}
+
+/* a6l_lock held. Lifts every active contact in one frame. */
+static unsigned int edt_a6l_lift_all(struct edt_ft5x06_ts_data *tsdata)
+{
+	unsigned int n = edt_a6l_active(tsdata);
+
+	if (!n)
+		return 0;
+	/* every reporting path ends with input_mt_drop_unused(), so no slot is "used" in the current frame */
+	input_mt_drop_unused(tsdata->input);
+	input_mt_report_pointer_emulation(tsdata->input, true);
+	input_sync(tsdata->input);
+	return n;
+}
+
+/* vendor driver checks: point count in range, no touching point in a frame that says "no point" */
+static bool edt_a6l_frame_ok(struct edt_ft5x06_ts_data *tsdata, const u8 *rdbuf)
+{
+	int i, n, type, id;
+
+	if (tsdata->tdata_offset != 3)	/* no TD_STATUS byte in this layout */
+		return true;
+	n = rdbuf[2] & 0x0f;
+	if (n > tsdata->max_support_points)
+		return false;
+	if (n)
+		return true;
+	for (i = 0; i < tsdata->max_support_points; i++) {
+		const u8 *buf = &rdbuf[i * tsdata->point_len + tsdata->tdata_offset];
+
+		type = buf[0] >> 6;
+		id = (buf[2] >> 4) & 0x0f;
+		if (id < tsdata->max_support_points && (type == TOUCH_EVENT_DOWN || type == TOUCH_EVENT_ON))
+			return false;
+	}
+	return true;
+}
+
+/* all-0xff touch data: the controller restarted (vendor: "touch buff is 0xff, need recovery state") */
+static bool edt_a6l_reset_state(struct edt_ft5x06_ts_data *tsdata, const u8 *rdbuf)
+{
+	return tsdata->tdata_offset == 3 && rdbuf[2] == 0xff && rdbuf[3] == 0xff && rdbuf[4] == 0xff &&
+	       rdbuf[5] == 0xff && rdbuf[6] == 0xff;
+}
+
+enum edt_a6l_why { EDT_A6L_IRQ, EDT_A6L_KICK, EDT_A6L_PRC };
+
+static void edt_a6l_handle(struct edt_ft5x06_ts_data *tsdata, enum edt_a6l_why why)
+{
+	struct device *dev = &tsdata->client->dev;
+	unsigned int n;
+	u8 rdbuf[63];
+	int error;
+
+	mutex_lock(&tsdata->a6l_lock);
+	if (tsdata->factory_mode && why != EDT_A6L_IRQ)	/* debugfs raw-data mode: touch data is not readable */
+		goto unlock;
+	if (!tsdata->a6l_lcd_on) {	/* the touch half is down with the LCD: no I2C */
+		if (why == EDT_A6L_IRQ)
+			tsdata->a6l_st.off_irqs++;
+		goto unlock;
+	}
+
+	memset(rdbuf, 0, sizeof(rdbuf));
+	error = regmap_bulk_read(tsdata->regmap, tsdata->tdata_cmd, rdbuf, tsdata->tdata_len);
+	if (error) {
+		tsdata->a6l_st.read_errors++;
+		dev_err_ratelimited(dev, "Unable to fetch data, error: %d\n", error);
+		goto unlock;
+	}
+
+	if (why == EDT_A6L_PRC) {
+		tsdata->a6l_st.prc_reads++;
+		if (!memcmp(rdbuf, tsdata->a6l_last, tsdata->tdata_len)) {
+			n = edt_a6l_lift_all(tsdata);
+			tsdata->a6l_st.prc_lifted += n;
+			if (n)
+				dev_info_ratelimited(dev, "A6L_TOUCH: no report for %u ms with %u contact(s) down: lifted\n",
+						     jiffies_to_msecs(jiffies - tsdata->a6l_last_frame), n);
+			goto unlock;
+		}
+		tsdata->a6l_st.prc_recovered++;
+		dev_info_ratelimited(dev, "A6L_TOUCH: no interrupt for %u ms but new touch data (lost edge): reported\n",
+				     jiffies_to_msecs(jiffies - tsdata->a6l_last_frame));
+	}
+	memcpy(tsdata->a6l_last, rdbuf, tsdata->tdata_len);
+	tsdata->a6l_last_frame = jiffies;
+
+	if (tsdata->a6l_trace_left) {
+		tsdata->a6l_trace_left--;
+		dev_info(dev, "A6L_TOUCH trace t+%lld ms %s: %*ph\n",
+			 ktime_ms_delta(ktime_get(), tsdata->a6l_on_time),
+			 why == EDT_A6L_KICK ? "kick" : why == EDT_A6L_PRC ? "prc" : "irq",
+			 min(tsdata->tdata_len, 3 + 2 * tsdata->point_len), rdbuf);
+	}
+
+	if (why == EDT_A6L_KICK)	/* only to release a held interrupt: the data may predate the power-on */
+		goto unlock;
+	if (time_before(jiffies, tsdata->a6l_settle_until)) {
+		tsdata->a6l_st.settle++;
+		goto unlock;
+	}
+	if (tsdata->a6l_replay_guard) {
+		if (!memcmp(rdbuf, tsdata->a6l_off_frame, tsdata->tdata_len) && !edt_a6l_reset_state(tsdata, rdbuf)) {
+			tsdata->a6l_st.replay++;
+			goto unlock;
+		}
+		tsdata->a6l_replay_guard = false;
+	}
+	if (edt_a6l_reset_state(tsdata, rdbuf)) {
+		tsdata->a6l_st.reset++;
+		tsdata->a6l_st.lifted_lcd += edt_a6l_lift_all(tsdata);
+		goto unlock;
+	}
+	if (!edt_a6l_frame_ok(tsdata, rdbuf)) {
+		tsdata->a6l_st.abnormal++;
+		dev_info_ratelimited(dev, "A6L_TOUCH: implausible frame dropped: %*ph\n",
+				     min(tsdata->tdata_len, 3 + 2 * tsdata->point_len), rdbuf);
+		goto unlock;
+	}
+
+	edt_ft5x06_report_points(tsdata, rdbuf);
+	input_mt_drop_unused(tsdata->input);	/* a contact missing from the frame is no longer touching */
+	input_mt_report_pointer_emulation(tsdata->input, true);
+	input_sync(tsdata->input);
+	tsdata->a6l_st.frames++;
+
+	if (a6l_prc_ms && !READ_ONCE(tsdata->a6l_dying) && edt_a6l_active(tsdata))
+		mod_delayed_work(system_wq, &tsdata->a6l_work, msecs_to_jiffies(a6l_prc_ms));
+unlock:
+	mutex_unlock(&tsdata->a6l_lock);
+}
+
+static void edt_a6l_work_fn(struct work_struct *work)
+{
+	struct edt_ft5x06_ts_data *tsdata = container_of(to_delayed_work(work), struct edt_ft5x06_ts_data, a6l_work);
+	enum edt_a6l_why why = EDT_A6L_PRC;
+	unsigned long due;
+
+	if (READ_ONCE(tsdata->a6l_dying))
+		return;
+	mutex_lock(&tsdata->a6l_lock);
+	if (tsdata->a6l_kick) {
+		tsdata->a6l_kick = false;
+		why = EDT_A6L_KICK;
+	} else if (!a6l_prc_ms || !tsdata->a6l_lcd_on || !edt_a6l_active(tsdata)) {
+		mutex_unlock(&tsdata->a6l_lock);
+		return;
+	} else {
+		due = tsdata->a6l_last_frame + msecs_to_jiffies(a6l_prc_ms);
+		if (time_before(jiffies, due)) {
+			mod_delayed_work(system_wq, &tsdata->a6l_work, due - jiffies);
+			mutex_unlock(&tsdata->a6l_lock);
+			return;
+		}
+	}
+	mutex_unlock(&tsdata->a6l_lock);
+	edt_a6l_handle(tsdata, why);
+	if (why == EDT_A6L_KICK && a6l_prc_ms && !READ_ONCE(tsdata->a6l_dying))
+		mod_delayed_work(system_wq, &tsdata->a6l_work, msecs_to_jiffies(a6l_prc_ms));
+}
+
+static int edt_a6l_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct edt_ft5x06_ts_data *t = container_of(follower, struct edt_ft5x06_ts_data, a6l_follower);
+
+	mutex_lock(&t->a6l_lock);
+	t->a6l_st.lifted_lcd += edt_a6l_lift_all(t);
+	t->a6l_lcd_on = true;
+	t->a6l_on_time = ktime_get();
+	t->a6l_last_frame = jiffies;
+	t->a6l_settle_until = jiffies + msecs_to_jiffies(a6l_settle_ms);
+	t->a6l_replay_guard = true;
+	t->a6l_trace_left = a6l_trace_frames;
+	t->a6l_kick = true;
+	t->a6l_st.lcd_on++;
+	dev_info(&t->client->dev,
+		 "A6L_TOUCH lcd on #%u: frames=%u off_irqs=%u settle=%u replay=%u abnormal=%u reset=%u rerr=%u lifted_lcd=%u prc=%u/%u/%u\n",
+		 t->a6l_st.lcd_on, t->a6l_st.frames, t->a6l_st.off_irqs, t->a6l_st.settle, t->a6l_st.replay,
+		 t->a6l_st.abnormal, t->a6l_st.reset, t->a6l_st.read_errors, t->a6l_st.lifted_lcd,
+		 t->a6l_st.prc_reads, t->a6l_st.prc_recovered, t->a6l_st.prc_lifted);
+	if (!READ_ONCE(t->a6l_dying))
+		mod_delayed_work(system_wq, &t->a6l_work, msecs_to_jiffies(a6l_settle_ms + 10));
+	mutex_unlock(&t->a6l_lock);
+	return 0;
+}
+
+static int edt_a6l_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct edt_ft5x06_ts_data *t = container_of(follower, struct edt_ft5x06_ts_data, a6l_follower);
+	unsigned int n;
+
+	mutex_lock(&t->a6l_lock);
+	t->a6l_lcd_on = false;
+	t->a6l_kick = false;
+	n = edt_a6l_lift_all(t);
+	t->a6l_st.lifted_lcd += n;
+	t->a6l_st.lcd_off++;
+	memcpy(t->a6l_off_frame, t->a6l_last, sizeof(t->a6l_off_frame));
+	mutex_unlock(&t->a6l_lock);
+	if (n)
+		dev_info(&t->client->dev, "A6L_TOUCH lcd off: lifted %u contact(s)\n", n);
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs edt_a6l_follower_funcs = {
+	.panel_prepared = edt_a6l_panel_prepared,
+	.panel_unpreparing = edt_a6l_panel_unpreparing,
+};
+
+/*
+ * The A6L DT (a6l-front-touch.dtso) has no "panel" phandle yet; until the boot image carries one
+ * (0002-device-a6l-front-touch-follow-the-lcd-panel.patch), add it at runtime from a6l_panel. The property is never
+ * freed: it belongs to the live tree, and a later insmod finds it there.
+ */
+static void edt_a6l_add_panel_property(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	struct device_node *pn;
+	struct property *prop;
+	__be32 *val;
+	int ret;
+
+	if (drm_is_panel_follower(dev) || !a6l_panel || !a6l_panel[0] || !dev->of_node)
+		return;
+	pn = of_find_compatible_node(NULL, NULL, a6l_panel);
+	if (!pn || !pn->phandle) {
+		dev_warn(dev, "A6L_TOUCH: panel \"%s\" %s: not following the LCD\n", a6l_panel,
+			 pn ? "has no phandle" : "not in the DT");
+		of_node_put(pn);
+		return;
+	}
+	prop = kzalloc(sizeof(*prop), GFP_KERNEL);
+	val = kzalloc(sizeof(*val), GFP_KERNEL);
+	if (prop)
+		prop->name = kstrdup("panel", GFP_KERNEL);
+	if (!prop || !val || !prop->name) {
+		if (prop)
+			kfree(prop->name);
+		kfree(prop);
+		kfree(val);
+		of_node_put(pn);
+		return;
+	}
+	*val = cpu_to_be32(pn->phandle);
+	prop->value = val;
+	prop->length = sizeof(*val);
+	ret = of_add_property(dev->of_node, prop);
+	if (ret) {
+		dev_warn(dev, "A6L_TOUCH: adding \"panel\" failed: %d\n", ret);
+		kfree(prop->name);
+		kfree(prop);
+		kfree(val);
+	} else {
+		dev_info(dev, "A6L_TOUCH: no \"panel\" in the DT: following %pOF (added at runtime)\n", pn);
+	}
+	of_node_put(pn);
+}
+
+static void edt_a6l_follow(struct edt_ft5x06_ts_data *tsdata)
+{
+	struct device *dev = &tsdata->client->dev;
+	int ret;
+
+	if (READ_ONCE(tsdata->a6l_dying) || tsdata->a6l_following || !drm_is_panel_follower(dev))
+		return;
+	tsdata->a6l_follower.funcs = &edt_a6l_follower_funcs;
+	/* the LCD state is unknown until the panel says: drm_panel_add_follower() calls panel_prepared if it is on */
+	mutex_lock(&tsdata->a6l_lock);
+	tsdata->a6l_lcd_on = false;
+	mutex_unlock(&tsdata->a6l_lock);
+	ret = drm_panel_add_follower(dev, &tsdata->a6l_follower);
+	if (!ret) {
+		tsdata->a6l_following = true;
+		dev_info(dev, "A6L_TOUCH: following the LCD panel (LCD %s)\n", tsdata->a6l_lcd_on ? "on" : "off");
+		return;
+	}
+	mutex_lock(&tsdata->a6l_lock);
+	tsdata->a6l_lcd_on = true;	/* not following: behave as before */
+	mutex_unlock(&tsdata->a6l_lock);
+	if (ret == -EPROBE_DEFER && tsdata->a6l_follow_tries++ < 30) {
+		schedule_delayed_work(&tsdata->a6l_follow_work, HZ);
+		return;
+	}
+	dev_warn(dev, "A6L_TOUCH: cannot follow the LCD panel: %d\n", ret);
+}
+
+static void edt_a6l_follow_work_fn(struct work_struct *work)
+{
+	edt_a6l_follow(container_of(to_delayed_work(work), struct edt_ft5x06_ts_data, a6l_follow_work));
+}
+
+static void edt_a6l_teardown(void *arg)
+{
+	struct edt_ft5x06_ts_data *tsdata = arg;
+
+	WRITE_ONCE(tsdata->a6l_dying, true);
+	cancel_delayed_work_sync(&tsdata->a6l_follow_work);
+	if (tsdata->a6l_following)
+		drm_panel_remove_follower(&tsdata->a6l_follower);	/* no callback after this */
+	synchronize_irq(tsdata->client->irq);			/* a running handler finished; new ones see a6l_dying */
+	cancel_delayed_work_sync(&tsdata->a6l_work);
+}
+
+static void edt_a6l_init(struct edt_ft5x06_ts_data *tsdata)
+{
+	mutex_init(&tsdata->a6l_lock);
+	INIT_DELAYED_WORK(&tsdata->a6l_work, edt_a6l_work_fn);
+	INIT_DELAYED_WORK(&tsdata->a6l_follow_work, edt_a6l_follow_work_fn);
+	tsdata->a6l_lcd_on = true;
+	tsdata->a6l_last_frame = jiffies;
+	tsdata->a6l = true;
+}
+
+static irqreturn_t edt_ft5x06_ts_isr(int irq, void *dev_id)
+{
+	struct edt_ft5x06_ts_data *tsdata = dev_id;
+	struct device *dev = &tsdata->client->dev;
+	u8 rdbuf[63];
+	int error;
+
+	if (tsdata->a6l) {
+		edt_a6l_handle(tsdata, EDT_A6L_IRQ);
+		return IRQ_HANDLED;
+	}
+
+	memset(rdbuf, 0, sizeof(rdbuf));
+	error = regmap_bulk_read(tsdata->regmap, tsdata->tdata_cmd, rdbuf,
