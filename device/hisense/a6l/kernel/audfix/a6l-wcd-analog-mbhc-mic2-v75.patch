+static void a6l_mbhc_dump(struct snd_soc_component *component, const char *tag)
+{
+	static const u16 dregs[] = { 0xf010, 0xf011, 0xf012, 0xf013, 0xf015, 0xf018, 0xf019,
+				     0xf046, 0xf048, 0xf049, 0xf04a, 0xf110, 0xf118, 0xf191, 0xf197 };
+	char buf[480];
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(dregs); i++)
+		n += scnprintf(buf + n, sizeof(buf) - n, " %03x=%02x", dregs[i] & 0xfff,
+			       snd_soc_component_read(component, dregs[i]) & 0xff);
+	for (i = 0xf140; i <= 0xf15f; i++)
+		n += scnprintf(buf + n, sizeof(buf) - n, " %03x=%02x", i & 0xfff,
+			       snd_soc_component_read(component, i) & 0xff);
+	dev_info(component->dev, "A6L_MBHC_DIAG %s:%s\n", tag, buf);
+}
+
+#define A6L_NSAMP	5
+#define CDC_A_MBHC_ELECT_SCHMT_ISRC_MASK	GENMASK(2, 1)	/* DET_CTL_2, downstream WCD_MBHC_ELECT_SCHMT_ISRC */
+
+/*
+ * v2 (28 Sep 2026). v1 assumed MBHC_RESULT_1 = 0x1f for "mic present"; on the phone a real 4-pole headset gave
+ * btn_result=0x00 elect_result=0x00 at every insertion. RESULT_1 is only the latched button code of the last
+ * button event (0 = BTN0), not a live level, so it cannot tell a mic from a grounded ring by itself. The downstream
+ * msm-4.4 wcd-mbhc-v2 (msm8x16/analog-cdc) rule is used instead: with MIC BIAS2 on and the FSM running,
+ *   no button-press interrupt && HS_COMP_RESULT (ZDET_ELECT_RESULT bit0) == 0  -> HEADSET
+ *   button press (mic line pulled below the BTN0 threshold, i.e. grounded mic ring) -> HEADPHONE (3-pole)
+ * Here "grounded" needs positive evidence on both the live comparator (CDC_D_INT_RT_STS bit5 on every sample) and
+ * a press interrupt since the last removal; everything else (incl. HS_COMP high = mic line open) ends as HEADSET,
+ * so a 4-pole headset is never silently reported as headphones.
+ */
+static void a6l_mbhc_hs_work(struct work_struct *work)
+{
+	struct pm8916_wcd_analog_priv *priv = container_of(to_delayed_work(work),
+			struct pm8916_wcd_analog_priv, a6l_hs_work);
+	struct snd_soc_component *component = priv->component;
+	struct snd_soc_dapm_context *dapm;
+	u32 rt = 0, res = 0, elect = 0, elect_schmt, ctl2, micb2;
+	int i, n_rt_press = 0, n_hscomp = 0, presses, releases;
+	bool grounded;
+
+	/* the card (and its DAPM mutex) exists once the machine driver has set the jack */
+	if (!component || !READ_ONCE(priv->jack) || !priv->a6l_inserted)
+		return;
+	dapm = snd_soc_component_to_dapm(component);
+
+	if (a6l_mbhc_diag)
+		a6l_mbhc_dump(component, "pre");
+	priv->a6l_win_presses = 0;
+	priv->a6l_win_releases = 0;
+	priv->a6l_win_press_res = 0xff;
+	priv->a6l_measuring = true;
+	snd_soc_dapm_force_enable_pin(dapm, "MIC BIAS External2");
+	snd_soc_dapm_sync(dapm);
+	msleep(100);
+	micb2 = snd_soc_component_read(component, CDC_A_MICB_2_EN);
+	if (a6l_mbhc_diag)
+		a6l_mbhc_dump(component, "micb2");
+	for (i = 0; i < A6L_NSAMP; i++) {
+		if (i)
+			msleep(20);
+		rt = snd_soc_component_read(component, CDC_D_INT_RT_STS);
+		res = snd_soc_component_read(component, CDC_A_MBHC_RESULT_1);
+		elect = snd_soc_component_read(component, CDC_A_MBHC_ZDET_ELECT_RESULT);
+		if (rt & MBHC_BUTTON_PRESS_DET)
+			n_rt_press++;
+		if (elect & BIT(0))
+			n_hscomp++;
+	}
+	/* downstream cross-connection check: electrical schmitt current source on for a moment (debug only) */
+	ctl2 = snd_soc_component_read(component, CDC_A_MBHC_DET_CTL_2);
+	snd_soc_component_update_bits(component, CDC_A_MBHC_DET_CTL_2,
+				      CDC_A_MBHC_ELECT_SCHMT_ISRC_MASK, 2 << 1);
+	msleep(20);
+	elect_schmt = snd_soc_component_read(component, CDC_A_MBHC_ZDET_ELECT_RESULT);
+	if (a6l_mbhc_diag)
+		a6l_mbhc_dump(component, "schmt");
+	snd_soc_component_update_bits(component, CDC_A_MBHC_DET_CTL_2,
+				      CDC_A_MBHC_ELECT_SCHMT_ISRC_MASK, ctl2);
+	/* drop the force but keep the pin connected (disable_pin would cut the headset-mic bias for later captures) */
+	snd_soc_dapm_enable_pin(dapm, "MIC BIAS External2");
+	snd_soc_dapm_sync(dapm);
+	msleep(60);	/* let the mic line settle before button interrupts count again */
+	presses = priv->a6l_win_presses;
+	releases = priv->a6l_win_releases;
+	priv->a6l_measuring = false;
+	if (a6l_mbhc_diag)
+		a6l_mbhc_dump(component, "post");
+
+	if (!priv->a6l_inserted)
+		return;
+	dev_info(component->dev,
+		 "A6L_MBHC try %d: micb2_en=0x%02x rt_press=%d/%d hs_comp=%d/%d btn_result=0x%02x elect_result=0x%02x elect_schmt=0x%02x win_press=%d win_rel=%d press_res=0x%02x ins_presses=%d rt=0x%02x\n",
+		 priv->a6l_hs_tries, micb2 & 0xff, n_rt_press, A6L_NSAMP, n_hscomp, A6L_NSAMP,
+		 res & 0xff, elect & 0xff, elect_schmt & 0xff, presses, releases,
+		 priv->a6l_win_press_res & 0xff, priv->a6l_ins_presses, rt & 0xff);
+
+	grounded = n_rt_press == A6L_NSAMP && (presses + priv->a6l_ins_presses) > 0;
+	if (grounded) {
+		if (++priv->a6l_hs_tries < 3) {
+			/* a button may be held during insertion: measure again */
+			mod_delayed_work(system_wq, &priv->a6l_hs_work, msecs_to_jiffies(500));
+			return;
+		}
+		/* mic ring grounded: 3-pole. Release a BTN_0 the press handler may have reported. */
+		snd_soc_jack_report(priv->jack, 0, btn_mask);
+		dev_info(component->dev, "A6L_MBHC_HEADPHONE (mic line grounded: 3-pole)\n");
+		return;
+	}
+	if (n_hscomp == A6L_NSAMP && ++priv->a6l_hs_tries < 3) {
+		/* mic line above HS_VREF (open / not fully inserted yet): measure again */
+		mod_delayed_work(system_wq, &priv->a6l_hs_work, msecs_to_jiffies(500));
+		return;
+	}
+	snd_soc_jack_report(priv->jack, SND_JACK_HEADSET, hs_jack_mask);
+	if (n_hscomp == A6L_NSAMP)
+		dev_info(component->dev, "A6L_MBHC_HEADSET (fallback: hs_comp high, undecided)\n");
+	else if (n_rt_press)
+		dev_info(component->dev, "A6L_MBHC_HEADSET (fallback: rt_press=%d without press irq)\n", n_rt_press);
+	else
+		dev_info(component->dev, "A6L_MBHC_HEADSET (mic detected: no btn0 press with MIC BIAS2 on, hs_comp=0)\n");
+}
