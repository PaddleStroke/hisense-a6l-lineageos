# diag-r5 R5M (30 Sep 2026, docs/diag-r5-20260930.md): V67 .config + rom-v2 fragment + ONLY these (no a6l-android.config):
# MODVERSIONS (module ABI check, as r5), thermal delay (as r5), CFI permissive (as r5p). DEBUG ONLY: answers "is it the
# android config delta at all?". Needs its own module builds (kit mods-r5m).
CONFIG_MODVERSIONS=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=100
CONFIG_CFI_PERMISSIVE=y
