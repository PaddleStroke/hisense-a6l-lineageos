# A6L release (user) kernel config fragment - kernel-gaps 29 Sep 2026 (docs/kernel-gaps-20260929.md).
# Applied ON TOP of the r5 Android config (firmware/extracted/kernel-r5-20260930/config = V67 .config + rom-v2/config.fragment
# + a6l-android.config) ONLY for a release/user kernel. Debug, userdebug bring-up and RAM-boot diagnostic kernels keep the r5
# config (DEVMEM=y for a6l_mmio /dev/mem register dumps, kexec, hibernation image tools).
# NOT module-ABI neutral (build-release-config.sh --build, 29 Sep 2026): same vermagic, but 47 vmlinux export CRCs change
# (kmalloc/kmem_cache family, dma_iova_*, cpu_device_create, ...) and 13 kexec/hibernation/vmcore exports disappear (none imported
# by a staged module). With MODVERSIONS=y the r5 modules would be refused -> a release kernel needs the full module rebuild
# against its own tree (kernel-r5-20260930/scripts/build-r5-oot.sh pattern + in-tree modules) and its own stage variant.
# Merge: device/hisense/a6l/kernel/configs/build-release-config.sh (merge_config.sh -m + olddefconfig + value check).

# /dev/mem and /dev/port: only a6l_mmio (debug tool, never in the ROM) uses them.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# No kexec / crash kernel / hibernation on a release phone (replace the running kernel, write RAM images to swap).
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# Heap and stack hardening (GKI gki_defconfig has the same values).
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_FORTIFY_SOURCE=y
# r6b boot fix (30 Sep 2026): the debug/first-install kernel uses a6l-debug-cfi.config (CFI_PERMISSIVE=y, warn and continue);
# a release kernel keeps kCFI strict (a violation traps).
# CONFIG_CFI_PERMISSIVE is not set
