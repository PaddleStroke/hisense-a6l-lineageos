# A6L device kernel config fragment: Android requirements (kernel-config pass r5, 30 Sep 2026;
# docs/kernel-android-config-20260930.md). Merged ON TOP of out-a6l-phone-v67/.config + kernel/rom-v2/config.fragment
# with scripts/kconfig/merge_config.sh -m, then olddefconfig. Reference = Lineage 24 (release cp2a, Android 17):
# kernel/configs/c/android-6.18/android-base.config is EMPTY in this tree (placeholder), so the requirement set used is the
# latest populated one, kernel/configs/b/android-6.12/android-base.config + android-base-conditional.xml (arm64 group).
# Options that do not exist in mainline 7.2 and deliberate deviations are listed at the end (NOT silently skipped).

# ---- module ABI protection: Android requires it; also makes stale (pre-r5) modules REFUSE to load instead of loading
# ---- against a changed struct layout (inode/bio grow with FS_ENCRYPTION/FS_VERITY/BLK_INLINE_ENCRYPTION)
CONFIG_MODVERSIONS=y

# ---- storage / encryption (FBE fscrypt v2; eMMC ICE not enabled -> blk-crypto software fallback for inlinecrypt)
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_VERITY=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_DM_SNAPSHOT=y
CONFIG_QFMT_V2=y

# ---- crypto used by IPsec/IKE (IWLAN/VoWiFi, VPN)
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_XCBC=y

# ---- netd / tethering / connectivity (iptables legacy matches+targets, conntrack helpers, tc)
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_IFB=y
CONFIG_DUMMY=y
CONFIG_INET6_IPCOMP=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y

# ---- power / timers
CONFIG_PM_WAKELOCKS=y
CONFIG_NO_HZ=y

# ---- input (gamepads: built in where possible, cheap; Android lists them as required =y)
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=m   # =y impossible: depends on LEDS_CLASS_MULTICOLOR, which stays =m (staged led-class-multicolor.ko, dualux)
CONFIG_PLAYSTATION_FF=y
CONFIG_JOYSTICK_XPAD=y

# ---- hardening / misc required by android-base (+ arm64 conditional group)
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
CONFIG_KFENCE=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_EXPERT=y
CONFIG_STAGING=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# android-base: must NOT be set
# CONFIG_FHANDLE is not set
# CONFIG_SYSVIPC is not set
# CONFIG_FW_CACHE is not set

# ---- NOT AVAILABLE in mainline 7.2 (Android Common Kernel only / removed upstream) -> replacement
# CONFIG_NETFILTER_XT_MATCH_QUOTA2(_LOG): ACK-only. Lineage 24 netd BandwidthController still emits `-m quota2` for data
#   alerts / global + per-iface quotas (system/netd/server/BandwidthController.cpp:59,341,448). Per-UID accounting and
#   data-saver use BPF (CONFIG_BPF_SYSCALL/CGROUP_BPF/NETFILTER_XT_MATCH_BPF=y, present). Without quota2 those iptables
#   commands fail -> data-limit/warning alerts unavailable. Replacement: port ACK net/netfilter/xt_quota2.c as an A6L
#   out-of-tree xt module (TODO, source not on this machine).
# CONFIG_DM_DEFAULT_KEY: ACK-only -> no metadata encryption; FBE (fscrypt v2, fstab.qcom.fbe) works without it.
#   Replacement: port ACK drivers/md/dm-default-key.c (TODO) before enabling metadata_encryption=.
# CONFIG_ASHMEM: removed upstream (6.x staging drop) -> libcutils uses memfd (ashmem-dev.cpp use_memfd()); nothing to do.
# CONFIG_CPU_FREQ_TIMES / CONFIG_UID_SYS_STATS: ACK-only -> BPF time_in_state (needs bpfloader progs) / storaged
#   /proc/uid_io/stats missing = per-UID IO stats absent (battery/storage stats degraded, not fatal).
# CONFIG_NF_CT_PROTO_DCCP / CONFIG_NF_CT_PROTO_UDPLITE: removed upstream (UDPLITE folded into conntrack, DCCP removed).
# CONFIG_SCHED_DEBUG: removed upstream (debug always via debugfs).
# CONFIG_ARM64_PAN: removed upstream (PAN unconditional on ARMv8.1+; SDM660 A53/A73 = ARMv8.0 -> ARM64_SW_TTBR0_PAN below
#   would be the substitute; left OFF: it costs a TTBR switch per uaccess, revisit for release). CONFIG_CFI_CLANG = CONFIG_CFI=y (renamed).

# ---- DELIBERATE DEVIATIONS (documented, revisit for release)
# CONFIG_DEVMEM stays =y (android-base: not set): a6l_mmio (/vendor/a6l/tools, attended camera/display register dumps)
#   uses /dev/mem. Unset it in kernel/rom-v2/release.config.fragment for a `user` build.
# CONFIG_FUSE_FS, CONFIG_UHID, CONFIG_SND, CONFIG_SOUND stay =m (android-base: =y): loaded by the ROM's own module groups
#   (rom/modules/base.txt: fuse, uhid; audio.txt: soundcore, snd, ...) before their users start; turning them =y would
#   change the module lists of the proven ROM for no functional gain.
