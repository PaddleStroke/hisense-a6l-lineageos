+/*
+ * A6L audio-20261010 (r2): "TFA Attenuation" (0..TFA98XX_ATT_MAX, 0.5 dB units) is added on top of the profile/vstep volume
+ * through the CoolFlux firmware volume bitfield VOL (reg 0x51 bits 15:8: 0x00 = 0 dB, 0.5 dB per step, 0xff = mute; the
+ * field the vstep files set, tfaContWriteVstep -> tfa98xx_set_volume_level). The A6L container has a single vstep per
+ * profile, so the "<profile> Playback Volume" controls have the range 0..0 and the speaker has no other gain stage.
+ * a6l-audio-route uses it only for the in-call (downlink) volume on the speakerphone; every other path keeps 0.
+ * r2 (live test 10 Oct: speaker silent after the live module swap): while the attenuation is 0 and was never applied, this
+ * code performs NO register access at all (r1 read VOL after every start), so at 0 the module drives the chip exactly as
+ * 0002 does. The VOL base (the vstep value) is read only when a non-zero attenuation is applied, and restored when the
+ * attenuation returns to 0. tfa_dev_start() rewrites VOL from the vstep file on a cold start, so a running attenuation is
+ * re-applied after every start.
+ */
+#define TFA98XX_ATT_MAX 120
+static int tfa98xx_att;		/* requested attenuation (0.5 dB units), protected by tfa98xx_mutex for writers */
+
+/* dsp_lock held. Applies the requested attenuation to a running amplifier; no-op when stopped or nothing to do. */
+static void tfa98xx_att_apply(struct tfa98xx *tfa98xx, const char *why)
+{
+	int att = READ_ONCE(tfa98xx_att);
+	int vol, err;
+
+	if (!tfa98xx->att_running)
+		return;
+	if (att == 0 && tfa98xx->att_written < 0)
+		return;			/* nothing of ours in the chip: leave VOL alone */
+	if (tfa98xx->att_base < 0) {
+		int base = TFA_GET_BF(tfa98xx->tfa, VOL);
+
+		if (base < 0) {
+			dev_err(&tfa98xx->i2c->dev, "A6L_TFA attenuation %d (%s): cannot read VOL (%d)\n", att, why, base);
+			return;
+		}
+		tfa98xx->att_base = base;
+	}
+	vol = min(tfa98xx->att_base + att, 254);
+	err = TFA_SET_BF(tfa98xx->tfa, VOL, (uint16_t)vol);
+	if (err) {
+		dev_err(&tfa98xx->i2c->dev, "A6L_TFA attenuation %d (VOL 0x%02x, %s): error %d\n", att, vol, why, err);
+		return;
+	}
+	tfa98xx->att_written = att ? vol : -1;	/* back at the base: nothing of ours left */
+	dev_info(&tfa98xx->i2c->dev, "A6L_TFA attenuation -%d.%d dB (VOL 0x%02x = base 0x%02x + %d, %s)\n",
+		 att / 2, (att & 1) * 5, vol, tfa98xx->att_base, att, why);
+}
+
+/* dsp_lock held: the amplifier was stopped (VOL keeps whatever it holds; att_written remembers our value) */
+static void tfa98xx_att_stopped(struct tfa98xx *tfa98xx)
+{
+	tfa98xx->att_running = 0;
+}
+
+/* dsp_lock held: tfa_dev_start() succeeded */
+static void tfa98xx_att_started(struct tfa98xx *tfa98xx)
+{
+	tfa98xx->att_running = 1;
+	if (tfa98xx->att_written < 0) {
+		/* VOL holds the vstep value of this start; read only if an attenuation is requested */
+		tfa98xx->att_base = -1;
+		if (READ_ONCE(tfa98xx_att))
+			tfa98xx_att_apply(tfa98xx, "start");
+		return;
+	}
+	/* our value was in the chip before this start: a cold start rewrote VOL (new base), a warm one kept ours */
+	{
+		int cur = TFA_GET_BF(tfa98xx->tfa, VOL);
+
+		if (cur >= 0 && cur != tfa98xx->att_written)
+			tfa98xx->att_base = cur;
+	}
+	tfa98xx_att_apply(tfa98xx, "start");
+}
