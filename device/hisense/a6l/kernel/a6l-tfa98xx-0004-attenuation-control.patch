+/* A6L audio-20261010: "TFA Attenuation" control (see tfa98xx_att_apply) */
+static int tfa98xx_info_att_ctl(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = TFA98XX_ATT_MAX;
+	return 0;
+}
+
+static int tfa98xx_get_att_ctl(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = READ_ONCE(tfa98xx_att);
+	return 0;
+}
+
+static int tfa98xx_set_att_ctl(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct tfa98xx *tfa98xx;
+	long v = ucontrol->value.integer.value[0];
+
+	if (v < 0 || v > TFA98XX_ATT_MAX)
+		return -EINVAL;
+	mutex_lock(&tfa98xx_mutex);
+	if (v == tfa98xx_att) {
+		mutex_unlock(&tfa98xx_mutex);
+		return 0;
+	}
+	WRITE_ONCE(tfa98xx_att, (int)v);
+	list_for_each_entry(tfa98xx, &tfa98xx_device_list, list) {
+		mutex_lock(&tfa98xx->dsp_lock);
+		tfa98xx_att_apply(tfa98xx, "live");	/* no-op while the amplifier is stopped */
+		mutex_unlock(&tfa98xx->dsp_lock);
+	}
+	mutex_unlock(&tfa98xx_mutex);
+	return 1;
+}
