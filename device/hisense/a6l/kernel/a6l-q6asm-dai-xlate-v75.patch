@@ -1217,6 +1217,32 @@
 	SND_SOC_DAPM_AIF_OUT("MM_UL8", "MultiMedia8 Capture", 0, SND_SOC_NOPM, 0, 0),
 };
 
+/*
+ * A6L (audio3, 24 Sep 2026): resolve <&q6asmdai N> by the DAI id (= the child's "reg" = MSM_FRONTEND_DAI_MULTIMEDIA<N+1>)
+ * instead of by the position of the child node. Without this, the generic snd_soc_get_dlc() fallback picks the N-th DAI in
+ * DT child order, and fdtoverlay (which prepends new child nodes) turns "dai@0, dai@1" into "dai@1, dai@0": the
+ * "MultiMedia1" dai-link (pcmC0D0) then got the MultiMedia2 DAI (MM_DL2/MM_UL2) and vice versa, which looked like an
+ * inverted DPCM direction (23 Sep audio2 diag). With in-order DT children this returns exactly what the fallback returned.
+ */
+static int q6asm_dai_of_xlate_dai_name(struct snd_soc_component *component,
+				       const struct of_phandle_args *args,
+				       const char **dai_name)
+{
+	struct snd_soc_dai *dai;
+
+	if (args->args_count != 1)
+		return -EINVAL;
+
+	for_each_component_dais(component, dai) {
+		if (dai->driver->name && dai->driver->id == args->args[0]) {
+			*dai_name = dai->driver->name;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
 static const struct snd_soc_component_driver q6asm_fe_dai_component = {
 	.name			= DRV_NAME,
 	.open			= q6asm_dai_open,
@@ -1231,6 +1257,7 @@
 	.dapm_widgets		= q6asm_dapm_widgets,
 	.num_dapm_widgets	= ARRAY_SIZE(q6asm_dapm_widgets),
 	.legacy_dai_naming	= 1,
+	.of_xlate_dai_name	= q6asm_dai_of_xlate_dai_name,
 };
 
