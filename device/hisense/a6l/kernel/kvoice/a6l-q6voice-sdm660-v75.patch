+/* A6L: CVD version query (downstream voice.c voice_send_mvm_cvd_version_cmd) */
+#define VSS_IVERSION_CMD_GET				0x00011378
+#define VSS_IVERSION_RSP_GET				0x00011379
+#define Q6MVM_VERSION_PORT				0x3f	/* outside Q6VOICE_PATH_* */
+#define Q6MVM_VERSION_TIMEOUT_MS			300
+
+static struct apr_device *q6mvm_adev;
+static DEFINE_MUTEX(q6mvm_version_lock);
+static DECLARE_WAIT_QUEUE_HEAD(q6mvm_version_wait);
+static char q6mvm_version[24];
+static int q6mvm_version_state;	/* 0 pending, 1 ok, <0 error */
+
 #define VSS_IMVM_CMD_START_VOICE			0x00011190
 #define VSS_IMVM_CMD_STOP_VOICE				0x00011192
 
@@ -136,6 +148,76 @@
 }
 EXPORT_SYMBOL_GPL(q6mvm_start);
 
+int q6mvm_get_cvd_version(char *buf, size_t len)
+{
+	struct apr_pkt cmd = {};
+	int ret;
+
+	if (!q6mvm_adev)
+		return -ENODEV;
+
+	mutex_lock(&q6mvm_version_lock);
+	if (q6mvm_version_state == 1)
+		goto done;
+
+	q6mvm_version_state = 0;
+	cmd.hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					  APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.src_port = Q6MVM_VERSION_PORT;
+	cmd.hdr.dest_port = 0;
+	cmd.hdr.token = 0;
+	cmd.hdr.opcode = VSS_IVERSION_CMD_GET;
+
+	ret = apr_send_pkt(q6mvm_adev, &cmd);
+	if (ret < 0)
+		goto out;
+
+	ret = wait_event_timeout(q6mvm_version_wait, q6mvm_version_state != 0,
+				 msecs_to_jiffies(Q6MVM_VERSION_TIMEOUT_MS));
+	if (!ret) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	if (q6mvm_version_state < 0) {
+		ret = q6mvm_version_state;
+		goto out;
+	}
+done:
+	strscpy(buf, q6mvm_version, len);
+	ret = 0;
+out:
+	mutex_unlock(&q6mvm_version_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6mvm_get_cvd_version);
+
+static int q6mvm_callback(struct apr_device *adev, const struct apr_resp_pkt *data)
+{
+	if (data->hdr.opcode == VSS_IVERSION_RSP_GET) {
+		size_t n = min_t(size_t, data->payload_size, sizeof(q6mvm_version) - 1);
+
+		memcpy(q6mvm_version, data->payload, n);
+		q6mvm_version[n] = '\0';
+		q6mvm_version_state = 1;
+		wake_up(&q6mvm_version_wait);
+		return 0;
+	}
+
+	if (data->hdr.opcode == APR_BASIC_RSP_RESULT &&
+	    data->hdr.dest_port == Q6MVM_VERSION_PORT) {
+		const struct aprv2_ibasic_rsp_result_t *r = data->payload;
+
+		dev_warn(&adev->dev, "A6L_Q6VOICE version query status %#x\n",
+			 r ? r->status : 0);
+		q6mvm_version_state = -EIO;
+		wake_up(&q6mvm_version_wait);
+		return 0;
+	}
+
+	return q6voice_common_callback(adev, data);
+}
