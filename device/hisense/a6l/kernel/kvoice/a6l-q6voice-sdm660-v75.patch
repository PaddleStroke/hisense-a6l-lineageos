+static void q6voice_resolve_cvd(struct q6voice *v)
+{
+	char ver[24] = "";
+	int mode = cvd_mode >= 0 ? cvd_mode : v->cvd_mode;
+	int ret, maj = 0, min = 0;
+
+	if (v->cvd_resolved && cvd_mode < 0)
+		return;
+
+	if (mode == Q6VOICE_CVD_AUTO) {
+		ret = q6mvm_get_cvd_version(ver, sizeof(ver));
+		if (!ret && sscanf(ver, "%d.%d", &maj, &min) == 2)
+			mode = (maj > 2 || (maj == 2 && min >= 3)) ?
+				Q6VOICE_CVD_V2_3 : Q6VOICE_CVD_LEGACY;
+		else
+			mode = Q6VOICE_CVD_LEGACY;
+		dev_info(v->dev, "A6L_Q6VOICE cvd version query ret=%d ver='%s'\n",
+			 ret, ver);
+	}
+
+	v->cvd_v2_3 = (mode == Q6VOICE_CVD_V2_3);
+	v->cvd_resolved = true;
+	dev_info(v->dev, "A6L_Q6VOICE using %s init sequence\n",
+		 v->cvd_v2_3 ? "CVD 2.3" : "legacy (CVD <= 2.2)");
+}
