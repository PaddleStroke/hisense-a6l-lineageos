A6L r5 review fix F6 (28 Sep 2026): uplink (TX) mute of the q6voice VoiceMMode1 path.
VSS_IVOLUME_CMD_MUTE_V2 (0x0001138B, TX=0) on the full-control CVP session, ALSA control "VoiceMMode1 TX Mute"
(put returns the DSP error), state kept per path and restored (fail closed) at every path start.
Applies after a6l-q6voice-full-7.2.3.patch (series kernel/rom-v2/series). Built W=1 against out-a6l-phone-v67.

diff --git a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
index d87849b..2f01fc3 100644
--- a/sound/soc/qcom/qdsp6/q6cvp.c
+++ b/sound/soc/qcom/qdsp6/q6cvp.c
@@ -45,6 +45,17 @@
 
 #define VOC_SET_MEDIA_FORMAT_PARAM_TOKEN		2
 
+/*
+ * A6L r5 (F6 call mute): device mute on the vocproc. Downstream msm voice.c voice_send_device_mute_cmd() sends
+ * VSS_IVOLUME_CMD_MUTE_V2 to the CVP handle ("Voice Tx Device Mute"); stock "Voice Tx Mute" uses the same command on
+ * a CVS passive session, which this driver does not create (the modem owns the stream). Muting the vocproc TX output
+ * silences the uplink before the modem's encoder. Note: VSS_IVOLUME directions are TX = 0, RX = 1 (not the
+ * VSS_IVOCPROC_DIRECTION_* values above).
+ */
+#define VSS_IVOLUME_CMD_MUTE_V2				0x0001138B
+#define VSS_IVOLUME_DIRECTION_TX			0
+#define VSS_IVOLUME_DIRECTION_RX			1
+
 #define VSS_NUM_CHANNELS_MAX 8
 
 struct vss_ivocproc_cmd_create_full_control_session_v2_cmd {
@@ -164,6 +175,13 @@ struct vss_icommon_cmd_set_param_v2_cmd {
 	struct vss_icommon_param_data param_data;
 } __packed;
 
+struct vss_ivolume_cmd_mute_v2_cmd {
+	struct apr_hdr hdr;
+	u16 direction;
+	u16 mute_flag;
+	u16 ramp_duration_ms;
+} __packed;
+
 struct q6voice_session *q6cvp_session_create(enum q6voice_path_type path,
 					     u16 tx_port, u16 rx_port,
 					     u32 tx_topo, u32 rx_topo)
@@ -303,6 +321,20 @@ int q6cvp_enable(struct q6voice_session *cvp, bool state)
 }
 EXPORT_SYMBOL_GPL(q6cvp_enable);
 
+int q6cvp_set_mute(struct q6voice_session *cvp, bool tx, bool mute, u16 ramp_ms)
+{
+	struct vss_ivolume_cmd_mute_v2_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOLUME_CMD_MUTE_V2;
+	cmd.direction = tx ? VSS_IVOLUME_DIRECTION_TX : VSS_IVOLUME_DIRECTION_RX;
+	cmd.mute_flag = mute ? 1 : 0;
+	cmd.ramp_duration_ms = ramp_ms;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_mute);
+
 static int q6cvp_probe(struct apr_device *adev)
 {
 	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVP);
