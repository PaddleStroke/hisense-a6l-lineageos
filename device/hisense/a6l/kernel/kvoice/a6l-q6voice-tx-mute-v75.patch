diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index c5c60a7..0d099bf 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -228,7 +228,44 @@ static int q6voice_put_topology_kctrl(struct snd_kcontrol *kcontrol, struct snd_
 	return 1;
 }
 
+/* A6L r5 (F6): "VoiceMMode1 TX Mute" (0/1). A failed DSP command is returned to userspace (-EIO/-ETIMEDOUT). */
+static int q6voice_get_tx_mute_kctrl(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	ucontrol->value.integer.value[0] = q6voice_get_tx_mute(v, path);
+	return 0;
+}
+
+static int q6voice_put_tx_mute_kctrl(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+	bool mute = !!ucontrol->value.integer.value[0];
+	bool was;
+	int ret;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	was = q6voice_get_tx_mute(v, path);
+	ret = q6voice_set_tx_mute(v, path, mute);
+	if (ret)
+		return ret;
+	return was != mute;
+}
+
 static const struct snd_kcontrol_new q6voice_kcontrols[] = {
+	SOC_SINGLE_EXT("VoiceMMode1 TX Mute", VOICEMMODE1, 0, 1, 0,
+		       q6voice_get_tx_mute_kctrl, q6voice_put_tx_mute_kctrl),
 	SOC_SINGLE_EXT("VoiceMMode1 TX Topology", VOICEMMODE1, 1, S32_MAX, 0,
 		       q6voice_get_topology_kctrl, q6voice_put_topology_kctrl),
 	SOC_SINGLE_EXT("VoiceMMode1 RX Topology", VOICEMMODE1, 0, S32_MAX, 0,
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index 1b8ee0f..4a2510b 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -36,6 +36,8 @@ struct q6voice_path {
 	enum q6voice_path_type type;
 	int tx_port, rx_port;
 	u32 tx_topo, rx_topo;
+	/* A6L r5 (F6): uplink mute requested by userspace; kept across calls, applied at every start */
+	bool tx_mute;
 	/* Serialize access to voice path session */
 	struct mutex lock;
 	struct q6voice_path_runtime *runtime;
@@ -147,6 +149,17 @@ static int q6voice_path_start(struct q6voice_path *p)
 		goto cvp_err;
 	}
 
+	/*
+	 * A6L r5 (F6): restore the uplink mute before the vocproc joins the modem's stream. Fail closed: a call that
+	 * was muted must never start with a live microphone (userspace sees the start error and can unmute).
+	 */
+	if (p->tx_mute) {
+		ret = q6cvp_set_mute(cvp, true, true, 0);
+		dev_info(dev, "A6L_Q6VOICE path %d tx mute restore: %d\n", p->type, ret);
+		if (ret)
+			goto cvp_err;
+	}
+
 	ret = q6mvm_attach(mvm, cvp, true);
 	if (ret) {
 		dev_err(dev, "failed to attach cvp to mvm: %d\n", ret);
@@ -267,6 +280,46 @@ out:
 }
 EXPORT_SYMBOL_GPL(q6voice_stop);
 
+/*
+ * A6L r5 (F6): uplink mute. While the path runs, the vocproc is muted/unmuted at once (500 ms ramp like stock
+ * "Voice Tx Mute") and the new state is only stored when the DSP accepted it; otherwise it is stored and applied
+ * by the next q6voice_path_start().
+ */
+int q6voice_set_tx_mute(struct q6voice *v, enum q6voice_path_type path, bool mute)
+{
+	struct q6voice_path *p;
+	struct q6voice_session *cvp;
+	int ret = 0;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	p = &v->paths[path];
+	mutex_lock(&p->lock);
+	if (p->runtime && p->runtime->started == 3) {
+		cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+		ret = cvp ? q6cvp_set_mute(cvp, true, mute, 500) : -ENODEV;
+		dev_info(v->dev, "A6L_Q6VOICE path %d tx mute %d (live): %d\n", path, mute, ret);
+	}
+	if (!ret)
+		p->tx_mute = mute;
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_tx_mute);
+
+bool q6voice_get_tx_mute(struct q6voice *v, enum q6voice_path_type path)
+{
+	bool mute;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return false;
+	mutex_lock(&v->paths[path].lock);
+	mute = v->paths[path].tx_mute;
+	mutex_unlock(&v->paths[path].lock);
+	return mute;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_tx_mute);
+
 static void q6voice_free(void *data)
 {
 	struct q6voice *v = data;
