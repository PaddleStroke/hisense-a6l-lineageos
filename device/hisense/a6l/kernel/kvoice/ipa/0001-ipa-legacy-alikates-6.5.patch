+static bool ipa_endpoint_aggr_active(struct ipa_endpoint *endpoint)
+{
+	/*
+	u32 endpoint_id = endpoint->endpoint_id;
+	struct ipa *ipa = endpoint->ipa;
+	u32 unit = endpoint_id / 32;
+	const struct reg *reg;
+	u32 val;
+	*/
+
