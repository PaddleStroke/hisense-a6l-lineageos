+#
+# Makefile for the Qualcomm IPA driver.
+
+IPA_VERSIONS		:=	2.0 2.5 2.6l
+
+obj-$(CONFIG_QCOM_IPA_LEGACY)	+=	ipa.o
+
+ipa-y			:=	ipa_main.o ipa_power.o ipa_reg.o ipa_mem.o \
