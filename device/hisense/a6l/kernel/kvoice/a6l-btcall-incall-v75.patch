+/*
+ * A6L btcall: request in-call record of the downlink (@rx: AFE 0x8003) and/or uplink (@tx: AFE 0x8004), or in-call
+ * music (AFE 0x8005), for @path. Called by the pseudo-port back ends (q6voice-dai incall DAIs) at prepare/shutdown.
+ * While a call runs the CVS is updated at once; otherwise at the next call start. Returns the DSP result while a
+ * call runs (the request is kept either way), else 0.
+ */
+int q6voice_set_incall_record(struct q6voice *v, enum q6voice_path_type path, bool tx, bool enable)
+{
+	struct q6voice_path *p;
+	int ret = 0;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	p = &v->paths[path];
+	mutex_lock(&p->lock);
+	if (tx)
+		p->rec_tx = enable;
+	else
+		p->rec_rx = enable;
+	dev_info(v->dev, "A6L_Q6VOICE path %d incall record request rx=%d tx=%d (call %s)\n", path,
+		 p->rec_rx, p->rec_tx, p->runtime && p->runtime->started == 3 ? "running" : "idle");
+	if (p->runtime && p->runtime->started == 3)
+		ret = q6voice_path_sync_cvs(p);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_incall_record);
+
+int q6voice_set_incall_music(struct q6voice *v, enum q6voice_path_type path, bool enable)
