+	p->play = enable;
+	dev_info(v->dev, "A6L_Q6VOICE path %d incall music request %d (call %s)\n", path, enable,
+		 p->runtime && p->runtime->started == 3 ? "running" : "idle");
+	if (p->runtime && p->runtime->started == 3)
+		ret = q6voice_path_sync_cvs(p);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_incall_music);
