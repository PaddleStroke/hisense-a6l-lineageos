+ * it (msm-4.4 voc_start_record()/voc_start_playback() on route set, voice_setup_vocproc() at call start). A DSP
+ * error while a call runs is logged by q6voice and not returned: the capture/playback PCM stays usable (silence).
+ */
+static int q6voice_incall_set(struct snd_soc_dai *dai, bool enable)
+{
+	struct q6voice *v = snd_soc_dai_get_drvdata(dai);
+	enum q6voice_path_type path = q6voice_get_path(dai->driver->id);
+
+	if (path == Q6VOICE_PATH_COUNT)
