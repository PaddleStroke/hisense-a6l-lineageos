diff --git a/sound/soc/qcom/qdsp6/q6cvs.c b/sound/soc/qcom/qdsp6/q6cvs.c
index 4407158..3967844 100644
--- a/sound/soc/qcom/qdsp6/q6cvs.c
+++ b/sound/soc/qcom/qdsp6/q6cvs.c
@@ -4,10 +4,126 @@
 
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/string.h>
 #include <linux/soc/qcom/apr.h>
 #include "q6cvs.h"
+#include "q6mvm.h"
 #include "q6voice-common.h"
 
+/*
+ * A6L btcall (29 Sep 2026): CVS passive control session + in-call record / in-call music, ported from msm-4.4
+ * voice.c (voice_create_mvm_cvs_session() passive branch, voice_cvs_start_record(), voice_cvs_stop_record(),
+ * voice_cvs_start_playback(), voice_cvs_stop_playback()) and q6voice.h (opcodes, payloads). The modem owns the
+ * stream (dual control); the ADSP taps it at the stream end (record) or mixes the pseudo port into the uplink
+ * (playback). The AFE pseudo ports themselves are started by q6afe-dai (INCALL_RECORD_RX/TX, VOICE_PLAYBACK_TX).
+ */
+#define VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION	0x00011140
+
+#define VSS_IRECORD_CMD_START				0x000112BE
+#define VSS_IRECORD_CMD_STOP				0x00011237
+#define VSS_IRECORD_PORT_ID_DEFAULT			0x0000FFFF
+#define VSS_IRECORD_TAP_POINT_NONE			0x00010F78
+#define VSS_IRECORD_TAP_POINT_STREAM_END		0x00010F79
+#define VSS_IRECORD_MODE_TX_RX_STEREO			0x00010F7A
+
+#define VSS_IPLAYBACK_CMD_START				0x000112BD
+#define VSS_IPLAYBACK_CMD_STOP				0x00011239
+
+struct vss_istream_cmd_create_passive_control_session_cmd {
+	struct apr_hdr hdr;
+
+	/* A variable-sized stream name (SESSION_NAME_LEN in msm-4.4). */
+	char name[20];
+} __packed;
+
+struct vss_irecord_cmd_start_cmd {
+	struct apr_hdr hdr;
+
+	u32 rx_tap_point;
+	u32 tx_tap_point;
+	/* VSS_IRECORD_PORT_ID_DEFAULT: Rx -> AFE 0x8003, Tx -> AFE 0x8004 (mode is then ignored) */
+	u16 port_id;
+	u32 mode;
+} __packed;
+
+struct vss_iplayback_cmd_start_cmd {
+	struct apr_hdr hdr;
+
+	/* AFE port the samples come from (0x8005 = VOICE_PLAYBACK_TX) */
+	u16 port_id;
+} __packed;
+
+struct q6voice_session *q6cvs_session_create(enum q6voice_path_type path)
+{
+	struct vss_istream_cmd_create_passive_control_session_cmd cmd;
+	int ret;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION;
+
+	memset(cmd.name, 0, sizeof(cmd.name));
+	ret = q6mvm_get_session_name(path, cmd.name, sizeof(cmd.name));
+	if (ret)
+		return ERR_PTR(ret);
+	pr_info("A6L_Q6VOICE cvs passive session '%s' (path %d)\n", cmd.name, path);
+
+	return q6voice_session_create(Q6VOICE_SERVICE_CVS, path, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_session_create);
+
+int q6cvs_start_record(struct q6voice_session *cvs, bool rx, bool tx)
+{
+	struct vss_irecord_cmd_start_cmd cmd;
+
+	if (!rx && !tx)
+		return -EINVAL;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IRECORD_CMD_START;
+
+	cmd.rx_tap_point = rx ? VSS_IRECORD_TAP_POINT_STREAM_END : VSS_IRECORD_TAP_POINT_NONE;
+	cmd.tx_tap_point = tx ? VSS_IRECORD_TAP_POINT_STREAM_END : VSS_IRECORD_TAP_POINT_NONE;
+	cmd.port_id = VSS_IRECORD_PORT_ID_DEFAULT;
+	cmd.mode = VSS_IRECORD_MODE_TX_RX_STEREO;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_start_record);
+
+int q6cvs_stop_record(struct q6voice_session *cvs)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = VSS_IRECORD_CMD_STOP;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_stop_record);
+
+int q6cvs_start_playback(struct q6voice_session *cvs, u16 afe_port_id)
+{
+	struct vss_iplayback_cmd_start_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IPLAYBACK_CMD_START;
+	cmd.port_id = afe_port_id;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_start_playback);
+
+int q6cvs_stop_playback(struct q6voice_session *cvs)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = VSS_IPLAYBACK_CMD_STOP;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_stop_playback);
+
 static int q6cvs_probe(struct apr_device *adev)
 {
 	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVS);
