+#define Q6VOICE_AFE_PORT_ID_VOICE_PLAYBACK_TX	0x8005	/* VSS_IPLAYBACK_PORT_ID_VOICE */
+
+/*
+ * A6L btcall: bring the CVS record/playback state in line with the request while the path runs (p->lock held,
+ * started == 3). The CVS passive session is created on first use and released with the path. A record mode
+ * change is stop + start (msm-4.4 voc_start_record()). Errors are logged and returned; the request stays so a
+ * later start retries.
+ */
+static int q6voice_path_sync_cvs(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+	bool want_rec = p->rec_rx || p->rec_tx;
+	int ret = 0, r;
+
+	if (!cvs && !want_rec && !p->play)
+		return 0;
+	if (!cvs) {
+		cvs = q6cvs_session_create(p->type);
+		if (IS_ERR(cvs)) {
+			dev_err(dev, "A6L_Q6VOICE path %d cvs session: %ld\n", p->type, PTR_ERR(cvs));
+			return PTR_ERR(cvs);
+		}
+		p->runtime->sessions[Q6VOICE_SERVICE_CVS] = cvs;
+	}
+
+	if (p->rec_on && (!want_rec || p->rec_on_rx != p->rec_rx || p->rec_on_tx != p->rec_tx)) {
+		r = q6cvs_stop_record(cvs);
+		dev_info(dev, "A6L_Q6VOICE path %d incall record stop: %d\n", p->type, r);
+		p->rec_on = false;	/* the DSP forgets it on error/timeout paths too; a later start resends */
+		if (r)
+			ret = r;
+	}
+	if (want_rec && !p->rec_on) {
+		r = q6cvs_start_record(cvs, p->rec_rx, p->rec_tx);
+		dev_info(dev, "A6L_Q6VOICE path %d incall record start rx=%d tx=%d: %d\n",
+			 p->type, p->rec_rx, p->rec_tx, r);
+		if (!r) {
+			p->rec_on = true;
+			p->rec_on_rx = p->rec_rx;
+			p->rec_on_tx = p->rec_tx;
+		} else {
+			ret = r;
+		}
+	}
+
+	if (p->play_on && !p->play) {
+		r = q6cvs_stop_playback(cvs);
+		dev_info(dev, "A6L_Q6VOICE path %d incall music stop: %d\n", p->type, r);
+		p->play_on = false;
+		if (r)
+			ret = r;
+	} else if (!p->play_on && p->play) {
+		r = q6cvs_start_playback(cvs, Q6VOICE_AFE_PORT_ID_VOICE_PLAYBACK_TX);
+		dev_info(dev, "A6L_Q6VOICE path %d incall music start: %d\n", p->type, r);
+		if (!r)
+			p->play_on = true;
+		else
+			ret = r;
+	}
+
+	return ret;
+}
+
+/* A6L btcall: stop record/playback before the voice stops (msm-4.4 voice_destroy_vocproc()); requests stay */
+static void q6voice_path_stop_cvs(struct q6voice_path *p)
+{
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+	if (!cvs)
+		return;
+	if (p->play_on)
+		q6cvs_stop_playback(cvs);
+	if (p->rec_on)
+		q6cvs_stop_record(cvs);
+	p->play_on = false;
+	p->rec_on = false;
+}
