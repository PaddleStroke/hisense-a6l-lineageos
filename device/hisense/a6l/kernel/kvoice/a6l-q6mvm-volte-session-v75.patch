+/*
+ * A6L volte3 (26 Sep 2026): MVM passive session override for the VoiceMMode1 path.
+ * The MVM passive session name selects which modem voice stream the ADSP session joins
+ * (downstream msm-4.4 voice.c: CS "default modem voice", VoLTE "default volte voice",
+ * the others by their VSID string, e.g. VoiceMMode1 "11C05000"). The CS call proven on
+ * 24 Sep used "11C05000". The modem reports its VSIDs in NAS Get Subscription Info
+ * (0x007C: CS 0x13, LTE 0x14, WLAN 0x15; `a6l-qmi ims-status`). If the LTE (VoLTE) VSID
+ * differs from the CS one, the VoLTE call needs the other session name; this parameter
+ * selects it without a new DAI/DT: read at every MVM session create (once per call),
+ * writable at run time (0644).
+ *   ""/"default": path default; "cs"/"voice": "default modem voice";
+ *   "volte": "default volte voice"; "mmode1": "11C05000"; "mmode2": "11DC5000";
+ *   8 hex digits (e.g. "10C02000"): that VSID string.
+ */
+static char mmode1_session[24];
+module_param_string(mmode1_session, mmode1_session, sizeof(mmode1_session), 0644);
+MODULE_PARM_DESC(mmode1_session,
+		 "VoiceMMode1 MVM session: default|cs|volte|mmode1|mmode2|<8 hex VSID>");
+
+static const char *q6mvm_mmode1_name(const char *def, char *buf, size_t len)
+{
+	char v[sizeof(mmode1_session)];
+	char *s;
+	int i;
+
+	kernel_param_lock(THIS_MODULE);
+	strscpy(v, mmode1_session, sizeof(v));
+	kernel_param_unlock(THIS_MODULE);
+	s = strim(v);
+
+	if (!*s || !strcasecmp(s, "default"))
+		return def;
+	if (!strcasecmp(s, "cs") || !strcasecmp(s, "voice"))
+		return "default modem voice";
+	if (!strcasecmp(s, "volte"))
+		return "default volte voice";
+	if (!strcasecmp(s, "mmode1"))
+		return "11C05000";
+	if (!strcasecmp(s, "mmode2"))
+		return "11DC5000";
+	if (strlen(s) == 8) {
+		for (i = 0; i < 8 && isxdigit(s[i]); i++)
+			;
+		if (i == 8 && len > 8) {
+			for (i = 0; i < 8; i++)
+				buf[i] = toupper(s[i]);
+			buf[8] = '\0';
+			return buf;
+		}
+	}
+	pr_warn("A6L_Q6VOICE mmode1_session '%s' not understood, using '%s'\n", s, def);
+	return def;
+}
