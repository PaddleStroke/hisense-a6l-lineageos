+/*
+ * A6L r5 (F37): downlink (RX) volume step. While the path runs it is applied at once (20 ms ramp, stock
+ * DEFAULT_VOLUME_RAMP_DURATION_MS) and only stored when the DSP accepted it; otherwise it is stored and applied by the
+ * next q6voice_path_start().
+ */
+int q6voice_set_rx_vol_step(struct q6voice *v, enum q6voice_path_type path, int step)
+{
+	struct q6voice_path *p;
+	struct q6voice_session *cvp;
+	int ret = 0;
+
+	if (path >= Q6VOICE_PATH_COUNT || step < 0 || step > Q6VOICE_RX_VOL_STEP_MAX)
+		return -EINVAL;
+	p = &v->paths[path];
+	mutex_lock(&p->lock);
+	if (p->runtime && p->runtime->started == 3) {
+		cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+		ret = cvp ? q6cvp_set_rx_vol_step(cvp, step, 20) : -ENODEV;
+		dev_info(v->dev, "A6L_Q6VOICE path %d rx volume step %d (live): %d\n", path, step, ret);
+	}
+	if (!ret)
+		p->rx_vol_step = step;
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_rx_vol_step);
+
+int q6voice_get_rx_vol_step(struct q6voice *v, enum q6voice_path_type path)
+{
+	int step;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -1;
+	mutex_lock(&v->paths[path].lock);
+	step = v->paths[path].rx_vol_step;
+	mutex_unlock(&v->paths[path].lock);
+	return step;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_rx_vol_step);
+
