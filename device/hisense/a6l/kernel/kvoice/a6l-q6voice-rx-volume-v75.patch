+/*
+ * A6L r5 (F37): "VoiceMMode1 RX Volume Step" (0..15; the in-call volume of the downlink, VSS_IVOLUME_CMD_SET_STEP on the
+ * vocproc). Reads 0 until set. A failed DSP command is returned to userspace (-EIO/-ETIMEDOUT) and not stored.
+ */
+static int q6voice_get_rx_vol_kctrl(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+	int step;
+
+	if (path >= Q6VOICE_PATH_COUNT)
+		return -EINVAL;
+	step = q6voice_get_rx_vol_step(v, path);
+	ucontrol->value.integer.value[0] = step < 0 ? 0 : step;
+	return 0;
+}
+
+static int q6voice_put_rx_vol_kctrl(struct snd_kcontrol *kcontrol, struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_kcontrol_chip(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	enum q6voice_path_type path = q6voice_get_path(mc->reg);
+	long step = ucontrol->value.integer.value[0];
+	int was, ret;
+
+	if (path >= Q6VOICE_PATH_COUNT || step < 0 || step > Q6VOICE_RX_VOL_STEP_MAX)
+		return -EINVAL;
+	was = q6voice_get_rx_vol_step(v, path);
+	ret = q6voice_set_rx_vol_step(v, path, (int)step);
+	if (ret)
+		return ret;
+	return was != step;
+}
+
 static const struct snd_kcontrol_new q6voice_kcontrols[] = {
