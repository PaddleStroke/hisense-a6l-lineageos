# Standalone diagnostic kernel, not the Android production configuration.
CONFIG_LOCALVERSION="-a6l-probe"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_BLOCK_MINORS=64
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
# Also boot this exact kernel on QEMU virt to test the diagnostic PID 1.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# CONFIG_QCOM_RMTFS_MEM is not set
# CONFIG_QCOM_QSEECOM is not set
# CONFIG_MMC_CRYPTO is not set
