+extern int a6l_dbg;
+static u32 a6l_ispif_nirq;
+
+static void a6l_ispif_dump(struct ispif_device *ispif, const char *tag, u8 vfe)
+{
+	u32 o, w[8], nz;
+	unsigned int i;
+	/* camfix3: the VFE1 bank (0x400..) needs csi_vfe1/vfe1 clocks that are off when VFE1 is unused;
+	 * reading it reset the phone in run t25b. Dump only the global block and the bank of our VFE. */
+	u32 lo = 0x200 + 0x200 * (vfe & 1);
+
+	if (!a6l_dbg)
+		return;
+	dev_info(ispif->camss->dev, "A6L_ISPIF_%s irqs %u vfe%u power %d\n", tag, a6l_ispif_nirq, vfe, ispif->power_count);
+	if (ispif->power_count <= 0)
+		return;
+	for (o = 0; o < lo + 0x100; o += 32) {
+		if (o == 0x80)
+			o = lo;
+		nz = 0;
+		for (i = 0; i < 8; i++) {
+			w[i] = readl_relaxed(ispif->base + o + 4 * i);
+			nz |= w[i];
+		}
+		if (nz)
+			dev_info(ispif->camss->dev, "A6L_ISPIF_REG %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+				 o, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+	}
+	a6l_ispif_nirq = 0;
+}
