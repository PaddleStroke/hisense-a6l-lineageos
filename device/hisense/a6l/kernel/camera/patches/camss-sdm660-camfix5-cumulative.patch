diff -ru orig/camss/camss-vfe-4-8.c camss/camss-vfe-4-8.c
--- orig/camss/camss-vfe-4-8.c	2026-09-27 11:38:06.953229538 +0200
+++ camss/camss-vfe-4-8.c	2026-09-27 11:38:07.175305119 +0200
@@ -17,6 +17,163 @@
 #include "camss-vfe.h"
 #include "camss-vfe-gen1.h"
 
+#include <linux/moduleparam.h>
+#include <linux/ktime.h>
+extern int a6l_wm; /* camss-vfe-gen1.c */
+/* camfix5: fallback diagnostic = per-event (RDI0 SOF, WM done, bus error) VFE register lines */
+static uint a6l_fdump;
+module_param(a6l_fdump, uint, 0644);
+MODULE_PARM_DESC(a6l_fdump, "A6L: log VFE regs for the first N SOF/done/bus-error events of each stream (0 = off)");
+static uint a6l_fdump_wm;
+module_param(a6l_fdump_wm, uint, 0644);
+MODULE_PARM_DESC(a6l_fdump_wm, "A6L: write master whose register block a6l_fdump prints (default 0)");
+static uint a6l_ub;
+module_param(a6l_ub, uint, 0644);
+MODULE_PARM_DESC(a6l_ub, "A6L: UB depth for WM0 at offset 0 (0 = upstream 1/3 split; single RDI stream only)");
+static u32 a6l_f_sof[2], a6l_f_done[2], a6l_f_be[2], a6l_f_be_first[2], a6l_f_logged[2];
+static ktime_t a6l_f_t0[2];
+/* camfix4: stock msm_vfe47_update_ping_pong_addr writes WR_PING/PONG_MAX_ADDR = (addr + size) & ~0x1f */
+int a6l_wmmax = 1;
+module_param(a6l_wmmax, int, 0644);
+MODULE_PARM_DESC(a6l_wmmax, "A6L: 1 = program WM ping/pong MAX address (stock), 0 = leave 0 (upstream)");
+int a6l_cgc = 1;
+module_param(a6l_cgc, int, 0644);
+MODULE_PARM_DESC(a6l_cgc, "A6L: 1 = set VFE 0x3C CGC override bit per active WM (stock), 0 = upstream (none)");
+static u32 a6l_wm_sz[2][8];
+void a6l_wm_set_size(struct vfe_device *vfe, u8 wm, u32 size)
+{
+	if (wm < 8)
+		a6l_wm_sz[vfe->id & 1][wm] = size;
+}
+
+static u32 a6l_wm_max(struct vfe_device *vfe, u8 wm, u32 addr)
+{
+	u64 end;
+
+	if (!a6l_wmmax || !addr || wm >= 8 || !a6l_wm_sz[vfe->id & 1][wm])
+		return 0;
+	end = (u64)addr + a6l_wm_sz[vfe->id & 1][wm];
+	if (end > 0xffffffffULL)
+		end = 0xffffffffULL;
+	return (u32)end & ~0x1fU;
+}
+
+static void vfe_bus_reload_wm(struct vfe_device *vfe, u8 wm);
+int a6l_dbg = 1;
+module_param(a6l_dbg, int, 0644);
+MODULE_PARM_DESC(a6l_dbg, "A6L: 0 off, 1 first IRQs + stop dumps, 2 also periodic VFE IRQ lines");
+
+static u32 a6l_vfe_bits[2][64];
+static u32 a6l_vfe_nirq[2];
+
+static void a6l_vfe_count(struct vfe_device *vfe, u32 s0, u32 s1)
+{
+	unsigned int v = vfe->id & 1, b;
+	u32 n;
+
+	if (!a6l_dbg)
+		return;
+	n = ++a6l_vfe_nirq[v];
+	for (b = 0; b < 32; b++) {
+		if (s0 & BIT(b))
+			a6l_vfe_bits[v][b]++;
+		if (s1 & BIT(b))
+			a6l_vfe_bits[v][32 + b]++;
+	}
+	/* camfix5: per-frame accounting (RDI0 SOF = s1 bit29, WM ping-pong done = s0 bits 8..14, bus error = s1 bit4) */
+	if (n == 1 || !a6l_f_t0[v])
+		a6l_f_t0[v] = ktime_get();
+	if (s1 & BIT(29))
+		a6l_f_sof[v]++;
+	if (s0 & GENMASK(14, 8))
+		a6l_f_done[v]++;
+	if (s1 & BIT(4)) {
+		if (!a6l_f_be[v])
+			a6l_f_be_first[v] = a6l_f_sof[v];
+		a6l_f_be[v]++;
+	}
+	if (a6l_fdump && a6l_f_logged[v] < a6l_fdump && ((s1 & (BIT(29) | BIT(4))) || (s0 & GENMASK(14, 8)))) {
+		u32 b = 0xa0 + 0x2c * (a6l_fdump_wm & 7);
+
+		a6l_f_logged[v]++;
+		dev_info(vfe->camss->dev,
+			 "A6L_VFE%u_F %s%s%s sof#%u t %lldus s0 %08x s1 %08x pp %08x be %08x cgc %08x wm%u %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			 vfe->id, (s1 & BIT(29)) ? "SOF" : "", (s0 & GENMASK(14, 8)) ? "DONE" : "", (s1 & BIT(4)) ? "BUSERR" : "",
+			 a6l_f_sof[v], ktime_us_delta(ktime_get(), a6l_f_t0[v]), s0, s1,
+			 readl_relaxed(vfe->base + 0x338), readl_relaxed(vfe->base + 0xc94), readl_relaxed(vfe->base + 0x3c),
+			 a6l_fdump_wm & 7, readl_relaxed(vfe->base + b), readl_relaxed(vfe->base + b + 0x4),
+			 readl_relaxed(vfe->base + b + 0x8), readl_relaxed(vfe->base + b + 0xc), readl_relaxed(vfe->base + b + 0x10),
+			 readl_relaxed(vfe->base + b + 0x14), readl_relaxed(vfe->base + b + 0x18), readl_relaxed(vfe->base + b + 0x1c),
+			 readl_relaxed(vfe->base + b + 0x20), readl_relaxed(vfe->base + b + 0x24), readl_relaxed(vfe->base + b + 0x28));
+	}
+	if (n <= 12 || (a6l_dbg > 1 && !(n % 64)))
+		dev_info(vfe->camss->dev, "A6L_VFE%u irq#%u s0 0x%08x s1 0x%08x pp 0x%08x\n",
+			 vfe->id, n, s0, s1, readl_relaxed(vfe->base + 0x338));
+	/* VFE 4.8 s1 bit4 = bus error summary, per-WM bits in 0xC94 (stock ignores it for RDI WMs) */
+	if ((s1 & BIT(4)) && a6l_vfe_bits[v][36] <= 4)
+		dev_info(vfe->camss->dev, "A6L_VFE%u BUSERR#%u 0xc94 0x%08x (irq#%u)\n", vfe->id,
+			 a6l_vfe_bits[v][36], readl_relaxed(vfe->base + 0xc94), n);
+	/* camfix4 experiment (a6l_wm bit3): reload the WMs that reported a bus error */
+	if ((s1 & BIT(4)) && (a6l_wm & 8)) {
+		u32 be = readl_relaxed(vfe->base + 0xc94);
+		unsigned int w;
+
+		for (w = 0; w < 7; w++)
+			if (be & BIT(w))
+				vfe_bus_reload_wm(vfe, w);
+	}
+	/* s1: bit0 camif error, bit7 violation, bits 9..15 image master bus overflow */
+	if (s1 & (GENMASK(15, 9) | BIT(7) | BIT(0)))
+		dev_err_ratelimited(vfe->camss->dev, "A6L_VFE%u ERR s1 0x%08x (ovf wm 0x%02x) violation 0x%08x\n",
+				    vfe->id, s1, (s1 >> 9) & 0x7f, readl_relaxed(vfe->base + 0x07c));
+}
+
+void a6l_vfe_dump(struct vfe_device *vfe, const char *tag)
+{
+	static const u16 rng[][2] = { { 0x000, 0x160 }, { 0x300, 0x360 }, { 0x400, 0x4c0 }, { 0xc80, 0xca0 } };
+	unsigned int v = vfe->id & 1, i, r;
+	char buf[400];
+	int len = 0;
+	u32 o;
+
+	if (!a6l_dbg)
+		return;
+	if (vfe->power_count <= 0) { /* A6L camfix3: never touch an unclocked block */
+		dev_info(vfe->camss->dev, "A6L_VFE%u_%s skipped (power_count %d)\n", vfe->id, tag, vfe->power_count);
+		return;
+	}
+	buf[0] = 0;
+	for (i = 0; i < 64; i++)
+		if (a6l_vfe_bits[v][i])
+			len += scnprintf(buf + len, sizeof(buf) - len, " %s%u:%u",
+					 i < 32 ? "s0b" : "s1b", i % 32, a6l_vfe_bits[v][i]);
+	dev_info(vfe->camss->dev, "A6L_VFE%u_%s irqs %u bits%s\n", vfe->id, tag, a6l_vfe_nirq[v],
+		 len ? buf : " none");
+	for (r = 0; r < ARRAY_SIZE(rng); r++)
+		for (o = rng[r][0]; o < rng[r][1]; o += 32) {
+			u32 w[8], nz = 0;
+
+			for (i = 0; i < 8; i++) {
+				w[i] = readl_relaxed(vfe->base + o + 4 * i);
+				nz |= w[i];
+			}
+			if (nz)
+				dev_info(vfe->camss->dev, "A6L_VFE%u_REG %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+					 vfe->id, o, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		}
+	dev_info(vfe->camss->dev, "A6L_VFE%u_FRAMES %s sof %u done %u buserr %u first_buserr_sof %u logged %u\n",
+		 vfe->id, tag, a6l_f_sof[v], a6l_f_done[v], a6l_f_be[v], a6l_f_be[v] ? a6l_f_be_first[v] : 0, a6l_f_logged[v]);
+	a6l_f_sof[v] = 0;
+	a6l_f_done[v] = 0;
+	a6l_f_be[v] = 0;
+	a6l_f_be_first[v] = 0;
+	a6l_f_logged[v] = 0;
+	a6l_f_t0[v] = 0;
+	memset(a6l_vfe_bits[v], 0, sizeof(a6l_vfe_bits[v]));
+	a6l_vfe_nirq[v] = 0;
+}
