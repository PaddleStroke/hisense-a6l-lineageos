+		 readl_relaxed(vfe->base + 0xb8), readl_relaxed(vfe->base + 0xbc), readl_relaxed(vfe->base + 0xc0));
+	a6l_v6_regs(vfe, tag);
+	a6l_v7_regs(vfe, tag); /* camfix7 */
+	a6l_v8_regs(vfe, tag); /* camfix8 */
+	a6l_v9_regs(vfe, tag); /* camfix9 */
+	a6l_f_rec[v] = 0;
+	a6l_f_probe[v] = 0;
+	a6l_be_last[v] = 0;
+	a6l_f_sof[v] = 0;
+	a6l_f_done[v] = 0;
+	a6l_f_be[v] = 0;
+	a6l_f_be_first[v] = 0;
+	a6l_f_logged[v] = 0;
+	a6l_f_t0[v] = 0;
+	memset(a6l_vfe_bits[v], 0, sizeof(a6l_vfe_bits[v]));
+	a6l_vfe_nirq[v] = 0;
