 static irqreturn_t vfe_isr(int irq, void *dev)
 {
 	struct vfe_device *vfe = dev;
@@ -973,6 +2477,7 @@
 
 	dev_dbg(vfe->camss->dev, "VFE: status0 = 0x%08x, status1 = 0x%08x\n",
 		value0, value1);
+	a6l_vfe_count(vfe, value0, value1);
 
 	if (value0 & VFE_0_IRQ_STATUS_0_RESET_ACK)
 		vfe->isr_ops.reset_ack(vfe);
@@ -986,6 +2491,8 @@
 	for (i = VFE_LINE_RDI0; i < vfe->res->line_num; i++)
 		if (value0 & VFE_0_IRQ_STATUS_0_line_n_REG_UPDATE(i))
 			vfe->isr_ops.reg_update(vfe, i);
+	a6l_stk_isr(vfe, value0, value1); /* camfix9b */
+	a6l_v10_isr(vfe, value0, value1); /* camfix10 */
 
 	if (value0 & VFE_0_IRQ_STATUS_0_CAMIF_SOF)
 		vfe->isr_ops.sof(vfe, VFE_LINE_PIX);
@@ -1043,6 +2550,14 @@
 	writel_relaxed(val4, vfe->base + VFE_0_BUS_BDG_QOS_CFG_5);
 	writel_relaxed(val4, vfe->base + VFE_0_BUS_BDG_QOS_CFG_6);
 	writel_relaxed(val7, vfe->base + VFE_0_BUS_BDG_QOS_CFG_7);
+	/* camfix6: stock also programs the camera VBIF here (msm_vfe47_init_hardware_reg) */
+	a6l_v6_regs(vfe, "PRE");
+	if (a6l_v6 & 1)
+		a6l_vbif_apply(vfe);
+	a6l_v6_regs(vfe, "START");
+	a6l_v7_start(vfe); /* camfix7 */
+	a6l_v8_start(vfe); /* camfix8 */
+	a6l_v9_start(vfe); /* camfix9 */
 }
 
