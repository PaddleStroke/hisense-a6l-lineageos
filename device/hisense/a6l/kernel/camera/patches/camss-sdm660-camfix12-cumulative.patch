+static u32 a6l_vfe_bits[2][64];
+static u32 a6l_vfe_nirq[2];
+
+static void a6l_vfe_count(struct vfe_device *vfe, u32 s0, u32 s1)
+{
+	unsigned int v = vfe->id & 1, b;
+	bool stk_ign = false;
+	u32 n;
+
+	if (!a6l_dbg)
+		return;
+	n = ++a6l_vfe_nirq[v];
+	/* camfix9b bit2: stock msm_vfe48_get_bus_err_mask - bus error only from RDI WMs -> ignored, nothing else done */
+	if ((s1 & BIT(4)) && (a6l_stk & 4) && a6l_stk_ign[v] &&
+	    !(readl_relaxed(vfe->base + 0xc94) & 0x7f & ~a6l_stk_ign[v]))
+		stk_ign = true;
+	for (b = 0; b < 32; b++) {
+		if (s0 & BIT(b))
+			a6l_vfe_bits[v][b]++;
+		if (s1 & BIT(b))
+			a6l_vfe_bits[v][32 + b]++;
+	}
+	/* camfix5: per-frame accounting (RDI0 SOF = s1 bit29, WM ping-pong done = s0 bits 8..14, bus error = s1 bit4) */
+	if (n == 1 || !a6l_f_t0[v])
+		a6l_f_t0[v] = ktime_get();
+	if (s1 & BIT(29))
+		a6l_f_sof[v]++;
+	if (s0 & GENMASK(14, 8))
+		a6l_f_done[v]++;
+	if (s1 & BIT(4)) {
+		if (!a6l_f_be[v])
+			a6l_f_be_first[v] = a6l_f_sof[v];
+		if (stk_ign && !a6l_stk_nbe[v]++)
+			dev_info(vfe->camss->dev, "A6L_STK BUSERR ignored (stock: RDI WM mask 0x%02x) 0xc94 0x%08x sof#%u\n",
+				 a6l_stk_ign[v], readl_relaxed(vfe->base + 0xc94), a6l_f_sof[v]);
+		if (!stk_ign && !a6l_v7_be_logged[v]) { /* camfix7: SMMU/MMCC state at the first bus error */
+			a6l_v7_be_logged[v] = true;
+			a6l_v7_regs(vfe, "BUSERR");
+			a6l_v8_regs(vfe, "BUSERR"); /* camfix8 */
+			a6l_v9_regs(vfe, "BUSERR"); /* camfix9 */
+		}
