+		dev_info(vfe->camss->dev,
+			 "A6L_VBIF %s ver %08x clkforce %08x wgather(ac) %08x inrd(b0) %08x inwr(c0) %08x outrd(d0) %08x outwr(d4) %08x rrqos(124) %08x amem(160) %08x pnderr(190) %08x srcerr(194) %08x halt %08x %08x\n",
