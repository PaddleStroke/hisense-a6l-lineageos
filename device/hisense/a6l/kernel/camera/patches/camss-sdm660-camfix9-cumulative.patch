+static void a6l_v6_map(void)
+{
+	if (!a6l_vbif_base)
+		a6l_vbif_base = ioremap(A6L_VBIF_PHYS, 0x3000);
+	if (!a6l_axi_rcg)
+		a6l_axi_rcg = ioremap(A6L_AXI_RCG, 0x10);
