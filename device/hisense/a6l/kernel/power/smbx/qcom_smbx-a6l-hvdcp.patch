+/* read-only register dump for the attended logs (USBIN APSD/HVDCP/Type-C status + config, ICL, power path) */
+static const u16 a6l_hv_dump_regs[] = {
+	0x306, 0x307, 0x308, 0x309, 0x30B, 0x30C, 0x30D, 0x30E, 0x30F, 0x310, 0x330, 0x331, 0x340,
+	0x358, 0x35B, 0x360, 0x362, 0x363, 0x365, 0x366, 0x369, 0x370, 0x607, 0x60B, 0x006, 0x007,
+};
