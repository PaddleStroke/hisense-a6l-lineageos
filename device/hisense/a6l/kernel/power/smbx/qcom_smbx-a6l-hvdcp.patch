+/* ---- A6L HVDCP ---------------------------------------------------------------------------------------------- */
+static DEFINE_MUTEX(a6l_hv_param_lock);
+static struct smb_chip *a6l_hv_chip;	/* single PM660 charger instance, for the runtime parameters */
+
+static void a6l_hv_kick(struct smb_chip *chip, unsigned int ms)
+{
+	if (!chip->hv_removing)
+		mod_delayed_work(system_wq, &chip->hvdcp_work, msecs_to_jiffies(ms));
+}
+
+static int a6l_hv_param_kick(void)
+{
+	mutex_lock(&a6l_hv_param_lock);
+	if (a6l_hv_chip)
+		a6l_hv_kick(a6l_hv_chip, 0);
+	mutex_unlock(&a6l_hv_param_lock);
+	return 0;
+}
+
+static int a6l_hv_enable_set(const char *val, const struct kernel_param *kp)
+{
+	int rc = param_set_bool(val, kp);
+
+	return rc ? rc : a6l_hv_param_kick();
+}
+
+static int a6l_hv_icl_set(const char *val, const struct kernel_param *kp)
+{
+	int rc = param_set_uint(val, kp);
+
+	if (rc)
+		return rc;
+	hvdcp_icl_ua = clamp_t(unsigned int, hvdcp_icl_ua, A6L_HV_ICL_MIN_UA, A6L_HV_ICL_MAX_UA);
+	return a6l_hv_param_kick();
+}
+
+static int a6l_hv_status_get(char *buf, const struct kernel_param *kp)
+{
+	struct smb_chip *chip;
+	int n;
+
+	mutex_lock(&a6l_hv_param_lock);
+	chip = a6l_hv_chip;
+	if (!chip) {
+		mutex_unlock(&a6l_hv_param_lock);
+		return sysfs_emit(buf, "state=nodev\n");
+	}
+	mutex_lock(&chip->hv_lock);
+	n = sysfs_emit(buf, "state=%s qc=%d pulses=%d target_uV=%d usbin_uV=%d usbin_uA=%d icl_uA=%u enable=%d apsd=0x%02x/0x%02x reruns=%d reason=%s\n",
+		       a6l_hv_state_names[chip->hv_state], chip->hv_qc, chip->hv_pulses, chip->hv_target_uv,
+		       chip->hv_uv, chip->hv_ua, chip->hv_icl_ua, hvdcp_enable, chip->hv_apsd, chip->hv_res,
+		       chip->hv_reruns, chip->hv_reason[0] ? chip->hv_reason : "-");
+	mutex_unlock(&chip->hv_lock);
+	mutex_unlock(&a6l_hv_param_lock);
+	return n;
+}
+
+static const struct kernel_param_ops a6l_hv_enable_ops = {
