+	if (rc)
+		return rc;
+	if (!req)
+		return 0;
+	mutex_lock(&a6l_hv_param_lock);
+	if (a6l_hv_chip) {
+		mutex_lock(&a6l_hv_chip->hv_lock);
+		a6l_hv_chip->hv_rerun_req = true;
+		mutex_unlock(&a6l_hv_chip->hv_lock);
+		a6l_hv_kick(a6l_hv_chip, 0);
