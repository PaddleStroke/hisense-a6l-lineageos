+static int a6l_hv_target_uv(void)
+{
+	unsigned int t = clamp_t(unsigned int, hvdcp_max_uv, A6L_HV_MIN_UV, A6L_HV_MAX_UV);
+
+	return A6L_HV_5V_UV + (t - A6L_HV_5V_UV) / A6L_HV_STEP_UV * A6L_HV_STEP_UV;
+}
+
+static int a6l_hv_read_uv(struct smb_chip *chip, int *uv)
+{
+	int rc = iio_read_channel_processed(chip->usb_in_v_chan, uv);
+
+	if (rc < 0)
+		*uv = -1;
+	return rc;
+}
+
+static int a6l_hv_read_ua(struct smb_chip *chip, int *ua)
+{
+	int rc = iio_read_channel_processed(chip->usb_in_i_chan, ua);
+
+	if (rc < 0)
+		*ua = -1;
+	return rc;
+}
+
+static void a6l_hv_set_icl(struct smb_chip *chip, unsigned int ua)
+{
+	chip->hv_icl_ua = ua;
+	smb_set_current_limit(chip, ua);
+}
+
+static int a6l_hv_hw_config(struct smb_chip *chip, bool on)
+{
+	int rc;
+
+	if (on) {
+		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_ADAPTER_ALLOW_CFG,
+					USBIN_ADAPTER_ALLOW_MASK, USBIN_ADAPTER_ALLOW_5V_TO_9V);
+		if (rc < 0)
+			return rc;
+		rc = regmap_update_bits(chip->regmap, chip->base + HVDCP_PULSE_COUNT_MAX,
+					HVDCP_PULSE_COUNT_MAX_QC2_MASK | HVDCP_PULSE_COUNT_MAX_QC3_MASK,
+					HVDCP_PULSE_COUNT_MAX_QC2_9V |
+					(a6l_hv_target_uv() - A6L_HV_5V_UV) / A6L_HV_STEP_UV);
+		if (rc < 0)
+			return rc;
+		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG,
+					HVDCP_EN_BIT | HVDCP_AUTH_ALG_EN_CFG_BIT |
+					HVDCP_AUTONOMOUS_MODE_EN_CFG_BIT,
+					HVDCP_EN_BIT | HVDCP_AUTH_ALG_EN_CFG_BIT);
+	} else {
+		rc = regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG,
+					HVDCP_EN_BIT | HVDCP_AUTH_ALG_EN_CFG_BIT |
+					HVDCP_AUTONOMOUS_MODE_EN_CFG_BIT, 0);
+	}
+	if (rc < 0)
+		return rc;
+	chip->hv_hw_on = on;
+	chip->hv_apsd_stale = on;
+	return 0;
+}
+
+/* cable present (USBIN plugin RT status; stays set while the input is suspended, unlike the power path) */
+static bool a6l_hv_present(struct smb_chip *chip)
+{
+	unsigned int rt = 0;
+
+	return !regmap_read(chip->regmap, chip->base + INT_RT_STS, &rt) && (rt & USBIN_PLUGIN_RT_STS_BIT);
+}
+
+/* back to 5 V; called with hv_lock held */
+static void a6l_hv_to_5v(struct smb_chip *chip, int next_state, unsigned int icl_ua, const char *reason)
+{
+	int i, uv = -1;
+
+	if (reason)
+		strscpy(chip->hv_reason, reason, sizeof(chip->hv_reason));
+	for (i = 0; chip->hv_qc == 3 && i < chip->hv_pulses; i++) {
+		regmap_write(chip->regmap, chip->base + CMD_HVDCP_2, SINGLE_DECREMENT_BIT);
+		msleep(A6L_HV_PULSE_MS);
+	}
+	chip->hv_pulses = 0;
+	regmap_write(chip->regmap, chip->base + CMD_HVDCP_2, FORCE_5V_BIT);
+	for (i = 0; i < 20; i++) {
+		msleep(100);
+		if (a6l_hv_read_uv(chip, &uv) >= 0 && uv < A6L_HV_LOW_OK_UV)
+			break;
+	}
+	chip->hv_uv = uv;
+	a6l_hv_set_icl(chip, icl_ua);
+	if (uv >= A6L_HV_LOW_OK_UV) {
+		unsigned int cmd = 0;
+
+		/* r5 bug hunt power: remember that WE suspended the input (not userspace) so the unplug can release it */
+		if (regmap_read(chip->regmap, chip->base + USBIN_CMD_IL, &cmd) >= 0 && !(cmd & USBIN_SUSPEND_BIT) &&
+		    regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL, USBIN_SUSPEND_BIT, USBIN_SUSPEND_BIT) >= 0)
+			chip->hv_susp = true;
+		dev_err(chip->dev, "A6L_HVDCP still %d uV after FORCE_5V -> USB input SUSPENDED (%s)\n",
+			uv, chip->hv_reason);
+		next_state = A6L_HV_FAILED;
+	}
+	dev_warn(chip->dev, "A6L_HVDCP back to 5V: %s (usbin %d uV, ICL %u uA, state %s)\n",
+		 chip->hv_reason, uv, icl_ua, a6l_hv_state_names[next_state]);
+	chip->hv_state = next_state;
+	power_supply_changed(chip->chg_psy);
+}
+
+static void a6l_hv_abort(struct smb_chip *chip, const char *why, int val)
+{
+	char r[64];
+
+	snprintf(r, sizeof(r), "%s %d", why, val);
+	dev_err(chip->dev, "A6L_HVDCP ABORT %s (state %s, QC%d)\n", r, a6l_hv_state_names[chip->hv_state], chip->hv_qc);
+	a6l_hv_to_5v(chip, A6L_HV_FAILED, A6L_HV_FAIL_ICL_UA, r);
+}
