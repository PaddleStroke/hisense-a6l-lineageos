+static int a6l_hv_regs_get(char *buf, const struct kernel_param *kp)
+{
+	struct smb_chip *chip;
+	unsigned int v, i;
+	int n = 0;
+
+	mutex_lock(&a6l_hv_param_lock);
+	chip = a6l_hv_chip;
+	if (!chip) {
+		mutex_unlock(&a6l_hv_param_lock);
+		return sysfs_emit(buf, "nodev\n");
+	}
+	for (i = 0; i < ARRAY_SIZE(a6l_hv_dump_regs); i++) {
+		if (regmap_read(chip->regmap, chip->base + a6l_hv_dump_regs[i], &v) < 0)
+			n += sysfs_emit_at(buf, n, "%04x=?? ", chip->base + a6l_hv_dump_regs[i]);
+		else
+			n += sysfs_emit_at(buf, n, "%04x=%02x ", chip->base + a6l_hv_dump_regs[i], v & 0xff);
+	}
+	mutex_unlock(&a6l_hv_param_lock);
+	n += sysfs_emit_at(buf, n, "\n");
+	return n;
+}
