+static void a6l_hv_reset(struct smb_chip *chip, int state)
+{
+	chip->hv_state = state;
+	chip->hv_qc = 0;
+	chip->hv_pulses = 0;
+	chip->hv_bad_v = 0;
+	chip->hv_bad_i = 0;
+	chip->hv_reason[0] = '\0';
+}
+
+/* r5 bug hunt power: the input suspend set by the abort path lasts until the unplug only (hv_lock held) */
+static void a6l_hv_release_susp(struct smb_chip *chip)
+{
+	if (!chip->hv_susp)
+		return;
+	if (regmap_update_bits(chip->regmap, chip->base + USBIN_CMD_IL, USBIN_SUSPEND_BIT, 0) < 0) {
+		dev_err(chip->dev, "A6L_HVDCP unplugged: releasing the USB input suspend failed, retrying\n");
+		return;
+	}
+	chip->hv_susp = false;
+	dev_info(chip->dev, "A6L_HVDCP unplugged: USB input suspend (set by the abort) released\n");
+}
+
+/* anything for the HVDCP work to do on a plug/unplug event (hvdcp_enable=0 and idle: nothing, r4-identical) */
+static bool a6l_hv_wants_events(struct smb_chip *chip)
+{
+	return hvdcp_enable || READ_ONCE(chip->hv_state) != A6L_HV_OFF || READ_ONCE(chip->hv_susp);
+}
+
+static const char *a6l_hv_apsd_name(unsigned int res)
+{
+	if (res & QC_3P0_BIT)
+		return "QC3";
+	if (res & QC_2P0_BIT)
+		return "QC2";
+	if (res & DCP_CHARGER_BIT)
+		return "DCP";
+	if (res & CDP_CHARGER_BIT)
+		return "CDP";
+	if (res & SDP_CHARGER_BIT)
+		return "SDP";
+	if (res & OCP_CHARGER_BIT)
+		return "OCP";
+	if (res & FLOAT_CHARGER_BIT)
+		return "FLOAT";
+	return "none";
+}
+
+/* read APSD status + result into hv_apsd/hv_res, log every change (called with hv_lock held) */
+static void a6l_hv_read_apsd(struct smb_chip *chip, unsigned int *apsd, unsigned int *res)
+{
+	unsigned int opt1 = 0;
+
+	*apsd = 0;
+	*res = 0;
+	regmap_read(chip->regmap, chip->base + APSD_STATUS, apsd);
+	regmap_read(chip->regmap, chip->base + APSD_RESULT_STATUS, res);
+	*apsd &= 0xff;
+	*res &= APSD_RESULT_STATUS_MASK;
+	chip->hv_apsd = *apsd;
+	chip->hv_res = *res;
+	if (chip->hv_apsd_log == (int)(*apsd << 8 | *res))
+		return;
+	chip->hv_apsd_log = *apsd << 8 | *res;
+	regmap_read(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG, &opt1);
+	dev_info(chip->dev, "A6L_HVDCP APSD status 0x%02x result 0x%02x (%s%s%s%s) opt1 0x%02x state %s\n",
+		 *apsd, *res, a6l_hv_apsd_name(*res), (*apsd & QC_CHARGER_BIT) ? " qc_charger" : "",
+		 (*apsd & QC_AUTH_DONE_STATUS_BIT) ? " auth_done" : "",
+		 (*apsd & HVDCP_CHECK_TIMEOUT_BIT) ? " hvdcp_timeout" : "", opt1 & 0xff,
+		 a6l_hv_state_names[chip->hv_state]);
+}
+
+static void a6l_hv_start_raise(struct smb_chip *chip)
+{
+	int target = a6l_hv_target_uv(), n, uv;
+
+	chip->hv_target_uv = target;
+	a6l_hv_set_icl(chip, min_t(unsigned int, hvdcp_icl_ua, A6L_HV_RAMP_ICL_UA));
+	if (chip->hv_qc == 2) {
+		if (target < A6L_HV_MAX_UV) {
+			snprintf(chip->hv_reason, sizeof(chip->hv_reason), "QC2 needs 9V target");
+			chip->hv_state = A6L_HV_DCP;
+			a6l_hv_set_icl(chip, chip->dcp_icl_ua);
+			return;
+		}
+		regmap_write(chip->regmap, chip->base + CMD_HVDCP_2, FORCE_9V_BIT);
+	} else {
+		for (n = (target - A6L_HV_5V_UV) / A6L_HV_STEP_UV; chip->hv_pulses < n;) {
+			if (!hvdcp_enable || chip->hv_removing)
+				break;
+			regmap_write(chip->regmap, chip->base + CMD_HVDCP_2, SINGLE_INCREMENT_BIT);
+			chip->hv_pulses++;
+			msleep(A6L_HV_PULSE_MS);
+			if (a6l_hv_read_uv(chip, &uv) >= 0 && uv > target + A6L_HV_WINDOW_UV) {
+				a6l_hv_abort(chip, "QC3 overshoot uV", uv);
+				return;
+			}
+		}
+	}
+	dev_info(chip->dev, "A6L_HVDCP QC%d: requested %d uV (%d pulses), ICL %u uA\n",
+		 chip->hv_qc, target, chip->hv_pulses, chip->hv_icl_ua);
+	chip->hv_state = A6L_HV_VERIFY;
+	chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_VERIFY_MS);
+}
+
+static void a6l_hvdcp_work(struct work_struct *work)
+{
+	struct smb_chip *chip = container_of(work, struct smb_chip, hvdcp_work.work);
+	unsigned int apsd = 0, res = 0, rt = 0, st2 = 0, icl_raw = 0;
+	int uv = -1, ua = -1, next = 0;
+
+	mutex_lock(&chip->hv_lock);
+	if (chip->hv_removing)
+		goto out;
+
+	/* runtime disable: back to 5 V, HVDCP detection off */
+	if (!hvdcp_enable) {
+		if (chip->hv_state == A6L_HV_VERIFY || chip->hv_state == A6L_HV_ACTIVE ||
+		    (chip->hv_state != A6L_HV_OFF && a6l_hv_read_uv(chip, &uv) >= 0 && uv >= A6L_HV_LOW_OK_UV))
+			a6l_hv_to_5v(chip, A6L_HV_OFF, chip->dcp_icl_ua ? chip->dcp_icl_ua : SDP_CURRENT_UA,
+				     "hvdcp_enable=0");
+		if (chip->hv_hw_on)
+			a6l_hv_hw_config(chip, false);
+		a6l_hv_reset(chip, A6L_HV_OFF);
+		if (chip->hv_susp && !a6l_hv_present(chip))
+			a6l_hv_release_susp(chip);
+		if (chip->hv_susp)
+			next = 2000;	/* watch for the unplug */
+		goto out;
+	}
+
+	if (!chip->hv_hw_on) {
+		if (a6l_hv_hw_config(chip, true) < 0) {
+			dev_err(chip->dev, "A6L_HVDCP HW config failed\n");
+			goto out;
+		}
+		a6l_hv_reset(chip, A6L_HV_IDLE);
+		chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_DETECT_MS);
+	}
+
+	if (!a6l_hv_present(chip)) {
+		if (chip->hv_state != A6L_HV_IDLE && chip->hv_state != A6L_HV_OFF)
+			dev_info(chip->dev, "A6L_HVDCP unplugged (state %s) -> idle\n",
+				 a6l_hv_state_names[chip->hv_state]);
+		a6l_hv_reset(chip, A6L_HV_IDLE);
+		a6l_hv_release_susp(chip);
+		if (chip->hv_susp)
+			next = 2000;	/* release failed: retry */
+		chip->hv_apsd_stale = false;	/* the next plug-in runs APSD with HVDCP_EN on */
+		chip->hv_plugged = false;
+		chip->hv_rerun_req = false;
+		chip->hv_reruns = 0;
+		chip->hv_apsd_log = -1;
+		chip->hv_uv = 0;
+		chip->hv_ua = 0;
+		goto out;	/* the usb-plugin IRQ restarts us */
+	}
+	if (!chip->hv_plugged) {
+		/* plug-in edge (or first run with a cable in): poll APSD for the whole detection window */
+		chip->hv_plugged = true;
+		if (chip->hv_state == A6L_HV_IDLE || chip->hv_state == A6L_HV_OFF) {
+			chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_PLUG_MS);
+			dev_info(chip->dev, "A6L_HVDCP cable in, polling APSD for %d ms\n", A6L_HV_PLUG_MS);
+		}
+	}
+
+	a6l_hv_read_uv(chip, &uv);
+	a6l_hv_read_ua(chip, &ua);
+	chip->hv_uv = uv;
+	chip->hv_ua = ua;
+	regmap_read(chip->regmap, chip->base + INT_RT_STS, &rt);
+
+	/* absolute limits, any state */
+	if (chip->hv_state != A6L_HV_FAILED && (uv > A6L_HV_ABS_MAX_UV || (rt & USBIN_OV_RT_STS_BIT))) {
+		a6l_hv_abort(chip, rt & USBIN_OV_RT_STS_BIT ? "USBIN OV status, uV" : "USBIN > 9.6 V, uV", uv);
+		next = 2000;
+		goto out;
+	}
+
+	/* hvdcp_rerun: one new APSD run at 5 V on a non-SDP/CDP cable (the operator removed the USB pull-up first) */
+	if (chip->hv_rerun_req) {
+		chip->hv_rerun_req = false;
+		a6l_hv_read_apsd(chip, &apsd, &res);
+		if (chip->hv_state != A6L_HV_IDLE && chip->hv_state != A6L_HV_DCP) {
+			dev_info(chip->dev, "A6L_HVDCP rerun refused: state %s\n", a6l_hv_state_names[chip->hv_state]);
+		} else if (res & (SDP_CHARGER_BIT | CDP_CHARGER_BIT)) {
+			dev_info(chip->dev, "A6L_HVDCP rerun refused: %s (USB host, never re-run)\n", a6l_hv_apsd_name(res));
+		} else if (uv >= A6L_HV_LOW_OK_UV) {
+			dev_info(chip->dev, "A6L_HVDCP rerun refused: usbin %d uV\n", uv);
+		} else if (chip->hv_reruns >= A6L_HV_MAX_RERUNS) {
+			dev_info(chip->dev, "A6L_HVDCP rerun refused: %d reruns on this plug-in\n", chip->hv_reruns);
+		} else {
+			chip->hv_reruns++;
+			a6l_hv_reset(chip, A6L_HV_IDLE);
+			chip->hv_apsd_stale = false;
+			if (chip->dcp_icl_ua)
+				a6l_hv_set_icl(chip, min_t(unsigned int, chip->dcp_icl_ua, A6L_HV_RAMP_ICL_UA));
+			regmap_update_bits(chip->regmap, chip->base + CMD_APSD, APSD_RERUN_BIT, APSD_RERUN_BIT);
+			chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_PLUG_MS);
+			dev_info(chip->dev, "A6L_HVDCP APSD rerun #%d requested (was 0x%02x/0x%02x %s)\n",
+				 chip->hv_reruns, apsd, res, a6l_hv_apsd_name(res));
+			next = 500;
+			goto out;
+		}
+	}
+
+	switch (chip->hv_state) {
+	case A6L_HV_OFF:
+	case A6L_HV_IDLE:
+		a6l_hv_read_apsd(chip, &apsd, &res);
+		chip->hv_state = A6L_HV_IDLE;
+		if (!(apsd & APSD_DTC_STATUS_DONE_BIT) || !res) {
+			/* APSD still running (or re-running): poll within the window armed at plug-in / rerun */
+			if (time_before(jiffies, chip->hv_deadline))
+				next = A6L_HV_FAST_MS;
+			break;
+		}
+		if (res & (SDP_CHARGER_BIT | CDP_CHARGER_BIT))
+			break;		/* USB host: nothing to do at 5 V */
+		if (!(res & (A6L_HV_APSD_DCP_CLASS | A6L_HV_APSD_QC))) {
+			if (time_before(jiffies, chip->hv_deadline))
+				next = A6L_HV_FAST_MS;
+			break;
+		}
+		if (!(res & (DCP_CHARGER_BIT | A6L_HV_APSD_QC)))
+			dev_warn(chip->dev, "A6L_HVDCP APSD result 0x%02x = %s, not a BC1.2 DCP: D+/D- disturbed (USB pull-up?), no HVDCP handshake; hvdcp_rerun after removing it\n",
+				 res, a6l_hv_apsd_name(res));
+		if (chip->hv_apsd_stale && !(res & (QC_2P0_BIT | QC_3P0_BIT))) {
+			/* HVDCP_EN came on after this DCP was detected: one new APSD run (DCP only, never SDP/CDP) */
+			dev_info(chip->dev, "A6L_HVDCP DCP detected before HVDCP was enabled: re-running APSD\n");
+			chip->hv_apsd_stale = false;
+			regmap_update_bits(chip->regmap, chip->base + CMD_APSD, APSD_RERUN_BIT, APSD_RERUN_BIT);
+			chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_PLUG_MS);
+			next = 1500;
+			break;
+		}
+		chip->hv_apsd_stale = false;
+		if (!chip->dcp_icl_ua)
+			chip->dcp_icl_ua = chip->batt_info->constant_charge_current_max_ua;
+		a6l_hv_set_icl(chip, min_t(unsigned int, chip->dcp_icl_ua, A6L_HV_RAMP_ICL_UA));
+		chip->hv_state = A6L_HV_WAIT;
+		chip->hv_deadline = jiffies + msecs_to_jiffies(A6L_HV_DETECT_MS);
+		chip->hv_auth_deadline = 0;
+		next = A6L_HV_FAST_MS;
+		break;
+	case A6L_HV_WAIT:
+		a6l_hv_read_apsd(chip, &apsd, &res);
+		chip->hv_qc = (res & QC_3P0_BIT) ? 3 : (res & QC_2P0_BIT) ? 2 : 0;
+		/* HVDCP seen (QC_CHARGER) but the QC2/QC3 authentication not finished yet: wait for QC_AUTH_DONE */
+		if (chip->hv_qc && (apsd & QC_CHARGER_BIT) && !(apsd & QC_AUTH_DONE_STATUS_BIT)) {
+			if (!chip->hv_auth_deadline)
+				chip->hv_auth_deadline = jiffies + msecs_to_jiffies(A6L_HV_AUTH_MS);
+			if (time_before(jiffies, chip->hv_auth_deadline)) {
+				next = A6L_HV_FAST_MS;
+				break;
+			}
+			dev_warn(chip->dev, "A6L_HVDCP QC%d without QC_AUTH_DONE after %d ms, using the APSD result\n",
+				 chip->hv_qc, A6L_HV_AUTH_MS);
+		}
+		if (!chip->hv_qc && (apsd & QC_CHARGER_BIT) && !(apsd & QC_AUTH_DONE_STATUS_BIT)) {
+			if (!chip->hv_auth_deadline)
+				chip->hv_auth_deadline = jiffies + msecs_to_jiffies(A6L_HV_AUTH_MS);
+			if (time_before(jiffies, chip->hv_auth_deadline)) {
+				next = A6L_HV_FAST_MS;
+				break;
+			}
+		}
+		if (chip->hv_qc) {
+			dev_info(chip->dev, "A6L_HVDCP QC%d detected (APSD 0x%02x/0x%02x, usbin %d uV)\n",
+				 chip->hv_qc, apsd, res, uv);
+			a6l_hv_start_raise(chip);
+			next = A6L_HV_FAST_MS;
+			break;
+		}
+		if (uv >= A6L_HV_LOW_OK_UV) {
+			a6l_hv_abort(chip, "high USBIN without a QC result, uV", uv);
+			next = 2000;
+			break;
+		}
+		if ((apsd & HVDCP_CHECK_TIMEOUT_BIT) || time_after(jiffies, chip->hv_deadline)) {
+			dev_info(chip->dev, "A6L_HVDCP plain DCP (APSD 0x%02x/0x%02x), 5 V, ICL %u uA\n",
+				 apsd, res, chip->dcp_icl_ua);
+			chip->hv_state = A6L_HV_DCP;
+			a6l_hv_set_icl(chip, chip->dcp_icl_ua);
+			next = 2000;
+			break;
+		}
+		next = A6L_HV_FAST_MS;
+		break;
+	case A6L_HV_DCP:
+	case A6L_HV_FAILED:
+		if (uv >= A6L_HV_LOW_OK_UV && chip->hv_state == A6L_HV_DCP)
+			a6l_hv_abort(chip, "unexpected high USBIN at 5 V, uV", uv);
+		else if (uv >= A6L_HV_LOW_OK_UV && regmap_read(chip->regmap, chip->base + USBIN_CMD_IL, &st2) >= 0 &&
+			 !(st2 & USBIN_SUSPEND_BIT))
+			a6l_hv_to_5v(chip, A6L_HV_FAILED, A6L_HV_FAIL_ICL_UA, NULL);
+		next = 2000;	/* watch for unplug and the adapter */
+		break;
+	case A6L_HV_VERIFY:
+		if (uv >= chip->hv_target_uv - A6L_HV_WINDOW_UV && uv <= chip->hv_target_uv + A6L_HV_WINDOW_UV) {
+			a6l_hv_set_icl(chip, hvdcp_icl_ua);
+			chip->hv_state = A6L_HV_ACTIVE;
+			chip->hv_bad_v = 0;
+			chip->hv_bad_i = 0;
+			dev_info(chip->dev, "A6L_HVDCP ACTIVE QC%d usbin %d uV, ICL %u uA\n",
+				 chip->hv_qc, uv, chip->hv_icl_ua);
+			power_supply_changed(chip->chg_psy);
+			next = A6L_HV_POLL_MS;
+		} else if (uv > chip->hv_target_uv + A6L_HV_WINDOW_UV) {
+			a6l_hv_abort(chip, "overvoltage after request, uV", uv);
+			next = 2000;
+		} else if (time_after(jiffies, chip->hv_deadline)) {
+			a6l_hv_abort(chip, "adapter did not reach the window, uV", uv);
+			next = 2000;
+		} else {
+			next = A6L_HV_FAST_MS;
+		}
+		break;
+	case A6L_HV_ACTIVE:
+		next = A6L_HV_POLL_MS;
+		regmap_read(chip->regmap, chip->base + BATTERY_CHARGER_STATUS_2, &st2);
+		if (uv > chip->hv_target_uv + A6L_HV_WINDOW_UV) {
+			a6l_hv_abort(chip, "overvoltage, uV", uv);
+			break;
+		}
+		chip->hv_bad_v = uv < chip->hv_target_uv - A6L_HV_WINDOW_UV ? chip->hv_bad_v + 1 : 0;
+		if (chip->hv_bad_v >= 3) {
+			a6l_hv_abort(chip, "undervoltage 3x, uV", uv);
+			break;
+		}
+		chip->hv_bad_i = ua > (int)(chip->hv_icl_ua + chip->hv_icl_ua / 10 + 100000) ? chip->hv_bad_i + 1 : 0;
+		if (chip->hv_bad_i >= 2) {
+			a6l_hv_abort(chip, "overcurrent 2x, uA", ua);
+			break;
+		}
+		if (st2 & (CHARGER_ERROR_STATUS_BAT_OV_BIT | BAT_TEMP_STATUS_TOO_HOT_BIT | BAT_TEMP_STATUS_TOO_COLD_BIT)) {
+			a6l_hv_abort(chip, "charger status 2 =", st2);
+			break;
+		}
+		/* keep the ICL at or below hvdcp_icl_ua (runtime changes, or someone else raised it) */
+		regmap_read(chip->regmap, chip->base + USBIN_CURRENT_LIMIT_CFG, &icl_raw);
+		if (icl_raw * CURRENT_SCALE_FACTOR > hvdcp_icl_ua || chip->hv_icl_ua != hvdcp_icl_ua)
+			a6l_hv_set_icl(chip, hvdcp_icl_ua);
+		break;
+	}
+out:
+	if (next && !chip->hv_removing)
+		mod_delayed_work(system_wq, &chip->hvdcp_work, msecs_to_jiffies(next));
+	mutex_unlock(&chip->hv_lock);
+}
+
+static bool a6l_hv_owns_icl(struct smb_chip *chip)
+{
+	return chip->hv_state == A6L_HV_VERIFY || chip->hv_state == A6L_HV_ACTIVE ||
+	       chip->hv_state == A6L_HV_FAILED;
+}
+
+/* unbind / shutdown: return a QC adapter to 5 V */
+static void a6l_hv_teardown(struct smb_chip *chip)
+{
+	mutex_lock(&a6l_hv_param_lock);
+	if (a6l_hv_chip == chip)
+		a6l_hv_chip = NULL;
+	mutex_unlock(&a6l_hv_param_lock);
+	mutex_lock(&chip->hv_lock);
+	chip->hv_removing = true;
+	mutex_unlock(&chip->hv_lock);
+	cancel_delayed_work_sync(&chip->hvdcp_work);
+	mutex_lock(&chip->hv_lock);
+	if (chip->hv_state != A6L_HV_OFF || chip->hv_hw_on) {
+		regmap_write(chip->regmap, chip->base + CMD_HVDCP_2, FORCE_5V_BIT);
+		regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG,
+				   HVDCP_EN_BIT | HVDCP_AUTH_ALG_EN_CFG_BIT |
+				   HVDCP_AUTONOMOUS_MODE_EN_CFG_BIT, 0);
+		dev_info(chip->dev, "A6L_HVDCP teardown: FORCE_5V\n");
+	}
+	mutex_unlock(&chip->hv_lock);
+}
+
+static void a6l_hv_teardown_action(void *data)
+{
+	a6l_hv_teardown(data);
+}
+/* ---- end A6L HVDCP ------------------------------------------------------------------------------------------ */
