+/* No MMIO, object contents, or additional locks; caller holds gpu->lock. */
+static void fault_bo_summary(struct msm_gpu *gpu, struct msm_gem_submit *submit,
+		struct msm_gpu_fault_info *info, const char *comm)
+{
+	phys_addr_t expected_ttbr0 = 0;
+	u64 nearest_lo = 0, nearest_hi = U64_MAX;
+	int lo = -1, hi = -1, asid = -1;
+	unsigned int i;
+
+	if (!fault_bo_log || !info)
+		return;
+
+	if (!submit) {
+		pr_warn("MSM_FAULT_BO no active submit iova=%016lx\n", info->iova);
+		return;
+	}
+
+	msm_iommu_pagetable_params(to_msm_vm(submit->vm)->mmu,
+				  &expected_ttbr0, &asid);
+	pr_warn("MSM_FAULT_BO pid=%d comm=%s seqno=%u ring=%u bos=%u iova=%016lx actual_ttbr0=%016llx expected_ttbr0=%016llx asid=%d\n",
+		pid_nr(submit->pid), comm ?: "unknown", submit->seqno,
+		submit->ring->id, submit->nr_bos, info->iova, info->ttbr0,
+		(u64)expected_ttbr0, asid);
+
+	/* Log the first 16 BOs plus every fault-containing BO. Keep nearest
+	 * bounds even when the address is outside the submitted objects.
+	 */
+	for (i = 0; i < submit->nr_bos; i++) {
+		struct drm_gem_object *obj = submit->bos[i].obj;
+		u64 addr = submit->bos[i].iova;
+		bool contains = info->iova >= addr && info->iova - addr < obj->size;
+
+		if (addr <= info->iova && (lo < 0 || addr > nearest_lo)) {
+			nearest_lo = addr;
+			lo = i;
+		}
+		if (addr > info->iova && addr < nearest_hi) {
+			nearest_hi = addr;
+			hi = i;
+		}
+		if (i < 16 || contains)
+			pr_warn("MSM_FAULT_BO idx=%u iova=%016llx size=%zu flags=%x contains=%d\n",
+				i, addr, obj->size, submit->bos[i].flags, contains);
+	}
+	if (lo >= 0)
+		pr_warn("MSM_FAULT_BO nearest_lo idx=%d iova=%016llx size=%zu offset=%llu\n",
+			lo, nearest_lo, submit->bos[lo].obj->size, info->iova - nearest_lo);
+	if (hi >= 0)
+		pr_warn("MSM_FAULT_BO nearest_hi idx=%d iova=%016llx size=%zu gap=%llu\n",
+			hi, nearest_hi, submit->bos[hi].obj->size, nearest_hi - info->iova);
+}
+
