# Hisense A6L rear e-ink (agent eink3, docs/eink3-20260924.md). Installed as /vendor/etc/init/a6l_eink.rc by a6l_epdd.
#
# vendor.a6l_epdd  : owns the e-ink (DRM lease from the patched composer, rails, library, waveform). Socket a6l_epd.
# vendor.a6l_eink  : mode (persist.vendor.eink.mode, set by vendor.a6l_dualux which owns key 616 since 25 Sep; set
#                    persist.vendor.eink.key_dev=auto to give the key back to the mirror), mirror capture + refresh policy
#                    (persist.vendor.eink.refresh, live), rear touch bridge.
# Neither ever opens /dev/dri/card* before the composer holds DRM master (see a6l_epdd --no-master).

on post-fs-data
    mkdir /data/vendor/epd 0770 system system

on early-boot
    # panel NOR through spidev, read-only, only if the DT has the a6l-eink-flash-read SPI node (harmless otherwise)
    write /sys/bus/spi/devices/spi0.0/driver_override spidev
    write /sys/bus/spi/drivers/spidev/bind spi0.0
    write /sys/bus/spi/devices/spi1.0/driver_override spidev
    write /sys/bus/spi/drivers/spidev/bind spi1.0

on property:init.svc.vendor.hwcomposer-3=running
    start vendor.a6l_epdd
    start vendor.a6l_eink

service vendor.a6l_epdd /vendor/bin/hw/a6l_epdd --socket a6l_epd --no-master --dither ${persist.vendor.eink.dither:-ordered} --lease hwc:a6l.hwc.lease --wait-drm 60 --waveform /mnt/vendor/persist/epd/epd-nor.bin --waveform /data/vendor/epd/epd-nor.bin --nor-spidev auto --waveform-cache /data/vendor/epd/epd-nor.bin --waveform /vendor/etc/epd/epd-nor.bin --lib /vendor/lib64/libtcon_eink.so --idle-off ${persist.vendor.eink.idle_off_s:-30} --wakelock --lead ${persist.vendor.eink.lead:-10} --tail ${persist.vendor.eink.tail:-20} --overlap-gen ${persist.vendor.eink.overlap_gen:-1} --chain ${persist.vendor.eink.chain:-1} --crtc-wakelock ${persist.vendor.eink.crtc_wakelock:-1} --lock-clean ${persist.vendor.eink.lock_clean:-1}
    class hal
    user system
    group system graphics wakelock
    # eink-round4: /sys/power/wake_lock needs CAP_BLOCK_SUSPEND (kernel/power/wakelock.c); without it every update and
    # the 0013 a6l_epdd_crtc lock were EPERM and Android suspended in the middle of an update (6 Oct 17:01:56)
    capabilities BLOCK_SUSPEND
    socket a6l_epd stream 0660 system system
    disabled
    # Display work may use all CPUs; do not confine it to system-background.
    task_profiles ProcessCapacityNormal

service vendor.a6l_eink /vendor/bin/a6l_eink_mirror --source drm --auto-small-regal --wait-prop sys.boot_completed=1 --epd-socket /dev/socket/a6l_epd --interval ${persist.vendor.eink.interval_ms:-100} --clear-every ${persist.vendor.eink.clear_every:-10} --fit ${persist.vendor.eink.fit:-stretch} --key-dev ${persist.vendor.eink.key_dev:-none} --tone ${persist.vendor.eink.tone:-24,232,150} --copy-guard-kib ${persist.vendor.eink.copy_guard_kib:-1024} --guard-max ${persist.vendor.eink.guard_max:-3,400} --benign-flips ${persist.vendor.eink.benign_flips:-1} --pipeline ${persist.vendor.eink.pipeline:-1}
    class hal
    user system
    group system graphics input uhid
    capabilities SYS_ADMIN
    disabled
    task_profiles ProcessCapacityNormal
