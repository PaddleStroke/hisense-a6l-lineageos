<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0. Hisense A6L display switcher (agent dualux, docs/dualux-20260925.md) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.a6l.dualux"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_BRIGHTNESS" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- eink-lockscreen: LCD wallpaper as the e-ink lock-screen background (signature permission, platform-signed app) -->
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />

    <application
        android:name=".DualuxApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_eink"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <provider android:name=".SettingsProvider"
            android:authorities="org.lineageos.a6l.dualux.settings"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- eink-round4: Settings > Display > E-ink tab is the only e-ink settings UI. This invisible activity forwards
             the old entry points there: the SETTINGS action and long-press on any of our Quick Settings tiles. -->
        <activity
            android:name=".SettingsLink"
            android:label="@string/settings_title"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.lineageos.a6l.dualux.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- eink-lockscreen: photo picker for the e-ink lock-screen background, started by Settings > Display > E-ink -->
        <activity
            android:name=".LockImagePickActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service android:name=".DisplayTile" android:label="@string/tile_display" android:icon="@drawable/ic_eink"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>
        <service android:name=".RefreshTile" android:label="@string/tile_refresh" android:icon="@drawable/ic_refresh"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".ClearTile" android:label="@string/tile_clear" android:icon="@drawable/ic_clear"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".FrontlightTile" android:label="@string/tile_frontlight" android:icon="@drawable/ic_frontlight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <receiver android:name=".BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
