# vendor.a6l_eink — mode/key handler, mirror capture + policy, rear touch bridge (eink3, docs/eink3-20260924.md)
type a6l_eink_mirror, domain;
type a6l_eink_mirror_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(a6l_eink_mirror)

# talk to vendor.a6l_epdd
unix_socket_connect(a6l_eink_mirror, a6l_epd, a6l_epdd)

# capture: LCD CRTC planes (GETPLANE/GETFB2 on a plain, never-master card fd; handles need CAP_SYS_ADMIN), PRIME mmap
allow a6l_eink_mirror gpu_device:chr_file rw_file_perms;
allow a6l_eink_mirror self:global_capability_class_set sys_admin;
allow a6l_eink_mirror sysfs:dir r_dir_perms;
allow a6l_eink_mirror sysfs:file r_file_perms;

# e-ink key (gpio-keys, not grabbed) + rear touch (grabbed) + uinput touchscreen for the forwarded rear touches
allow a6l_eink_mirror input_device:dir r_dir_perms;
allow a6l_eink_mirror input_device:chr_file rw_file_perms;
allow a6l_eink_mirror uhid_device:chr_file rw_file_perms;

# mode / reading / transform settings (the key toggle persists the mode) and the published state
set_prop(a6l_eink_mirror, vendor_eink_prop)

# r5 bug hunt eink-display E4: a6l_eink.rc starts the mirror with --wait-prop sys.boot_completed=1 (the DRM card is only
# opened once the composer surely holds master). sys.boot_completed is boot_status_prop (system_restricted_prop), which
# system/sepolicy grants only to coredomain/appdomain/vendor_init: without this the read is denied when enforcing, the
# property reads as "" and the mirror waits for ever (rear screen never mirrors).
get_prop(a6l_eink_mirror, boot_status_prop)

# eink-round5 (6 Oct 21:18 boot, permissive: avc denied { use } scontext=a6l_eink_mirror tcontext=hal_graphics_allocator_default
# tclass=fd, path="/dmabuf:"): the PRIME fd of a scanout buffer (GETFB2 handle -> drmPrimeHandleToFD) is the dma-buf file
# the allocator HAL created; mmap'ing it for the capture needs fd use on the allocator's domain.
allow a6l_eink_mirror hal_graphics_allocator_default:fd use;
# eink-round5: display-transition markers in the kernel log (/dev/kmsg write, as hal_health)
allow a6l_eink_mirror kmsg_device:chr_file w_file_perms;
# eink-round6: /dev/kmsg is 0600 root:root, the markers go through /dev/kmsg_debug (0622 on userdebug builds)
allow a6l_eink_mirror kmsg_debug_device:chr_file w_file_perms;
# selinux-20261010 pass 5 (bms-20261009 log x1): the eink-round10 touch-guard override sys.a6l.eink.touch_guard_ms has
# no property_contexts entry, so it is `sys.` = system_prop, which vendor domains may not read (core_property_type:
# neverallow, system/sepolicy/private/property.te). Denied = prop_int() falls back to the built-in 2000 ms (the value
# used today: nothing sets the override). Silence here; to make the knob work under enforcing, give it an exact entry
# with the type the mirror already reads (sys.a6l.eink.touch_guard_ms -> a6l_eink_animation_prop, exact uint) in
# eink/switcher/sepolicy/system_ext/private/property_contexts at the next system build.
dontaudit a6l_eink_mirror system_prop:file { getattr open read map };
