# vendor.a6l_epdd — owns the rear e-ink (eink3, docs/eink3-20260924.md)
type a6l_epdd, domain;
type a6l_epdd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(a6l_epdd)

# DRM lease from the patched composer: abstract SOCK_SEQPACKET (class unix_stream_socket) + the lessee fd (SCM_RIGHTS).
# The lessee fd is a /dev/dri/card* file opened by the composer; we never open the card ourselves (--no-master).
allow a6l_epdd self:unix_stream_socket create_stream_socket_perms;
allow a6l_epdd hal_graphics_composer_default:unix_stream_socket connectto;
allow a6l_epdd hal_graphics_composer_default:fd use;
allow a6l_epdd gpu_device:chr_file { read write ioctl map getattr };

# control socket (created by init), clients: vendor.a6l_eink
allow a6l_epdd a6l_epd_socket:sock_file rw_file_perms;

# stock software TCON, dlopen'ed from /vendor/lib64 (vendor_file: already allowed for vendor domains)

# rails (epd_power), bring-up status, TPS65185 temperature
allow a6l_epdd sysfs_a6l_epd:dir r_dir_perms;
allow a6l_epdd sysfs_a6l_epd:file rw_file_perms;
allow a6l_epdd sysfs_a6l_epd:lnk_file read;
allow a6l_epdd sysfs:dir r_dir_perms;
allow a6l_epdd sysfs:lnk_file read;
allow a6l_epdd sysfs:file r_file_perms;		# /sys/class/drm/*/modes + connector_id, /sys/class/spidev, hwmon names

# waveform: persist copy (read), /data/vendor cache (rw), panel NOR through spidev (read-only opcodes, enforced in code)
allow a6l_epdd mnt_vendor_file:dir r_dir_perms;
allow a6l_epdd mnt_vendor_file:file r_file_perms;
allow a6l_epdd a6l_epd_data_file:dir create_dir_perms;
allow a6l_epdd a6l_epd_data_file:file create_file_perms;
allow a6l_epdd a6l_epd_spi_device:chr_file rw_file_perms;

# hold a wakelock while a waveform is being driven
wakelock_use(a6l_epdd)

# One-slot nonpersistent debug trace; no socket/data permission changes.
get_prop(a6l_epdd, vendor_a6l_eink_trace_prop)
get_prop(a6l_epdd, build_prop)

# eink-round5 (6 Oct 21:18 boot, permissive): the e-ink connector lookup (sysfs_connector: /sys/class/drm/card*-*/modes,
# connector_id) and the epd_power realpath walk c900000.display-subsystem (sysfs_a6l_drm, rom/sepolicy/vendor/file.te);
# temperature() reads every /sys/class/hwmon/*/name, hwmon12 is the qcom-battery one (sysfs_batteryinfo).
allow a6l_epdd sysfs_a6l_drm:dir r_dir_perms;
allow a6l_epdd sysfs_a6l_drm:file r_file_perms;
allow a6l_epdd sysfs_a6l_drm:lnk_file read;
allow a6l_epdd sysfs_batteryinfo:dir r_dir_perms;
allow a6l_epdd sysfs_batteryinfo:file r_file_perms;
allow a6l_epdd sysfs_batteryinfo:lnk_file read;
# eink-round5: display-transition markers in the kernel log
allow a6l_epdd kmsg_device:chr_file w_file_perms;
# eink-round6: /dev/kmsg is 0600 root:root, the markers go through /dev/kmsg_debug (0622 on userdebug builds)
allow a6l_epdd kmsg_debug_device:chr_file w_file_perms;

# selinux-20261007 (firmware/extracted/selinux-20261007/README.md, group G13): the stock TCON blob libtcon_eink.so
# (dlopen'ed) reads sys.sysctl.GC_New_Refresh -> system_prop (r11 x8). Reading system_prop from a vendor domain is
# neverallowed (system/sepolicy/private/property.te, compatible_property_only) and nothing sets that property on this ROM:
# the blob falls back to its built-in default, as in permissive. Silence instead of granting.
dontaudit a6l_epdd system_prop:file r_file_perms;
# temperature() reads every /sys/class/hwmon/*/name: thermal-zone hwmon devices live under /sys/devices/virtual/thermal,
# which rom/r6/sepolicy/vendor/genfs_contexts now labels sysfs_thermal (was generic sysfs, readable above)
r_dir_file(a6l_epdd, sysfs_thermal)
# selinux-20261007 pass 2: the e-ink/LCD connector scans fopen /sys/class/drm/<every entry>/modes, including the GPU's
# card0/renderD128 (5000000.gpu = sysfs_gpu since pass 1; was generic sysfs): path search only
allow a6l_epdd sysfs_gpu:dir search;
