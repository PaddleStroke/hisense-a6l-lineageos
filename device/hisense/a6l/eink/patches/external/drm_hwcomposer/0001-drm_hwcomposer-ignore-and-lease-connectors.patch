+namespace android::drm_hwcomposer {
+
+namespace {
+// Only compared by address: marks CRTCs/planes that belong to a lease.
+const char kLeaseTag = 0;
+auto LeasePipelineTag() -> const DrmDisplayPipeline * {
+  // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
+  return reinterpret_cast<const DrmDisplayPipeline *>(&kLeaseTag);
+}
+constexpr uid_t kUidRoot = 0;
+constexpr uid_t kUidSystem = 1000;
+constexpr uid_t kUidGraphics = 1003;
+}  // namespace
+
+auto LeaseServer::Start(ResourceManager &res_man,
+                        const std::string &socket_name)
+    -> std::unique_ptr<LeaseServer> {
+  sockaddr_un addr{};
+  if (socket_name.empty() || socket_name.size() + 1 > sizeof(addr.sun_path)) {
+    ALOGE("LeaseServer: bad socket name '%s'", socket_name.c_str());
+    return {};
+  }
+  const int lfd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+  if (lfd < 0) {
+    ALOGE("LeaseServer: socket: %s", strerror(errno));
+    return {};
+  }
+  addr.sun_family = AF_UNIX;
+  addr.sun_path[0] = '\0'; /* abstract namespace: no file, no init socket */
+  memcpy(&addr.sun_path[1], socket_name.data(), socket_name.size());
+  const auto len = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + 1 +
+                                          socket_name.size());
+  // NOLINTNEXTLINE(cppcoreguidelines-pro-type-reinterpret-cast)
+  if (bind(lfd, reinterpret_cast<sockaddr *>(&addr), len) != 0 ||
+      listen(lfd, 2) != 0) {
+    ALOGE("LeaseServer: bind/listen @%s: %s", socket_name.c_str(),
+          strerror(errno));
+    close(lfd);
+    return {};
+  }
+  const int sfd = eventfd(0, EFD_CLOEXEC);
+  if (sfd < 0) {
+    close(lfd);
+    return {};
+  }
+  auto server = std::unique_ptr<LeaseServer>(
+      new LeaseServer(res_man, lfd, sfd));
+  server->thread_ = std::thread(&LeaseServer::Run, server.get());
+  ALOGI("LeaseServer: listening on @%s", socket_name.c_str());
+  return server;
+}
+
+LeaseServer::LeaseServer(ResourceManager &res_man, int listen_fd, int stop_fd)
+    : res_man_(res_man), listen_fd_(listen_fd), stop_fd_(stop_fd) {
+}
+
+LeaseServer::~LeaseServer() {
+  const uint64_t one = 1;
+  if (write(stop_fd_, &one, sizeof(one)) != sizeof(one)) {
+    ALOGE("LeaseServer: stop signal failed");
+  }
+  if (thread_.joinable())
+    thread_.join();
+  {
+    const std::unique_lock lock(res_man_.GetMainLock());
+    while (!held_.empty())
+      ReleaseLocked(held_.begin()->first);
+  }
+  close(listen_fd_);
+  close(stop_fd_);
+}
+
+void LeaseServer::Run() {
+  for (;;) {
+    pollfd fds[2] = {{listen_fd_, POLLIN, 0}, {stop_fd_, POLLIN, 0}};
+    if (poll(fds, 2, -1) < 0) {
+      if (errno == EINTR)
+        continue;
+      ALOGE("LeaseServer: poll: %s", strerror(errno));
+      return;
+    }
+    if ((fds[1].revents & POLLIN) != 0)
+      return;
+    if ((fds[0].revents & POLLIN) == 0)
+      continue;
+    const int cfd = accept4(listen_fd_, nullptr, nullptr, SOCK_CLOEXEC);
+    if (cfd < 0)
+      continue;
+    Serve(cfd);
+    close(cfd);
+  }
+}
+
+void LeaseServer::Serve(int client_fd) {
+  ucred cred{};
+  socklen_t clen = sizeof(cred);
+  std::string reply;
+  int lease_fd = -1;
+  char req[64] = {};
+
+  if (getsockopt(client_fd, SOL_SOCKET, SO_PEERCRED, &cred, &clen) != 0 ||
+      (cred.uid != kUidRoot && cred.uid != kUidSystem &&
+       cred.uid != kUidGraphics)) {
+    ALOGE("LeaseServer: refusing uid %d pid %d", cred.uid, cred.pid);
+    reply = "ERR permission denied";
+  } else {
+    pollfd p = {client_fd, POLLIN, 0};
+    const ssize_t n = poll(&p, 1, 2000) == 1
+                          ? recv(client_fd, req, sizeof(req) - 1, 0)
+                          : -1;
+    unsigned long conn_id = 0;
+    char *end = nullptr;
+    if (n > 6 && strncmp(req, "LEASE ", 6) == 0) {
+      conn_id = strtoul(&req[6], &end, 10);
+    }
+    if (conn_id == 0 || end == &req[6]) {
+      reply = "ERR bad request";
+    } else {
+      const std::unique_lock lock(res_man_.GetMainLock());
+      lease_fd = CreateLease(static_cast<uint32_t>(conn_id), reply);
+    }
+    ALOGI("LeaseServer: pid %d uid %d: %s", cred.pid, cred.uid, reply.c_str());
+  }
+
+  iovec iov = {reply.data(), reply.size()};
+  msghdr msg{};
+  msg.msg_iov = &iov;
+  msg.msg_iovlen = 1;
+  alignas(cmsghdr) char cbuf[CMSG_SPACE(sizeof(int))] = {};
+  if (lease_fd >= 0) {
+    msg.msg_control = cbuf;
+    msg.msg_controllen = sizeof(cbuf);
+    cmsghdr *c = CMSG_FIRSTHDR(&msg);
+    c->cmsg_level = SOL_SOCKET;
+    c->cmsg_type = SCM_RIGHTS;
+    c->cmsg_len = CMSG_LEN(sizeof(int));
+    memcpy(CMSG_DATA(c), &lease_fd, sizeof(int));
+  }
+  if (sendmsg(client_fd, &msg, MSG_NOSIGNAL) < 0) {
+    ALOGE("LeaseServer: sendmsg: %s", strerror(errno));
+  }
+  if (lease_fd >= 0)
+    close(lease_fd); /* the client owns its copy now; the lease lives on */
+}
+
+void LeaseServer::ReleaseLocked(uint32_t connector_id) {
+  auto it = held_.find(connector_id);
+  if (it == held_.end())
+    return;
+  /* ENOENT when the lessee already closed its fd: the kernel ended it */
+  drmModeRevokeLease(*it->second.dev->GetFd(), it->second.lessee_id);
+  held_.erase(it); /* drops the placeholder bindings */
+}
+
+auto LeaseServer::CreateLease(uint32_t connector_id, std::string &reply)
+    -> int {
+  DrmConnector *conn = nullptr;
+  for (auto &drm : res_man_.GetDrmDevices()) {
+    for (const auto &c : drm->GetConnectors()) {
+      if (c->GetId() == connector_id)
+        conn = c.get();
+    }
+  }
+  if (conn == nullptr) {
+    reply = "ERR no such connector";
+    return -1;
+  }
+  if (!res_man_.IsConnectorIgnored(*conn)) {
+    reply = "ERR connector " + conn->GetName() +
+            " is not in vendor.hwc.drm.ignore_connectors";
+    return -1;
+  }
+  ReleaseLocked(connector_id);
+
+  auto &dev = conn->GetDev();
+  Held held;
+  held.dev = &dev;
+  for (const auto &enc : dev.GetEncoders()) {
+    if (held.crtc || !conn->SupportsEncoder(*enc))
+      continue;
+    for (const auto &crtc : dev.GetCrtcs()) {
+      if (enc->SupportsCrtc(*crtc)) {
+        held.crtc = crtc->BindPipeline(LeasePipelineTag());
+        if (held.crtc)
+          break;
+      }
+    }
+  }
+  if (!held.crtc) {
+    reply = "ERR no free CRTC for " + conn->GetName();
+    return -1;
+  }
+  std::vector<uint32_t> objs = {conn->GetId(), held.crtc->Get()->GetId()};
+  std::string plane_list;
+  for (const auto &plane : dev.GetPlanes()) {
+    if (plane->GetType() != DRM_PLANE_TYPE_PRIMARY ||
+        !plane->IsCrtcSupported(*held.crtc->Get()))
+      continue;
+    auto owner = plane->BindPipeline(LeasePipelineTag());
+    if (!owner)
+      continue; /* in use by a display pipeline */
+    objs.emplace_back(plane->GetId());
+    plane_list += (plane_list.empty() ? "" : ",") +
+                  std::to_string(plane->GetId());
+    held.planes.emplace_back(std::move(owner));
+  }
+  if (held.planes.empty()) {
+    reply = "ERR no free primary plane";
+    return -1;
+  }
+
+  uint32_t lessee_id = 0;
+  const int lfd = drmModeCreateLease(*dev.GetFd(), objs.data(),
+                                     static_cast<int>(objs.size()), O_CLOEXEC,
+                                     &lessee_id);
+  if (lfd < 0) {
+    reply = std::string("ERR drmModeCreateLease: ") + strerror(errno);
+    return -1;
+  }
+  held.lessee_id = lessee_id;
+  reply = "OK lessee=" + std::to_string(lessee_id) +
+          " connector=" + std::to_string(conn->GetId()) +
+          " crtc=" + std::to_string(held.crtc->Get()->GetId()) +
+          " planes=" + plane_list;
+  held_[connector_id] = std::move(held);
+  return lfd;
+}
+
+}  // namespace android::drm_hwcomposer
