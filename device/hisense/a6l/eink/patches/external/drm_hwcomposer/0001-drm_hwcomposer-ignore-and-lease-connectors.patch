+auto ResourceManager::IsConnectorIgnored(DrmConnector &conn) const -> bool {
+  for (const auto &entry : ignored_connectors_) {
+    if (entry == conn.GetName())
+      return true;
+    unsigned w = 0;
+    unsigned h = 0;
+    // NOLINTNEXTLINE(cert-err34-c)
+    if (sscanf(entry.c_str(), "mode:%ux%u", &w, &h) == 2) {
+      for (const auto &mode : conn.GetModes()) {
+        if (mode.GetRawMode().hdisplay == w && mode.GetRawMode().vdisplay == h)
+          return true;
+      }
+    }
+  }
+  return false;
+}
