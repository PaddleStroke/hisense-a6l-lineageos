+/**
+ * Connectors that must never become displays (comma separated). Each entry is
+ * a connector name ("DSI-2") or "mode:<W>x<H>" (any connector offering that
+ * mode), e.g. the Hisense A6L rear e-ink: "mode:384x725". Such connectors can
+ * be handed to a trusted client as a DRM lease, see LeaseSocketName().
+ */
+auto Properties::IgnoredConnectors() -> std::string {
+  char buf[PROPERTY_VALUE_MAX] = {};
+  property_get("vendor.hwc.drm.ignore_connectors", buf, "");
+  return {buf};
+}
+
+/**
+ * Abstract AF_UNIX socket name for the DRM lease server (empty = disabled).
+ */
+auto Properties::LeaseSocketName() -> std::string {
+  char buf[PROPERTY_VALUE_MAX] = {};
+  property_get("vendor.hwc.drm.lease_socket", buf, "");
+  return {buf};
+}
+
 auto Properties::DropDrmMasterAfterInit() -> bool {
