+namespace android::drm_hwcomposer {
+
+class DrmConnector;
+class DrmCrtc;
+class DrmDevice;
+class DrmPlane;
+class ResourceManager;
+
+/*
+ * Connectors listed in vendor.hwc.drm.ignore_connectors are never attached as
+ * displays. When vendor.hwc.drm.lease_socket is set as well, this server hands
+ * a DRM lease of such a connector (plus a free CRTC and the free primary
+ * planes that can feed it) to one trusted client (uid root/system/graphics)
+ * over an abstract AF_UNIX SOCK_SEQPACKET socket.
+ *
+ * Protocol (one packet each way):
+ *   client: "LEASE <connector-id>"
+ *   server: "OK lessee=<id> connector=<id> crtc=<id> planes=<id>[,<id>...]"
+ *           + the lessee fd as SCM_RIGHTS, or "ERR <reason>".
+ * A new request for the same connector revokes the previous lease first, so a
+ * restarted client always gets a fresh one. Leased CRTCs/planes stay bound to
+ * a placeholder pipeline so the composer never uses them itself.
+ */
+class LeaseServer {
+ public:
+  static auto Start(ResourceManager &res_man, const std::string &socket_name)
+      -> std::unique_ptr<LeaseServer>;
+  ~LeaseServer();
+  LeaseServer(const LeaseServer &) = delete;
+  LeaseServer &operator=(const LeaseServer &) = delete;
+
+ private:
+  LeaseServer(ResourceManager &res_man, int listen_fd, int stop_fd);
+  void Run();
+  void Serve(int client_fd);
+  auto CreateLease(uint32_t connector_id, std::string &reply) -> int;
+  void ReleaseLocked(uint32_t connector_id);
+
+  struct Held {
+    DrmDevice *dev{};
+    uint32_t lessee_id{};
+    std::shared_ptr<BindingOwner<DrmCrtc>> crtc;
+    std::vector<std::shared_ptr<BindingOwner<DrmPlane>>> planes;
+  };
+
+  ResourceManager &res_man_;
+  const int listen_fd_;
+  const int stop_fd_;
+  std::map<uint32_t, Held> held_;
+  std::thread thread_;
+};
+
+}  // namespace android::drm_hwcomposer
