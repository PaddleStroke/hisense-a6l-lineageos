+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <optional>
+#include <stdint.h>
+namespace libcamera {
+class FrameBuffer;
+/* Single shared statistics block: only its acknowledged consumer may retire
+ * the producer's ownership. Trusted stop joins/drains before clearAfterDrain().
+ * Stopped isolated instances cannot restart or reuse their shared block. */
+class StatsOwnership
+{
+public:
+ bool running() const { return running_; }
+ bool busy() const { return active_.has_value(); }
+ void start() { running_ = true; }
+ void halt() { running_ = false; }
+ void clearAfterDrain() { active_.reset(); }
+ bool begin(uint32_t frame, FrameBuffer *output) {
+  if (!running_ || active_) return false;
+  active_ = Job{frame, output, false}; return true;
+ }
+ bool matches(uint32_t frame) const {
+  return running_ && active_ && active_->frame == frame;
+ }
+ bool publish(uint32_t frame) {
+  if (!matches(frame) || active_->published) return false;
+  active_->published = true; return true;
+ }
+ bool acknowledge(uint32_t frame) {
+  if (!matches(frame) || !active_->published) return false;
+  active_.reset(); return true;
+ }
+ std::optional<uint32_t> fail(FrameBuffer *output) {
+  if (!running_ || !active_ || active_->output != output || active_->published) return std::nullopt;
+  uint32_t frame = active_->frame; active_.reset(); return frame;
+ }
+private:
+ struct Job { uint32_t frame; FrameBuffer *output; bool published; };
+ bool running_ = false;
+ std::optional<Job> active_;
+};
+} /* namespace libcamera */
