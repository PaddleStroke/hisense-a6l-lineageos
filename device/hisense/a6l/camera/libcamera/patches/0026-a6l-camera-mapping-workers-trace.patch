+/* Confined to the serialized Debayer thread. CPU ownership is still managed
+ * separately by a per-frame DmaSyncer; a live mapping does not grant access.
+ * Equal numeric FDs are safe keys only because every entry retains SharedFD
+ * ownership. Neither FrameBuffer pointers nor image/metadata are retained. */
+class A6LFrameMappingCache
+{
+public:
+	class Entry {
+	public:
+		const MappedFrameBuffer &mapping() const { return *mapping_; }
+	private:
+		friend class A6LFrameMappingCache;
+		Entry(const FrameBuffer &buffer, MappedFrameBuffer::MapFlags flags)
+			: planes_(buffer.planes().begin(), buffer.planes().end()),
+			  mapping_(std::make_unique<MappedFrameBuffer>(&buffer, flags)) {}
+		bool matches(const FrameBuffer &buffer) const
+		{
+			const auto planes = buffer.planes();
+			if (planes.size() != planes_.size())
+				return false;
+			for (size_t i = 0; i < planes.size(); ++i)
+				if (planes[i].fd != planes_[i].fd ||
+				    planes[i].offset != planes_[i].offset ||
+				    planes[i].length != planes_[i].length)
+					return false;
+			return true;
+		}
+		/* Declaration order ensures mapping is destroyed before FD owners. */
+		std::vector<FrameBuffer::Plane> planes_;
+		std::unique_ptr<MappedFrameBuffer> mapping_;
+	};
+	using Lease = std::shared_ptr<const Entry>;
+
+	explicit A6LFrameMappingCache(MappedFrameBuffer::MapFlags flags,
+				    size_t capacity = 8)
+		: flags_(flags), capacity_(capacity) {}
+
+	Lease get(const FrameBuffer &buffer, bool *hit = nullptr)
+	{
+		if (hit)
+			*hit = false;
+		/* DMA-BUF sizes are immutable, but preserve current bounds checking
+		 * for generic test/import descriptors too. Never reuse a shrunken
+		 * or invalid backing allocation. This does not guess dup aliases. */
+		if (!validBacking(buffer)) {
+			for (auto it = entries_.begin(); it != entries_.end();)
+				if ((*it)->matches(buffer))
+					it = entries_.erase(it);
+				else
+					++it;
+			return {};
+		}
+		for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+			if ((*it)->matches(buffer)) {
+				auto entry = *it;
+				entries_.splice(entries_.begin(), entries_, it);
+				if (hit)
+					*hit = true;
+				return entry;
+			}
+		}
+		std::shared_ptr<Entry> entry(new Entry(buffer, flags_));
+		if (!entry->mapping().isValid())
+			return {};
+		if (capacity_) {
+			entries_.push_front(entry);
+			while (entries_.size() > capacity_)
+				entries_.pop_back();
+		}
+		/* The current job's lease remains valid even if an entry is evicted.
+		 * The serialized owner must release its leases before session clear. */
+		return entry;
+	}
+	void clear() { entries_.clear(); }
+	size_t size() const { return entries_.size(); }
+private:
+	static bool validBacking(const FrameBuffer &buffer)
+	{
+		const auto planes = buffer.planes();
+		if (planes.empty())
+			return false;
+		for (size_t i = 0; i < planes.size(); ++i) {
+			const auto &plane = planes[i];
+			if (!plane.fd.isValid())
+				return false;
+			/* The retained mapper adds these unsigned-int fields before
+			 * promoting. Reject its arithmetic overflow before mapping. */
+			const uint64_t end = static_cast<uint64_t>(plane.offset) + plane.length;
+			if (end > std::numeric_limits<unsigned int>::max())
+				return false;
+			const off_t length = lseek(plane.fd.get(), 0, SEEK_END);
+			if (length < 0 || end > static_cast<uint64_t>(length))
+				return false;
+		}
+		return true;
+	}
+	const MappedFrameBuffer::MapFlags flags_;
+	const size_t capacity_;
+	std::list<std::shared_ptr<Entry>> entries_;
+};
+} /* namespace libcamera */
