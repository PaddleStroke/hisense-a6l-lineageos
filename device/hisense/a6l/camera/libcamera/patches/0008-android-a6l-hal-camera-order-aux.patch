From: A6L <a6l@localhost>
Subject: [PATCH] android: A6L deterministic camera IDs (camera_hal.yaml "order") and "aux" cameras

libcamera assigns Android camera IDs in sensor probe order, which is not stable on the A6L
(t37: imx576, hi846, s5k3t1 on one boot). Cameras found during CameraManager::start() are
now added sorted by the optional HAL configuration key "order"; a camera marked "aux: true"
is only exposed after a non-aux camera with the same facing, so the hi846 wide camera can
never be Android camera 0 nor the torch owner (first BACK camera).
---
diff --git a/src/android/camera_hal_config.cpp b/src/android/camera_hal_config.cpp
index 3631cb7..d370a3c 100644
--- a/src/android/camera_hal_config.cpp
+++ b/src/android/camera_hal_config.cpp
@@ -6,6 +6,7 @@
  */
 #include "camera_hal_config.h"
 
+#include <optional>
 #include <stdlib.h>
 #include <string>
 
@@ -106,6 +107,26 @@ int CameraHalConfig::Private::parseCameraConfigData(const std::string &cameraId,
 	if (parseRotation(cameraObject, cameraConfigData))
 		return -EINVAL;
 
+	/* A6L: optional property "order" (non-negative integer) */
+	if (cameraObject.contains("order")) {
+		int32_t order = cameraObject["order"].get<int32_t>(-1);
+		if (order < 0) {
+			LOG(HALConfig, Error) << "Invalid order for " << cameraId;
+			return -EINVAL;
+		}
+		cameraConfigData.order = order;
+	}
+
+	/* A6L: optional property "aux" (boolean) */
+	if (cameraObject.contains("aux")) {
+		std::optional<bool> aux = cameraObject["aux"].get<bool>();
+		if (!aux) {
+			LOG(HALConfig, Error) << "Invalid aux for " << cameraId;
+			return -EINVAL;
+		}
+		cameraConfigData.aux = *aux;
+	}
+
 	return 0;
 }
 
