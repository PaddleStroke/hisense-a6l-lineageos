+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Bounded opt-in stage timings. Sampled row sums are not whole-frame costs. */
+#pragma once
+#include <array>
+#include <utility>
+#include "libcamera/internal/a6l_quality_debug.h"
+namespace libcamera {
+inline bool a6lStageProfileEnabled(uint32_t frame)
+{
+ return a6lQualityDebug(frame) && frame % 16 == 0;
+}
+class A6LStageProfile {
+public:
+ enum Stage { Copy, Stats, Debayer, Nv12, DmaBegin, Lut, Map, Resample, WorkerWait, DmaEnd, Total, Count };
+ using Clock = uint64_t (*)();
+ explicit A6LStageProfile(bool enabled, Clock clock = a6lQualityMonotonicNs)
+  : enabled_(false), clock_(clock) { setEnabled(enabled); }
+ void setEnabled(bool enabled) {
+  enabled_ = enabled;
+  if (enabled_) { ns_.fill(0); calls_.fill(0); }
+ }
+ bool enabled() const { return enabled_; }
+ uint64_t start() const { return enabled_ ? clock_() : 0; }
+ void add(Stage stage, uint64_t start) {
+  if (!enabled_) return;
+  const uint64_t end = clock_();
+  ns_[stage] += end >= start ? end - start : 0;
+  calls_[stage]++;
+ }
+ template<typename Function> void measure(Stage stage, bool sample, Function &&function) {
+  if (!enabled_ || !sample) { std::forward<Function>(function)(); return; }
+  const uint64_t begin = clock_();
+  std::forward<Function>(function)();
+  add(stage, begin);
+ }
+ uint64_t ns(Stage stage) const { return enabled_ ? ns_[stage] : 0; }
+ uint64_t calls(Stage stage) const { return enabled_ ? calls_[stage] : 0; }
+private:
+ bool enabled_;
+ Clock clock_;
+ /* Deliberately not initialized/reset while disabled; never read then. */
+ std::array<uint64_t, Count> ns_;
+ std::array<uint64_t, Count> calls_;
+};
+} /* namespace libcamera */
