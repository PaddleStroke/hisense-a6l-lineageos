From 689b188575e5dd2995f3b360e2c0dfe531da242c Mon Sep 17 00:00:00 2001
From: a6l <a6l@local>
Date: Tue, 29 Sep 2026 19:42:34 +0200
Subject: [PATCH] a6l 0006 hi846: sensor helper, sensor delays, uncalibrated
 simple-IPA tuning

The first on-phone libcamera run (t37) warned 'Failed to create camera sensor helper for hi846' and
'No sensor delays found in static properties' and fell back to uncalibrated.yaml. Add a Hi-846 helper
(gain = 1 + code/16, black level 64 @ 10 bit), conservative 2-frame sensor delays and hi846.yaml.
---
 src/ipa/libipa/camera_sensor_helper.cpp       | 15 +++++++++++++++
 src/ipa/simple/data/hi846.yaml                | 19 +++++++++++++++++++
 src/ipa/simple/data/meson.build               |  1 +
 .../sensor/camera_sensor_properties.cpp       |  8 +++++++-
 4 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 src/ipa/simple/data/hi846.yaml

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 743c708..3d269ad 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -530,6 +530,21 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("hm1246", CameraSensorHelperHm1246)
 
+/*
+ * A6L: SK Hynix Hi-846 (8 MP wide, mainline hi846 driver, V4L2 gain = register 0x0077, 0..240).
+ * Hynix analogue gain: gain = 1 + code / 16 (1x..16x). Black level 64 at 10 bits.
+ */
+class CameraSensorHelperHi846 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperHi846()
+	{
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 16, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("hi846", CameraSensorHelperHi846)
+
 class CameraSensorHelperImx214 : public CameraSensorHelper
 {
 public:
diff --git a/src/ipa/simple/data/hi846.yaml b/src/ipa/simple/data/hi846.yaml
new file mode 100644
index 0000000..e1d8102
--- /dev/null
+++ b/src/ipa/simple/data/hi846.yaml
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: CC0-1.0
+# Hisense A6L hi846 (8 MP wide) tuning for the libcamera simple IPA (SoftISP). Phase 1 = uncalibrated:
+# black level from the CameraSensorHelper (64 @ 10 bit), grey-world AWB, AGC, gamma/contrast.
+# CCM is left disabled until measured (colour chart shot or stock chromatix decode, docs/libcamera-plan-20260929.md s.6).
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  # - Ccm:
+  #     ccms:
+  #       - ct: 6500
+  #         ccm: [ 1, 0, 0,
+  #                0, 1, 0,
+  #                0, 0, 1 ]
+  - Adjust:
+  - Agc:
+...
diff --git a/src/ipa/simple/data/meson.build b/src/ipa/simple/data/meson.build
index f8d59c8..d0919f4 100644
--- a/src/ipa/simple/data/meson.build
+++ b/src/ipa/simple/data/meson.build
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: CC0-1.0
 
 conf_files = files([
+    'hi846.yaml',
     'imx576_a6l.yaml',
     's5k3t1.yaml',
     'uncalibrated.yaml',
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index 8c3e89f..6779c66 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -149,7 +149,13 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				 * 9: "Resolution Pattern"
 				 */
 			},
-			.sensorDelays = { },
+			/* A6L: conservative, no grouped hold (as imx576_a6l/s5k3t1) */
+			.sensorDelays = {
+				.exposureDelay = 2,
+				.gainDelay = 2,
+				.vblankDelay = 2,
+				.hblankDelay = 2
+			},
 		} },
 		{ "hm1246", {
 			.unitCellSize = { 3000, 3000 },
-- 
2.43.0

