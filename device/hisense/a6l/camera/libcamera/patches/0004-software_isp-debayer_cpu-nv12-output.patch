 	LookupTable gammaLut_;
 	bool ccmEnabled_;
+	bool yuvOutput_ = false; /* A6L: NV12 output (RGB888 debayer + per line-pair conversion) */
 	DebayerParams params_;
 
 	debayerFn debayer0_;
