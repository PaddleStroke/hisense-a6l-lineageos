From: A6L port maintainers
Subject: [PATCH] android: import minigbm planes and copy aligned NV12 output

Minigbm handles carry dup plane FDs and optionally a metadata FD. Import the
validated image layout instead of treating every descriptor as an image plane.
Use internal ISP buffers and the actual destination stride for NV12; import
JPEG BLOB as its own output format. Reject bad layouts without killing provider.

diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -792,6 +792,22 @@
 		}
 	}
 
+	/*
+	 * A6L's software ISP writes its configured packed stride. minigbm NV12
+	 * uses Venus row/scanline alignment, so produce into internal buffers
+	 * and let the YUV processor copy to each Android buffer's actual layout.
+	 */
+	for (auto &streamConfig : streamConfigs) {
+		if (streamConfig.config.pixelFormat != formats::NV12)
+			continue;
+		for (auto &stream : streamConfig.streams) {
+			if (stream.type == CameraStream::Type::Direct) {
+				stream.type = CameraStream::Type::Internal;
+				stream.stream->usage |= GRALLOC_USAGE_SW_WRITE_OFTEN;
+			}
+		}
+	}
+
 	sortCamera3StreamConfigs(streamConfigs, jpegStream);
 	for (const auto &streamConfig : streamConfigs) {
 		config->addConfiguration(streamConfig.config);
@@ -894,15 +910,16 @@
 {
 	CameraBuffer buf(camera3buffer, pixelFormat, size, PROT_READ);
 	if (!buf.isValid()) {
-		LOG(HAL, Fatal) << "Failed to create CameraBuffer";
+		LOG(HAL, Error) << "Failed to create CameraBuffer";
 		return nullptr;
 	}
 
 	std::vector<FrameBuffer::Plane> planes(buf.numPlanes());
 	for (size_t i = 0; i < buf.numPlanes(); ++i) {
-		SharedFD fd{ camera3buffer->data[i] };
+		const size_t fdIndex = camera3buffer->numFds == 1 ? 0 : i;
+		SharedFD fd{ camera3buffer->data[fdIndex] };
 		if (!fd.isValid()) {
-			LOG(HAL, Fatal) << "No valid fd";
+			LOG(HAL, Error) << "No valid fd";
 			return nullptr;
 		}
 
