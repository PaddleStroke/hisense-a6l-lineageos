+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
+#include <libyuv/scale.h>
+#include <libyuv/scale_uv.h>
+
+/* One persistent UV worker; the caller scales Y. CameraStream stops its
+ * PostProcessorWorker before destroying the processor and this helper. Both
+ * planes finish before processComplete releases their source/destination.
+ * Unsupported geometry uses the original serial NV12Scale path. */
+class A6lParallelNv12
+{
+public:
+	A6lParallelNv12() : thread_([this] { run(); }) {}
+	~A6lParallelNv12()
+	{
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			stopped_ = true;
+		}
+		cv_.notify_all();
+		thread_.join();
+	}
+
+	int scale(const uint8_t *y, int ys, const uint8_t *uv, int uvs,
+		  int sw, int sh, uint8_t *dy, int dys, uint8_t *duv, int duvs,
+		  int dw, int dh, libyuv::FilterMode filter)
+	{
+		/* Also serialize callers if a future CameraStream gains concurrency. */
+		std::lock_guard<std::mutex> callerLock(callerMutex_);
+		if (!y || !uv || !dy || !duv || sw < 2 || sh < 2 || dw < 2 || dh < 2 ||
+		    sw > 32768 || sh > 32768 || dw > 32768 || dh > 32768 ||
+		    ((sw | sh | dw | dh) & 1))
+			return libyuv::NV12Scale(y, ys, uv, uvs, sw, sh,
+					 dy, dys, duv, duvs, dw, dh, filter);
+		{
+			std::lock_guard<std::mutex> lock(mutex_);
+			job_ = { uv, uvs, sw / 2, sh / 2,
+				 duv, duvs, dw / 2, dh / 2, filter };
+			pending_ = true;
+		}
+		cv_.notify_all();
+		int yResult = libyuv::ScalePlane(y, ys, sw, sh, dy, dys, dw, dh, filter);
+		std::unique_lock<std::mutex> lock(mutex_);
+		cv_.wait(lock, [this] { return !pending_; });
+		/* UV has finished even when Y returned an error; no late writes. */
+		job_ = {};
+		return yResult ? yResult : uvResult_;
+	}
+
+private:
+	struct Job {
+		const uint8_t *source = nullptr;
+		int sourceStride = 0, sourceWidth = 0, sourceHeight = 0;
+		uint8_t *destination = nullptr;
+		int destinationStride = 0, destinationWidth = 0, destinationHeight = 0;
+		libyuv::FilterMode filter = libyuv::kFilterNone;
+	};
+	void run()
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+		for (;;) {
+			cv_.wait(lock, [this] { return pending_ || stopped_; });
+			if (stopped_)
+				return;
+			const Job job = job_;
+			lock.unlock();
+			int result = libyuv::UVScale(job.source, job.sourceStride,
+				job.sourceWidth, job.sourceHeight, job.destination,
+				job.destinationStride, job.destinationWidth,
+				job.destinationHeight, job.filter);
+			lock.lock();
+			uvResult_ = result;
+			pending_ = false;
+			cv_.notify_all();
+		}
+	}
+	std::mutex callerMutex_;
+	std::mutex mutex_;
+	std::condition_variable cv_;
+	Job job_;
+	bool pending_ = false;
+	bool stopped_ = false;
+	int uvResult_ = 0;
+	/* Start the thread only after all state it uses has been initialized. */
+	std::thread thread_;
+};
