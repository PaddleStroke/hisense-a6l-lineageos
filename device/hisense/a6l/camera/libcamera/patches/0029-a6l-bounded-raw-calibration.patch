--- /dev/null
+++ b/include/libcamera/internal/a6l_raw10_diagnostic.h
@@ -0,0 +1,118 @@
+#pragma once
+
+// Isolated calibration analyzer, NOT integrated into the camera pipeline.
+// Input must already be protected by its existing READ lease/sync lifetime.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace a6l::calibration {
+enum class Colour : unsigned { R, Gr, Gb, B };
+enum class Order : unsigned { BGGR, GBRG, GRBG, RGGB };
+
+struct Channel {
+    std::array<uint32_t, 1024> histogram{};
+    uint64_t count = 0, sum = 0, sumSquares = 0;
+    uint32_t saturated = 0, nearSaturated = 0;
+    uint16_t minimum = 1023, maximum = 0;
+    void add(uint16_t value)
+    {
+        ++histogram[value]; ++count; sum += value;
+        sumSquares += uint64_t(value) * value;
+        saturated += value == 1023;
+        nearSaturated += value >= 1019;
+        if (value < minimum) minimum = value;
+        if (value > maximum) maximum = value;
+    }
+    uint16_t percentile(unsigned percent) const
+    {
+        if (!count || percent > 100) return 0;
+        const uint64_t target = (count * percent + 99) / 100;
+        uint64_t seen = 0;
+        for (unsigned i = 0; i < histogram.size(); ++i) {
+            seen += histogram[i];
+            if (seen >= (target ? target : 1)) return i;
+        }
+        return 1023;
+    }
+};
+struct Region {
+    std::array<Channel, 4> channels{};
+    unsigned x = 0, y = 0, width = 0, height = 0;
+};
+struct Report {
+    // At most128x128 Bayer cells in the global grid; center/corners each32x32.
+    // Regions have distinct statistics; overlapping tiles aren't merged.
+    Region grid;
+    std::array<Region, 5> tiles{};
+    unsigned stepXCells = 0, stepYCells = 0;
+    uint64_t requiredBytes = 0;
+};
+
+inline Colour colourAt(Order order, unsigned x, unsigned y)
+{
+    // Gr/Gb name the green on the row containing R/B respectively.
+    constexpr Colour patterns[4][4] = {
+        {Colour::B, Colour::Gb, Colour::Gr, Colour::R},
+        {Colour::Gb, Colour::B, Colour::R, Colour::Gr},
+        {Colour::Gr, Colour::R, Colour::B, Colour::Gb},
+        {Colour::R, Colour::Gr, Colour::Gb, Colour::B}
+    };
+    return patterns[static_cast<unsigned>(order)][(y & 1) * 2 + (x & 1)];
+}
+
+inline uint16_t unpack(std::span<const uint8_t> input, unsigned stride,
+                       unsigned x, unsigned y)
+{
+    const size_t base = size_t(y) * stride + size_t(x / 4) * 5;
+    return uint16_t(input[base + x % 4]) * 4 +
+           ((input[base + 4] >> (2 * (x % 4))) & 3);
+}
+
+inline bool analyze(std::span<const uint8_t> input, unsigned width,
+                    unsigned height, unsigned stride, Order order, Report &out)
+{
+    // Bounded validation precedes every read. Reject unknown layouts rather
+    // than interpreting generic RAW, padding, optical black or sensor crop.
+    if (static_cast<unsigned>(order) > 3 || width < 4 || width % 4 ||
+        height < 2 || height % 2 || width > 8192 || height > 8192)
+        return false;
+    const uint64_t rowBytes = uint64_t(width / 4) * 5;
+    const uint64_t required = uint64_t(height - 1) * stride + rowBytes;
+    if (stride < rowBytes || required > input.size()) return false;
+    // Only overwrite the caller's report after validating its input contract.
+    out = Report{};
+    out.requiredBytes = required;
+    out.grid.width = width; out.grid.height = height;
+    const unsigned cellsX = width / 2, cellsY = height / 2;
+    out.stepXCells = (cellsX + 127) / 128;
+    out.stepYCells = (cellsY + 127) / 128;
+    auto cell = [&](Region &region, unsigned x, unsigned y) {
+        for (unsigned dy = 0; dy < 2; ++dy)
+            for (unsigned dx = 0; dx < 2; ++dx)
+                region.channels[static_cast<unsigned>(colourAt(order, x + dx, y + dy))]
+                    .add(unpack(input, stride, x + dx, y + dy));
+    };
+    for (unsigned cy = 0; cy < cellsY; cy += out.stepYCells)
+        for (unsigned cx = 0; cx < cellsX; cx += out.stepXCells)
+            cell(out.grid, cx * 2, cy * 2);
+    const unsigned tw = width < 32 ? width : 32;
+    const unsigned th = height < 32 ? height : 32;
+    const unsigned right = width - tw, bottom = height - th;
+    const unsigned centerX = ((width - tw) / 2) & ~1U;
+    const unsigned centerY = ((height - th) / 2) & ~1U;
+    const unsigned origins[5][2] = {
+        {centerX, centerY}, {0, 0}, {right, 0}, {0, bottom}, {right, bottom}
+    };
+    for (unsigned i = 0; i < out.tiles.size(); ++i) {
+        Region &tile = out.tiles[i];
+        tile.x = origins[i][0]; tile.y = origins[i][1];
+        tile.width = tw; tile.height = th;
+        for (unsigned y = tile.y; y < tile.y + th; y += 2)
+            for (unsigned x = tile.x; x < tile.x + tw; x += 2)
+                cell(tile, x, y);
+    }
+    return true;
+}
+} // namespace a6l::calibration
