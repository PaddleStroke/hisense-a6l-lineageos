+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <array>
+#include <cstdint>
+#include <optional>
+#include "libcamera/internal/a6l_raw10_diagnostic.h"
+namespace libcamera {
+struct A6lRawCalibrationChannel {
+ uint64_t count = 0, sum = 0, sumSquares = 0;
+ uint32_t saturated = 0, nearSaturated = 0;
+ uint16_t minimum = 0, maximum = 0, p01 = 0, p50 = 0, p99 = 0;
+};
+struct A6lRawCalibrationRegion {
+ uint32_t x = 0, y = 0, width = 0, height = 0;
+ std::array<A6lRawCalibrationChannel, 4> channels{};
+};
+struct A6lRawCalibrationSummary {
+ uint32_t sensorSequence = 0, width = 0, height = 0, stride = 0, order = 0;
+ uint64_t sessionGeneration = 0, sensorTimestampNs = 0, requiredBytes = 0;
+ uint32_t stepXCells = 0, stepYCells = 0;
+ std::array<A6lRawCalibrationRegion, 6> regions{};
+};
+inline A6lRawCalibrationSummary a6lSummarizeRaw(const a6l::calibration::Report &r)
+{
+ A6lRawCalibrationSummary out;
+ out.requiredBytes = r.requiredBytes;
+ out.stepXCells = r.stepXCells; out.stepYCells = r.stepYCells;
+ for (unsigned i = 0; i < out.regions.size(); ++i) {
+  const auto &src = i == 0 ? r.grid : r.tiles[i - 1]; auto &dst = out.regions[i];
+  dst.x = src.x; dst.y = src.y; dst.width = src.width; dst.height = src.height;
+  for (unsigned c = 0; c < 4; ++c) {
+   const auto &v = src.channels[c]; auto &s = dst.channels[c];
+   s.count = v.count; s.sum = v.sum; s.sumSquares = v.sumSquares;
+   s.saturated = v.saturated; s.nearSaturated = v.nearSaturated;
+   s.minimum = v.minimum; s.maximum = v.maximum;
+   s.p01 = v.percentile(1); s.p50 = v.percentile(50); s.p99 = v.percentile(99);
+  }
+ }
+ return out;
+}
+class A6lRawCalibrationInbox {
+public:
+ static constexpr uint32_t kFrame = 176;
+ uint64_t start() {
+  pending_.reset(); accepted_ = false; running_ = true;
+  // Overflow disables this diagnostic instead of recycling a session token.
+  if (generation_ == UINT64_MAX) { running_ = false; return 0; }
+  return ++generation_;
+ }
+ void halt() { running_ = false; pending_.reset(); }
+ uint64_t generation() const { return running_ ? generation_ : 0; }
+ bool accept(uint64_t generation, uint32_t frame, const A6lRawCalibrationSummary &summary) {
+  if (!running_ || !generation || generation != generation_ || frame != kFrame || accepted_)
+   return false;
+  pending_ = Pending{ generation, frame, summary };
+  pending_->summary.sessionGeneration = generation; accepted_ = true; return true;
+ }
+ std::optional<A6lRawCalibrationSummary> take(uint32_t frame) {
+  if (!running_ || !pending_ || pending_->generation != generation_ || pending_->frame != frame)
+   return std::nullopt;
+  auto summary = std::move(pending_->summary); pending_.reset(); return summary;
+ }
+private:
+ struct Pending { uint64_t generation; uint32_t frame; A6lRawCalibrationSummary summary; };
+ uint64_t generation_ = 0;
+ bool running_ = false, accepted_ = false;
+ std::optional<Pending> pending_;
+};
+} // namespace libcamera
