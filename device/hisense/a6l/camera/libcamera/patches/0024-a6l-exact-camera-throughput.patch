+/* Packed RAW10: keep the upper eight bits exactly as the scalar debayer. */
+static inline uint8x16_t a6l_raw10_high8(const uint8_t *p)
+{
+        const uint8x16x2_t packed = {{
+                vld1q_u8(p), vcombine_u8(vld1_u8(p + 12), vdup_n_u8(0))
