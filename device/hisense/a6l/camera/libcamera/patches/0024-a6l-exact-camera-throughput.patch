+// Exact ARM interpolation for bounded downscaling ratios.
+#pragma once
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#include <cstdint>
+#include <vector>
+
+#include "libyuv/scale_row.h"
+namespace a6l_preview {
+
+struct Group {
+    int base;
+    uint8_t indices[16];
+    uint16_t fractions[16];
+};
+struct Plan {
+    int width = -1, x = 0, dx = 0, processed = 0;
+    std::vector<Group> groups;
+    void prepare(int w, int start, int step, bool uv) {
+        if (width == w && x == start && dx == step) return;
+        width = w; x = start; dx = step; processed = 0; groups.clear();
+        const int count = uv ? 8 : 16;
+        const int64_t last = (static_cast<int64_t>(start) + (w - 1LL) * step) >> 16;
+        while (processed + count <= w) {
+            int64_t pos = static_cast<int64_t>(start) + static_cast<int64_t>(processed) * step;
+            int base = pos >> 16;
+            const int64_t end = (pos + (count - 1LL) * step) >> 16;
+            if ((uv ? base * 2 + 31 : base + 31) > (uv ? (last + 1) * 2 + 1 : last + 1) ||
+                (uv ? (end - base + 1) * 2 + 1 : end - base + 1) >= 32) break;
+            Group g{}; g.base = uv ? base * 2 : base;
+            for (int i = 0; i < count; ++i, pos += step) {
+                if (uv) {
+                    g.indices[2*i] = static_cast<uint8_t>(((pos >> 16) - base) * 2);
+                    g.indices[2*i+1] = g.indices[2*i] + 1;
+                    g.fractions[2*i] = g.fractions[2*i+1] = (pos >> 9) & 127;
+                } else {
+                    g.indices[i] = static_cast<uint8_t>((pos >> 16) - base);
+                    g.fractions[i] = pos & 65535;
+                }
+            }
+            groups.push_back(g); processed += count;
+        }
+    }
+};
+
+static inline uint8x8_t blendY(uint8x8_t a8, uint8x8_t b8, const uint16_t *frac) {
+    uint16x8_t a = vmovl_u8(a8);
+    int16x8_t diff = vreinterpretq_s16_u16(vsubq_u16(vmovl_u8(b8), a));
+    uint16x8_t f = vld1q_u16(frac);
+    int32x4_t lo = vmulq_s32(vmovl_s16(vget_low_s16(diff)), vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(f))));
+    int32x4_t hi = vmulq_s32(vmovl_s16(vget_high_s16(diff)), vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(f))));
+    int16x8_t delta = vcombine_s16(vrshrn_n_s32(lo, 16), vrshrn_n_s32(hi, 16));
+    return vmovn_u16(vaddq_u16(a, vreinterpretq_u16_s16(delta)));
+}
+
+static inline void scaleY(uint8_t *dst, const uint8_t *src, int width, int x, int dx) {
+    if (x < 0 || dx < 65536 || dx > 131072 || width < 16 || width > 32767 || static_cast<int64_t>(x) + (width - 1LL) * dx > INT32_MAX) {
+        libyuv::ScaleFilterCols_C(dst, src, width, x, dx); return;
+    }
+    static thread_local Plan plan;
+    plan.prepare(width, x, dx, false);
+    for (const auto &g : plan.groups) {
+        uint8x16x2_t table{{vld1q_u8(src + g.base), vld1q_u8(src + g.base + 16)}};
+        uint8x16_t indices = vld1q_u8(g.indices);
+        uint8x16_t a = vqtbl2q_u8(table, indices);
+        uint8x16_t b = vqtbl2q_u8(table, vaddq_u8(indices, vdupq_n_u8(1)));
+        vst1q_u8(dst, vcombine_u8(blendY(vget_low_u8(a), vget_low_u8(b), g.fractions),
+                                 blendY(vget_high_u8(a), vget_high_u8(b), g.fractions + 8)));
+        dst += 16;
+    }
+    if (plan.processed < width)
+        libyuv::ScaleFilterCols_C(dst, src, width - plan.processed, x + plan.processed * dx, dx);
+}
+
+static inline void scaleUV(uint8_t *dst, const uint8_t *src, int width, int x, int dx) {
+    if (x < 0 || dx < 65536 || dx > 131072 || width < 8 || width > 32767 || static_cast<int64_t>(x) + (width - 1LL) * dx > INT32_MAX) {
+        libyuv::ScaleUVFilterCols_C(dst, src, width, x, dx); return;
+    }
+    static thread_local Plan plan;
+    plan.prepare(width, x, dx, true);
+    for (const auto &g : plan.groups) {
+        uint8x16x2_t table{{vld1q_u8(src + g.base), vld1q_u8(src + g.base + 16)}};
+        uint8x16_t indices = vld1q_u8(g.indices);
+        uint8x16_t a8 = vqtbl2q_u8(table, indices);
+        uint8x16_t b8 = vqtbl2q_u8(table, vaddq_u8(indices, vdupq_n_u8(2)));
