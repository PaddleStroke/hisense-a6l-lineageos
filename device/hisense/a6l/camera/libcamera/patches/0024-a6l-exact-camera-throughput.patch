+        const uint8x16_t even = vld1q_u8(evenMask);
+        for (; width - pixels >= 16; pixels += 16) {
+                const uint8x16_t p = a6l_raw10_high8(prev);
+                const uint8x16_t c = a6l_raw10_high8(curr);
+                const uint8x16_t n = a6l_raw10_high8(next);
+                const uint8x16_t pl = a6l_raw10_left(p, prev), pr = a6l_raw10_right(p, prev);
+                const uint8x16_t cl = a6l_raw10_left(c, curr), cr = a6l_raw10_right(c, curr);
+                const uint8x16_t nl = a6l_raw10_left(n, next), nr = a6l_raw10_right(n, next);
+                const uint8x16_t vertical = a6l_average2(p, n);
+                const uint8x16_t horizontal = a6l_average2(cl, cr);
+                const uint8x16_t cross = a6l_average4(p, n, cl, cr);
+                const uint8x16_t diagonal = a6l_average4(pl, pr, nl, nr);
