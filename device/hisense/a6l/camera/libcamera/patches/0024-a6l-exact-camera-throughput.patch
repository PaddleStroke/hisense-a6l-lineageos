+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <stdint.h>
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(A6L_NV12_FORCE_SCALAR)
+#include <arm_neon.h>
+#endif
+
+/*
+ * Convert two even-width BGR rows to full-range BT.601 NV12. The four
+ * chroma inputs are summed before the signed shift, matching the retained
+ * scalar converter exactly. Neither row padding nor a partial vector is read.
+ */
+static inline void a6l_bgr_pair_to_nv12(const uint8_t *p0, const uint8_t *p1,
+                                      uint8_t *y0, uint8_t *y1, uint8_t *uv,
+                                      unsigned int width)
+{
+        unsigned int x = 0;
+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(A6L_NV12_FORCE_SCALAR)
+        for (; width - x >= 16; x += 16) {
+                const uint8x16x3_t c0 = vld3q_u8(p0);
+                const uint8x16x3_t c1 = vld3q_u8(p1);
+                const uint8x16_t rows[2][3] = {
+                        { c0.val[0], c0.val[1], c0.val[2] },
+                        { c1.val[0], c1.val[1], c1.val[2] },
+                };
+                uint8_t *lumaRows[2] = { y0 + x, y1 + x };
+                for (unsigned int row = 0; row < 2; ++row) {
+                        uint16x8_t lo = vmull_u8(vget_low_u8(rows[row][2]), vdup_n_u8(77));
+                        lo = vmlal_u8(lo, vget_low_u8(rows[row][1]), vdup_n_u8(150));
+                        lo = vmlal_u8(lo, vget_low_u8(rows[row][0]), vdup_n_u8(29));
+                        uint16x8_t hi = vmull_u8(vget_high_u8(rows[row][2]), vdup_n_u8(77));
+                        hi = vmlal_u8(hi, vget_high_u8(rows[row][1]), vdup_n_u8(150));
+                        hi = vmlal_u8(hi, vget_high_u8(rows[row][0]), vdup_n_u8(29));
+                        /* Max sum 65280: round-to-nearest fits in uint16_t. */
+                        vst1q_u8(lumaRows[row], vcombine_u8(vrshrn_n_u16(lo, 8), vrshrn_n_u16(hi, 8)));
+                }
+                const uint16x8_t b = vaddq_u16(vpaddlq_u8(c0.val[0]), vpaddlq_u8(c1.val[0]));
+                const uint16x8_t g = vaddq_u16(vpaddlq_u8(c0.val[1]), vpaddlq_u8(c1.val[1]));
+                const uint16x8_t r = vaddq_u16(vpaddlq_u8(c0.val[2]), vpaddlq_u8(c1.val[2]));
+                const int32x4_t bs[2] = {
+                        vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(b))),
+                        vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(b))),
+                };
+                const int32x4_t gs[2] = {
+                        vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(g))),
+                        vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(g))),
+                };
+                const int32x4_t rs[2] = {
+                        vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(r))),
+                        vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(r))),
+                };
+                int16x4_t us[2], vs[2];
+                for (unsigned int half = 0; half < 2; ++half) {
+                        int32x4_t u = vmulq_n_s32(rs[half], -43);
+                        u = vmlaq_n_s32(u, gs[half], -85);
+                        u = vmlaq_n_s32(u, bs[half], 128);
+                        int32x4_t v = vmulq_n_s32(rs[half], 128);
+                        v = vmlaq_n_s32(v, gs[half], -107);
+                        v = vmlaq_n_s32(v, bs[half], -21);
+                        u = vaddq_s32(vshrq_n_s32(vaddq_s32(u, vdupq_n_s32(512)), 10), vdupq_n_s32(128));
+                        v = vaddq_s32(vshrq_n_s32(vaddq_s32(v, vdupq_n_s32(512)), 10), vdupq_n_s32(128));
+                        us[half] = vqmovn_s32(u);
+                        vs[half] = vqmovn_s32(v);
+                }
+                const uint8x8x2_t chroma = {{
+                        vqmovun_s16(vcombine_s16(us[0], us[1])),
+                        vqmovun_s16(vcombine_s16(vs[0], vs[1])),
+                }};
+                vst2_u8(uv + x, chroma);
+                p0 += 48;
+                p1 += 48;
+        }
+#endif
+        for (; x < width; x += 2) {
+                const int b0 = p0[0], g0 = p0[1], r0 = p0[2];
+                const int b1 = p0[3], g1 = p0[4], r1 = p0[5];
+                const int b2 = p1[0], g2 = p1[1], r2 = p1[2];
+                const int b3 = p1[3], g3 = p1[4], r3 = p1[5];
+                y0[x] = (77 * r0 + 150 * g0 + 29 * b0 + 128) >> 8;
+                y0[x + 1] = (77 * r1 + 150 * g1 + 29 * b1 + 128) >> 8;
+                y1[x] = (77 * r2 + 150 * g2 + 29 * b2 + 128) >> 8;
+                y1[x + 1] = (77 * r3 + 150 * g3 + 29 * b3 + 128) >> 8;
+                const int r = r0 + r1 + r2 + r3;
+                const int g = g0 + g1 + g2 + g3;
+                const int b = b0 + b1 + b2 + b3;
+                const int u = ((-43 * r - 85 * g + 128 * b + 512) >> 10) + 128;
+                const int v = ((128 * r - 107 * g - 21 * b + 512) >> 10) + 128;
+                uv[x] = u < 0 ? 0 : (u > 255 ? 255 : u);
+                uv[x + 1] = v < 0 ? 0 : (v > 255 ? 255 : v);
+                p0 += 6;
+                p1 += 6;
+        }
+}
