+                        bv = vbslq_u8(even, c, horizontal);
+                        gv = vbslq_u8(even, cross, c);
+                        rv = vbslq_u8(even, diagonal, vertical);
+                } else if (phase == 1) {
+                        bv = vbslq_u8(even, vertical, diagonal);
+                        gv = vbslq_u8(even, c, cross);
+                        rv = vbslq_u8(even, horizontal, c);
+                } else if (phase == 2) {
