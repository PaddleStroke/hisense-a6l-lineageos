+{
+        return vextq_u8(vdupq_n_u8(p[-2]), v, 15);
+}
+static inline uint8x16_t a6l_raw10_right(uint8x16_t v, const uint8_t *p)
+{
+        return vextq_u8(v, vdupq_n_u8(p[20]), 1);
