+# SPDX-License-Identifier: CC0-1.0
+# Hisense A6L imx576_a6l tuning for the libcamera simple IPA (SoftISP). Phase 1 = uncalibrated:
+# black level from the CameraSensorHelper (64 @ 10 bit), grey-world AWB, AGC, gamma/contrast.
+# CCM is left disabled until measured (colour chart shot or stock chromatix decode, docs/libcamera-plan-20260929.md s.6).
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  # - Ccm:
+  #     ccms:
+  #       - ct: 6500
+  #         ccm: [ 1, 0, 0,
+  #                0, 1, 0,
+  #                0, 0, 1 ]
+  - Adjust:
+  - Agc:
+...
