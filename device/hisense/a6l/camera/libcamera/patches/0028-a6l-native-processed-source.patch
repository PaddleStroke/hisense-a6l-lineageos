+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include "native_raw10_sizes.h"
+
+namespace libcamera {
+
+/* Only proven A6L full-field binned readout sizes. Do not choose the smaller
+ * 16:9 sensor readout merely because the encoder destination is 16:9. Each
+ * destination's aspect crop/scale remains the existing YUV postprocessor's job.
+ * Discovery still requires an actual discrete packed RAW10 identity layout. */
+inline std::optional<Size> a6lNativeProcessedSource(std::string_view model,
+                                               const StreamFormats &rawFormats,
+                                               const std::vector<Size> &outputs)
+{
+    Size preferred;
+    if (model == "imx576" || model == "imx576_a6l")
+        preferred = { 2872, 2156 };
+    else if (model == "s5k3t1")
+        preferred = { 2296, 1728 };
+    else if (model == "hi846")
+        preferred = { 1624, 1224 };
+    else
+        return std::nullopt;
+
+    if (outputs.empty())
+        return std::nullopt;
+    for (const Size &output : outputs) {
+        if (!output.width || !output.height || (output.width & 1) ||
+            (output.height & 1) || output.width > preferred.width ||
+            output.height > preferred.height)
+            return std::nullopt;
+    }
+
+    const auto candidates = a6lNativeRaw10Sizes(model, rawFormats);
+    if (std::find(candidates.begin(), candidates.end(), preferred) == candidates.end())
+        return std::nullopt;
+    return preferred;
+}
+
+} /* namespace libcamera */
