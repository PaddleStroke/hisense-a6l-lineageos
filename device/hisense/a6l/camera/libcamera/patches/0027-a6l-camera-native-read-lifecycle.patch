+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <cerrno>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+#include <sys/ioctl.h>
+#include <linux/dma-buf.h>
+
+#include <libcamera/base/span.h>
+#include <libcamera/framebuffer.h>
+#include "libcamera/internal/mapped_framebuffer.h"
+
+namespace libcamera {
+
+/* Separate bounded diagnostic. begin() hashes native CPU bytes BEFORE any
+ * legacy RAW START; verify() runs only after workers have joined. Its END
+ * must be followed by no more RAW reads, then native lease release. */
+class A6LNativeRawVerifier
+{
+public:
+	struct Snapshot { uint64_t hash; size_t length; };
+	enum class Status { Equal, StartError, MappingError, SizeError, Mismatch, EndError, SessionFailed };
+	struct Result {
+		Status status = Status::Equal;
+		uint64_t before = 0, after = 0;
+		size_t length = 0;
+		int startError = 0, endError = 0;
+		bool passed() const { return status == Status::Equal; }
+	};
+	void startSession(std::string_view enabled) { failed_ = false; remaining_ = enabled == "1" ? 8 : 0; }
+	bool failed() const { return failed_; }
+	unsigned int remaining() const { return remaining_; }
+	std::optional<Snapshot> begin(Span<const uint8_t> native)
+	{
+		if (!remaining_)
+			return {};
+		--remaining_;
+		return Snapshot{ hash(native), native.size() };
+	}
+	static const char *statusName(Status status)
+	{
+		switch (status) {
+		case Status::Equal: return "equal";
+		case Status::StartError: return "start_error";
+		case Status::MappingError: return "mapping_error";
+		case Status::SizeError: return "size_error";
+		case Status::Mismatch: return "mismatch";
+		case Status::EndError: return "end_error";
+		case Status::SessionFailed: return "session_failed";
+		}
+		return "unknown";
+	}
+	Result verify(FrameBuffer &buffer, const Snapshot &snapshot)
+	{
+		Result result;
+		result.before = snapshot.hash;
+		result.length = snapshot.length;
+		if (failed_) { result.status = Status::SessionFailed; return result; }
+		if (buffer.planes().size() != 1 || !buffer.planes()[0].fd.isValid()) {
+			result.status = Status::SizeError;
+			return finishResult(result);
+		}
+		ReadSync sync(buffer.planes()[0].fd.get());
+		result.startError = sync.startError();
+		if (result.startError) {
+			result.status = Status::StartError;
+			return finishResult(result); // Never touch legacy pixels after failed START.
+		}
+		{
+			MappedFrameBuffer legacy(&buffer, MappedFrameBuffer::MapFlag::Read);
+			if (!legacy.isValid())
+				result.status = Status::MappingError;
+			else if (legacy.planes().size() != 1 || legacy.planes()[0].size() != snapshot.length)
+				result.status = Status::SizeError;
+			else {
+				result.after = hash(Span<const uint8_t>(legacy.planes()[0].data(), legacy.planes()[0].size()));
+				if (result.before != result.after)
+					result.status = Status::Mismatch;
+			}
+		} // Legacy mapping no longer used, before READ END.
+		result.endError = sync.finish();
+		if (result.endError && result.status == Status::Equal)
+			result.status = Status::EndError;
+		return finishResult(result);
+	}
+private:
+	Result finishResult(Result result)
+	{
+		if (!result.passed()) { failed_ = true; remaining_ = 0; }
+		return result;
+	}
+	static uint64_t hash(Span<const uint8_t> bytes)
+	{
+		uint64_t value = 14695981039346656037ULL;
+		for (uint8_t byte : bytes)
+			value = (value ^ byte) * 1099511628211ULL;
+		return value;
+	}
+	class ReadSync {
+	public:
+		explicit ReadSync(int fd) : fd_(fd), startError_(sync(DMA_BUF_SYNC_START)), active_(!startError_) {}
+		~ReadSync() { finish(); }
+		int startError() const { return startError_; }
+		int finish()
+		{
+			if (!active_)
+				return endError_;
+			active_ = false;
+			endError_ = sync(DMA_BUF_SYNC_END);
+			return endError_;
+		}
+	private:
+		int sync(uint64_t phase) const
+		{
+			dma_buf_sync request{ .flags = DMA_BUF_SYNC_READ | phase };
+			for (unsigned int retry = 0; retry < 8; ++retry) {
+				if (::ioctl(fd_, DMA_BUF_IOCTL_SYNC, &request) == 0)
+					return 0;
+				int error = errno;
+				if (error != EINTR && error != EAGAIN)
+					return -error;
+			}
+			return -errno;
+		}
+		const int fd_;
+		const int startError_;
+		bool active_;
+		int endError_ = 0;
+	};
+	bool failed_ = false;
+	unsigned int remaining_ = 0;
+};
+
