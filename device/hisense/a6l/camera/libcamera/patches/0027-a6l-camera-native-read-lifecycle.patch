+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <fcntl.h>
+#include <memory>
+#include <mutex>
+#include <string_view>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <vector>
+
+#include <libcamera/base/shared_fd.h>
+#include <libcamera/base/span.h>
+#include <libcamera/base/unique_fd.h>
+#include <libcamera/framebuffer.h>
+
+namespace libcamera {
+
+inline bool a6lNativeRawGate(std::string_view trial, std::string_view device,
+	std::string_view driver, std::string_view sensor, bool conversion,
+	bool softwareIsp, bool exposedRaw)
+{
+	return trial == "1" && device == "a6l" && driver == "qcom-camss" &&
+		conversion && softwareIsp && !exposedRaw &&
+		(sensor == "imx576" || sensor == "imx576_a6l" ||
+		 sensor == "hi846" || sensor == "s5k3t1");
+}
+
+/* Experimental native V4L2 MMAP access, not a DMA-BUF mapping. Only the
+ * V4L2 allocator creates this provenance. Successful DQBUF grants read
+ * ownership; QBUF reserves it exclusively. CPU access must end before QBUF.
+ * The mapped video-node descriptor and plane snapshots pin the exact pool.
+ * No frame pixels or public metadata are used to guess this ownership. */
+class A6LNativeRawMmap : public std::enable_shared_from_this<A6LNativeRawMmap>
+{
+private:
+	struct Mapping {
+		Mapping(int videoFd, unsigned int offset, unsigned int mapLength,
+			Span<const FrameBuffer::Plane> mapPlanes)
+			: planes(mapPlanes.begin(), mapPlanes.end()), length(mapLength)
+		{
+			int copy = fcntl(videoFd, F_DUPFD_CLOEXEC, 0);
+			if (copy < 0)
+				return;
+			fd = SharedFD(UniqueFD(copy));
+			address = mmap(nullptr, length, PROT_READ, MAP_SHARED, fd.get(), offset);
+		}
+		~Mapping()
+		{
+			if (address != MAP_FAILED)
+				munmap(address, length);
+		}
+		std::vector<FrameBuffer::Plane> planes;
+		SharedFD fd;
+		void *address = MAP_FAILED;
+		unsigned int length;
+	};
+	enum class State { Allocated, Queued, Dequeued, Error, Retired };
+
+public:
+	class ReadLease {
+	public:
+		ReadLease() = default;
+		ReadLease(const ReadLease &) = delete;
+		ReadLease &operator=(const ReadLease &) = delete;
+		ReadLease(ReadLease &&other) noexcept = default;
+		ReadLease &operator=(ReadLease &&other) noexcept
+		{
+			reset();
+			owner_ = std::move(other.owner_);
+			mapping_ = std::move(other.mapping_);
+			return *this;
+		}
+		~ReadLease() { reset(); }
+		explicit operator bool() const { return bool(owner_); }
+		bool issuedBy(const std::shared_ptr<A6LNativeRawMmap> &owner) const
+		{
+			return owner_ && owner_ == owner;
+		}
+		Span<const uint8_t> bytes() const
+		{
+			return mapping_ ? Span<const uint8_t>(
+				static_cast<const uint8_t *>(mapping_->address), mapping_->length)
+				: Span<const uint8_t>();
+		}
+		void reset()
+		{
+			if (!owner_)
+				return;
+			/* Drop the borrowed map before releasing queue exclusion. */
+			mapping_.reset();
+			{
+				std::lock_guard<std::mutex> lock(owner_->mutex_);
+				owner_->reading_ = false;
+				if (owner_->state_ == State::Retired)
+					owner_->mapping_.reset();
+			}
+			owner_.reset();
+		}
+	private:
+		friend class A6LNativeRawMmap;
+		ReadLease(std::shared_ptr<A6LNativeRawMmap> owner,
+			  std::shared_ptr<Mapping> mapping)
+			: owner_(std::move(owner)), mapping_(std::move(mapping)) {}
+		std::shared_ptr<A6LNativeRawMmap> owner_;
+		std::shared_ptr<Mapping> mapping_;
+	};
+
+	/* Holds the mutex through the QBUF ioctl. A failed ioctl leaves the
+ * prior dequeue/allocation ownership intact. The ioctl cannot call user
+ * code inline; other readers cannot begin during queue submission. */
+	class QueueTicket {
+	public:
+		~QueueTicket() = default;
+		void commit() { owner_->state_ = State::Queued; }
+	private:
+		friend class A6LNativeRawMmap;
+		QueueTicket(std::shared_ptr<A6LNativeRawMmap> owner,
+			    std::unique_lock<std::mutex> lock)
+			: owner_(std::move(owner)), lock_(std::move(lock)) {}
+		std::shared_ptr<A6LNativeRawMmap> owner_;
+		std::unique_lock<std::mutex> lock_;
+	};
+
+	static std::shared_ptr<A6LNativeRawMmap> create(int videoFd,
+		uint64_t generation, unsigned int index, unsigned int mmapOffset,
+		unsigned int length, const FrameBuffer &buffer)
+	{
+		const long page = sysconf(_SC_PAGESIZE);
+		const auto planes = buffer.planes();
+		if (!generation || page <= 0 || mmapOffset % page || !length ||
+		    planes.size() != 1 || planes[0].offset != 0 ||
+		    planes[0].length != length || !planes[0].fd.isValid())
+			return {};
+		auto mapping = std::make_shared<Mapping>(videoFd, mmapOffset, length, planes);
+		if (mapping->address == MAP_FAILED)
+			return {};
+		return std::shared_ptr<A6LNativeRawMmap>(
+			new A6LNativeRawMmap(generation, index, std::move(mapping)));
+	}
+
+	std::unique_ptr<QueueTicket> beginQueue(const FrameBuffer &buffer,
+		uint64_t generation, unsigned int index)
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+		if (!matches(buffer, generation, index) || reading_ ||
+		    (state_ != State::Allocated && state_ != State::Dequeued && state_ != State::Error))
+			return {};
+		return std::unique_ptr<QueueTicket>(
+			new QueueTicket(shared_from_this(), std::move(lock)));
+	}
+	bool dequeued(const FrameBuffer &buffer, uint64_t generation,
+		unsigned int index, bool success)
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (!matches(buffer, generation, index) || state_ != State::Queued || reading_)
+			return false;
+		state_ = success ? State::Dequeued : State::Error;
+		return true;
+	}
+	ReadLease read(const FrameBuffer &buffer)
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (!matches(buffer, generation_, index_) || state_ != State::Dequeued || reading_)
+			return {};
+		reading_ = true;
+		return ReadLease(shared_from_this(), mapping_);
+	}
+	/* Invalidates future grants immediately; an existing lease pins its
+ * mapping until CPU work ends. ReleaseBuffers must refuse REQBUFS while
+ * false, and may retry after the serialized worker is retired. */
+	bool retire()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		state_ = State::Retired;
+		if (reading_)
+			return false;
+		mapping_.reset();
+		return true;
+	}
+private:
+	A6LNativeRawMmap(uint64_t generation, unsigned int index,
+			 std::shared_ptr<Mapping> mapping)
+		: generation_(generation), index_(index), mapping_(std::move(mapping)) {}
+	bool matches(const FrameBuffer &buffer, uint64_t generation, unsigned int index) const
+	{
+		const auto planes = buffer.planes();
+		return mapping_ && generation == generation_ && index == index_ &&
+			planes.size() == 1 && mapping_->planes[0].fd == planes[0].fd &&
+			mapping_->planes[0].offset == planes[0].offset &&
+			mapping_->planes[0].length == planes[0].length;
+	}
+	const uint64_t generation_;
+	const unsigned int index_;
+	std::mutex mutex_;
+	std::shared_ptr<Mapping> mapping_;
+	State state_ = State::Allocated;
+	bool reading_ = false;
+};
+
+} /* namespace libcamera */
