+/* Native video-node MMAP relies on V4L2 finish/prepare ownership, not
+ * the DMA-BUF mmap API. Only a live private READ lease permits this
+ * path. All output allocations retain their normal WRITE START/END. */
+bool Debayer::dmaSyncNativeRawRead(std::vector<DmaSyncer> &syncers, FrameBuffer *input,
+	FrameBuffer *output, const A6LNativeRawMmap::ReadLease &lease)
+{
+	if (!input || !output || !lease.issuedBy(input->_d()->a6lNativeRaw())) return false;
+	const auto raw = input->planes();
+	std::vector<SharedFD> unique;
+	for (const auto &plane : output->planes()) {
+		if (plane.fd == raw[0].fd) return false;
+		if (std::find(unique.begin(), unique.end(), plane.fd) == unique.end())
+			unique.push_back(plane.fd);
+	}
+	syncers.reserve(syncers.size() + unique.size());
+	for (const auto &fd : unique) syncers.emplace_back(fd, DmaSyncer::SyncType::Write);
+	return true;
+}
