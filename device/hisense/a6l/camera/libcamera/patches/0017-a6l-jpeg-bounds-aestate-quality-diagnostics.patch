+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Hisense A6L: validate and write the framework-visible JPEG BLOB footer. */
+#pragma once
+
+#include <string.h>
+#include <hardware/camera3.h>
+#include <libcamera/base/span.h>
+
+inline bool writeJpegBlobFooter(libcamera::Span<uint8_t> destination,
+			       size_t capacity, size_t encodedSize)
+{
+	if (capacity < sizeof(camera3_jpeg_blob) || capacity > destination.size() ||
+	    encodedSize > capacity - sizeof(camera3_jpeg_blob))
+		return false;
+
+	camera3_jpeg_blob blob{};
+	blob.jpeg_blob_id = CAMERA3_JPEG_BLOB_ID;
+	blob.jpeg_size = encodedSize;
+	/* The logical BLOB end may be unaligned. */
+	memcpy(destination.data() + capacity - sizeof(blob), &blob, sizeof(blob));
+	return true;
+}
