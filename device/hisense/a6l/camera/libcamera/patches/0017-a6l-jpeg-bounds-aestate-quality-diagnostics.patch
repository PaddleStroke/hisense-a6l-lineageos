+/* Keep JPEG writes inside the caller's span. If it fills, finish into a fixed
+ * scratch sink so no C++ stack unwinding/longjmp or gralloc reallocation is
+ * needed; the caller receives -ENOSPC and must discard the failed result. */
+struct BoundedJpegDestination {
+	jpeg_destination_mgr manager{};
+	Span<uint8_t> output;
+	JOCTET scratch[1024];
+	bool overflow = false;
+	bool exhausted = false;
+
+	static void init(j_compress_ptr compressor)
+	{
+		auto *destination = reinterpret_cast<BoundedJpegDestination *>(compressor->dest);
+		destination->manager.next_output_byte = destination->output.data();
+		destination->manager.free_in_buffer = destination->output.size();
+		destination->overflow = false;
+		destination->exhausted = false;
+	}
+
+	static boolean full(j_compress_ptr compressor)
+	{
+		auto *destination = reinterpret_cast<BoundedJpegDestination *>(compressor->dest);
+		destination->overflow |= destination->exhausted;
+		destination->exhausted = true;
+		destination->manager.next_output_byte = destination->scratch;
+		destination->manager.free_in_buffer = sizeof(destination->scratch);
+		return TRUE;
+	}
+
+	static void finish(j_compress_ptr compressor)
+	{
+		auto *destination = reinterpret_cast<BoundedJpegDestination *>(compressor->dest);
+		if (destination->exhausted && destination->manager.free_in_buffer != sizeof(destination->scratch))
+			destination->overflow = true;
+	}
+};
 
