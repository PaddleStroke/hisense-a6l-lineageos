+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include <libcamera/stream.h>
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/raw10_fov.h"
+
+namespace libcamera {
+
+/* A6L CPU software-ISP native candidates. Every candidate must still pass the
+ * HAL's existing exact processed-format validation before it is advertised. */
+inline std::vector<Size> a6lNativeRaw10Sizes(std::string_view model,
+                                          const StreamFormats &formats)
+{
+    if (model != "imx576" && model != "imx576_a6l" &&
+        model != "hi846" && model != "s5k3t1")
+        return {};
+
+    std::vector<Size> sizes;
+    for (const PixelFormat &format : formats.pixelformats()) {
+        const BayerFormat bayer = BayerFormat::fromPixelFormat(format);
+        if (bayer.bitDepth != 10 || bayer.packing != BayerFormat::Packing::CSI2)
+            continue;
+        const SizeRange range = formats.range(format);
+        /* StreamFormats uses zero steps for a discrete collection. A single
+         * discrete size has min==max. Do not manufacture sensor modes from a
+         * continuous range's generated standard-size list. */
+        if (range.min != range.max && (range.hStep || range.vStep))
+            continue;
+        for (const Size &raw : formats.sizes(format)) {
+            constexpr unsigned int border = 2 * Raw10FovResampler::border;
+            if (raw.width <= border || raw.width > 16384 || raw.height > 16384)
+                continue;
+            const Size native(raw.width - border, raw.height);
+            Raw10FovResampler layout;
+            if (!layout.configure(raw.width, raw.height, raw.width * 5 / 4,
+                                  native.width, native.height) || !layout.identity())
+                continue;
+            sizes.push_back(native);
+        }
+    }
+    std::sort(sizes.begin(), sizes.end());
+    sizes.erase(std::unique(sizes.begin(), sizes.end()), sizes.end());
+    return sizes;
+}
+
+} /* namespace libcamera */
