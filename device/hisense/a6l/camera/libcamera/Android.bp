//
// SPDX-License-Identifier: Apache-2.0
//
// A6L (lc2, 29 Sep 2026): upstream libcamera v0.7.2 + A6L patches (patches/0001-0005), built with meson + NDK r27c by
// tools/build-libcamera-a6l.sh (steps: src jpeg exif hal halpkg) -> prebuilt/ (SHA256SUMS, BUILD-INFO.txt).
// Installed to /vendor: libcamera core (simple pipeline + SoftISP), the signed simple IPA (in-process: its .sign matches
// the public key compiled into libcamera.so, so no IPA proxy/isolation), the Android camera3 HAL module
// (/vendor/lib64/hw/camera.libcamera.so, loaded by android.hardware.camera.provider-service.a6l via ro.hardware.camera).
// Non-ELF files (IPA signature, tuning yamls, camera_hal.yaml) are installed by libcamera-vendor.mk.
// Module names carry an .a6l suffix (stem = the real file name) so they never clash with external/libcamera.
// The .so files are already stripped; soong must not strip again (the IPA signature covers the exact bytes).
//

cc_defaults {
    name: "libcamera_a6l_prebuilt_defaults",
    vendor: true,
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
}

cc_prebuilt_library_shared {
    name: "libcamera-base.a6l",
    defaults: ["libcamera_a6l_prebuilt_defaults"],
    stem: "libcamera-base",
    target: {
        android_arm64: {
            srcs: ["prebuilt/lib64/libcamera-base.so"],
        },
    },
}

cc_prebuilt_library_shared {
    name: "libcamera.a6l",
    defaults: ["libcamera_a6l_prebuilt_defaults"],
    stem: "libcamera",
    target: {
        android_arm64: {
            srcs: ["prebuilt/lib64/libcamera.so"],
        },
    },
    required: ["libcamera-base.a6l"],
}

cc_prebuilt_library_shared {
    name: "ipa_soft_simple.a6l",
    defaults: ["libcamera_a6l_prebuilt_defaults"],
    stem: "ipa_soft_simple",
    relative_install_path: "libcamera/ipa",
    target: {
        android_arm64: {
            srcs: ["prebuilt/lib64/libcamera/ipa/ipa_soft_simple.so"],
        },
    },
    required: ["libcamera.a6l"],
}

cc_prebuilt_library_shared {
    name: "camera.libcamera.a6l",
    defaults: ["libcamera_a6l_prebuilt_defaults"],
    stem: "camera.libcamera",
    relative_install_path: "hw",
    target: {
        android_arm64: {
            srcs: ["prebuilt/lib64/hw/camera.libcamera.so"],
        },
    },
    required: [
        "libcamera.a6l",
        "ipa_soft_simple.a6l",
    ],
}

// Keep the IPC worker matched to the core and IPA, including lens controls.
cc_prebuilt_binary {
    name: "soft_ipa_proxy.a6l",
    vendor: true,
    compile_multilib: "64",
    stem: "soft_ipa_proxy",
    srcs: ["prebuilt/libexec/libcamera/soft_ipa_proxy"],
    check_elf_files: false,
    strip: { none: true },
    required: ["libcamera.a6l", "soft_ipa_proxy_path.a6l"],
}

install_symlink {
    name: "soft_ipa_proxy_path.a6l",
    vendor: true,
    installed_location: "libexec/libcamera/soft_ipa_proxy",
    symlink_target: "/vendor/bin/soft_ipa_proxy",
}
