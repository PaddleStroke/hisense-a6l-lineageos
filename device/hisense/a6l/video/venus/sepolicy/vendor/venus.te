# venus-impl (6 Oct 2026). Written from the code paths; complete from `dmesg | grep avc` in the first permissive run.
type sysfs_a6l_venus, sysfs_type, fs_type;

# V4L2 Codec2 service (runs as mediacodec; system/sepolicy/vendor/mediacodec.te already allows video_device rw,
# dmabuf heaps, gralloc/binder): discovery reads /sys/class/video4linux/* (generic sysfs dir + symlinks) and the Venus
# node names; CAMSS node names (generic sysfs files) stay unreadable on purpose, so those nodes are skipped.
allow mediacodec sysfs:dir r_dir_perms;
allow mediacodec sysfs:lnk_file read;
r_dir_file(mediacodec, sysfs_a6l_venus)
get_prop(mediacodec, vendor_a6l_v4l2_codec2_prop)

# prod2 cold power cycle: the core is powered (and its firmware loaded) only while a session is open; the first
# REQBUFS of a session runtime-resumes it in the CALLER's task, i.e. the V4L2 Codec2 service (mediacodec), which then
# runs request_firmware(qcom/venus-4.4/venus.mdt + .bNN) itself. (System resume runs it as kernel: a6l_firmware.te.)
allow mediacodec a6l_firmware_file:dir search;
allow mediacodec a6l_firmware_file:file r_file_perms;
allow mediacodec a6l_firmware_file:system firmware_load;

# Camera (CAMSS/ISP) node names are generic sysfs: the discovery skips them; do not log those reads.
dontaudit mediacodec sysfs:file { open read getattr };

# a6l-modules.sh misc: find the encoder node, chown/chmod it for the service, publish vendor.a6l.venus (vendor_a6l_prop)
# insmod venus-core runs the firmware load (request_firmware -> qcom/venus-4.4/venus.mdt + .bNN) in the insmod task:
# the a6l_modules domain needs the selinux-20261007 firmware type (rom/sepolicy/vendor/a6l_firmware.te, file.te).
allow a6l_modules a6l_firmware_file:dir search;
allow a6l_modules a6l_firmware_file:file r_file_perms;
allow a6l_modules a6l_firmware_file:system firmware_load;
r_dir_file(a6l_modules, sysfs_a6l_venus)
allow a6l_modules video_device:chr_file { getattr setattr };
allow a6l_modules video_device:dir r_dir_perms;

# selinux-20261007 pass 2 (round 12): /vendor/build.prop ro.vendor.v4l2_codec2.* (venus.mk) are loaded in the vendor_init
# context (r12: set ro.vendor.v4l2_codec2.encoder.supported.h264 denied; in enforcing the store would advertise nothing)
set_prop(vendor_init, vendor_a6l_v4l2_codec2_prop)

# ---- selinux-20261010 pass 5 (round 26b full-use avc; firmware/extracted/selinux-20261010/README.md) ----
# HW decode of app buffers: MediaCodec in the app process (Jelly/Gallery/ExoPlayer, untrusted_app_34 in r26b) hands the
# V4L2 Codec2 service its bufferpool2/FMQ memfds ("memfd:MessageQueue", policycap memfd_class: labelled with the
# creator's domain). r26b: mediacodec read write map x16 on untrusted_app_34:memfd_file. Denied = the codec cannot map the
# app's input/status queues -> playback fails. AOSP grants exactly this to the software codec service
# (system/sepolicy/private/mediaswcodec.te: allow mediaswcodec appdomain:memfd_file { getattr read write map }); the
# vendor Codec2 service needs the same. Platform clients (system_server, cameraserver) are covered by hal_client_domain().
allow mediacodec appdomain:memfd_file { getattr map read write };
