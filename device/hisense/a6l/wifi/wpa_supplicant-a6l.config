# wpa_supplicant 2.11 build config for the A6L recovery test (static aarch64 musl). wifi agent, 26 Sep 2026.
# nl80211 only, WPA2-PSK / WPA3-SAE (H2E + hunting-and-pecking) / OWE, PMF, no EAP, no dbus, no WPS/P2P.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_GETRANDOM=y
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_ELOOP_POLL=y
CONFIG_DEBUG_FILE=y
