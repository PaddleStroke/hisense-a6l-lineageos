#!/system/bin/sh
# udhcpc hook for wifi-test.sh (wifi agent, 26 Sep 2026). $1 = deconfig|bound|renew|leasefail|nak.
# Only touches the interface udhcpc runs on (wlan0); the default route is added by wifi-test.sh, not here.
BB=${A6L_BB:-busybox}
case "$1" in
  deconfig) $BB ip -4 addr flush dev "$interface"; $BB ip link set "$interface" up ;;
  bound|renew)
    $BB ip -4 addr flush dev "$interface"
    $BB ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
    { echo "ip='$ip'"; echo "mask='${mask:-}'"; echo "router='${router:-}'"; echo "dns='${dns:-}'"; echo "lease='${lease:-}'"; echo "serverid='${serverid:-}'"; } > "${A6L_LEASE:-/dev/null}"
    echo "A6L_DHCP_$1 ip=$ip/${mask:-?} router=${router:-none} dns=${dns:-none} lease=${lease:-?}s server=${serverid:-?}" ;;
  leasefail|nak) echo "A6L_DHCP_$1" ;;
esac
exit 0
