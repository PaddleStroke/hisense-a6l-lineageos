<?xml version="1.0" encoding="UTF-8"?>
<!-- Hisense A6L mixer paths for libaudioroute (audio3, 24 Sep 2026). Used by /vendor/bin/a6l-audio-route, NOT by the audio HAL.
     Control names = the real names read on the phone on 23 Sep (v74/logs/tinymix-controls.txt): the LPASS digital codec has
     the "Digital " prefix; digital volumes are RAW (dB = raw - 84; 84 = 0 dB, stock value). Controls that do not exist
     (e.g. TERT_MI2S / TFA without the speaker DT) are skipped by libaudioroute with a warning.
     Stock origin: firmware/extracted/vendor/etc/mixer_paths.xml (headphones, speaker, handset-mic/adc1, headset-mic/adc2).
     Top level = reset state. MultiMedia1 defaults to LPI_MI2S_RX_0; the speaker path selects TERT_MI2S_RX instead.
     (audio6) Capture uses LPI_MI2S_TX_3 -> MultiMedia2. A DPCM front end with no back end fails open() with EINVAL,
     so the HAL's pcmC0D0p / pcmC0D1c must always have one. With
     HPHL/HPHR/EAR_S at ZERO nothing is audible from the codec even though its back end runs. -->
<mixer>
    <!-- DSP (q6routing): always connected -->
    <ctl name="LPI_MI2S_RX_0 Audio Mixer MultiMedia1" value="1" />
    <!-- audio6 (25 Sep 2026): the MultiMedia1 TX route is OFF: capture uses MultiMedia2 only, nothing opens pcmC0D0c any more,
         and with the upstream q6routing fallback (persist.vendor.a6l.audio.q6routing=upstream) an MM1 TX route set after the
         RX route would re-map the playback session onto the TX port (ADM 0x10325 EBADPARAM, silent playback; audfix). -->
    <ctl name="MultiMedia1 Mixer LPI_MI2S_TX_3" value="0" />
    <ctl name="LPI_MI2S_RX_0 Audio Mixer MultiMedia2" value="0" />
    <!-- merge3 r3 (25 Sep 2026): media capture runs on its own front end MultiMedia2 (pcmC0D1c), MONO (the A6L mic path is
         mono: 2 ch -> hw_params EINVAL). Proven with tinycap 48 kHz/16 kHz 1 ch (attended audio5 MODE=capture, 25 Sep).
         The audio HAL opens pcm device ro.vendor.a6l.audio.capture_pcm (=1) for input (tree patch audio/patches/0001). -->
    <ctl name="MultiMedia2 Mixer LPI_MI2S_TX_3" value="1" />
    <ctl name="TERT_MI2S_RX Audio Mixer MultiMedia1" value="0" />
    <!-- codec playback: everything off / muted -->
    <ctl name="Digital RX1 MIX1 INP1" value="ZERO" />
    <ctl name="Digital RX2 MIX1 INP1" value="ZERO" />
    <ctl name="RDAC2 MUX" value="RX1" />
    <ctl name="Digital RX1 Digital Volume" value="0" />
    <ctl name="Digital RX2 Digital Volume" value="0" />
    <ctl name="HPHL" value="ZERO" />
    <ctl name="HPHR" value="ZERO" />
    <ctl name="EAR_S" value="ZERO" />
    <!-- codec capture: off. audio6: stock mixer_paths.xml top level = ADC1/2/3 Volume 4, DEC1..4 Volume 84 (mainline
         "Digital TX1/TX2 Digital Volume", RAW 84 = 0 dB). The TX path is MONO (DEC1 only; 2 ch -> hw_params EINVAL). -->
    <ctl name="Digital DEC1 MUX" value="ZERO" />
    <ctl name="Digital DEC2 MUX" value="ZERO" />
    <ctl name="Digital CIC1 MUX" value="AMIC" />
    <ctl name="ADC2 MUX" value="ZERO" />
    <ctl name="ADC1 Volume" value="4" />
    <ctl name="ADC2 Volume" value="4" />
    <ctl name="ADC3 Volume" value="4" />
    <ctl name="Digital TX1 Digital Volume" value="84" />
    <ctl name="Digital TX2 Digital Volume" value="84" />

    <!-- Wired headset / headphones (stock "headphones"). -6 dB digital (stock 0 dB); Android volume is applied in software on top. -->
    <path name="headphones">
        <ctl name="Digital RX1 MIX1 INP1" value="RX1" />
        <ctl name="Digital RX2 MIX1 INP1" value="RX2" />
        <ctl name="RDAC2 MUX" value="RX2" />
        <ctl name="Digital RX1 Digital Volume" value="78" />
        <ctl name="Digital RX2 Digital Volume" value="78" />
        <ctl name="HPHL" value="Switch" />
        <ctl name="HPHR" value="Switch" />
    </path>

    <!-- Loudspeaker: NXP TFA9894 on TERTIARY_MI2S_RX (stock "speaker"). Only with the V75 speaker DT + snd-soc-tfa98xx. -->
    <path name="speaker">
        <!-- q6routing selects one playback backend per front end. Select TERT
             instead of simultaneously requiring the codec LPI route. -->
        <ctl name="LPI_MI2S_RX_0 Audio Mixer MultiMedia1" value="0" />
        <ctl name="TERT_MI2S_RX Audio Mixer MultiMedia1" value="1" />
        <ctl name="TFA Profile" value="music" />
    </path>

    <!-- Earpiece (stock "handset"): physically broken on Pierre's unit. r5 review F62: selected when Android routes ordinary
         playback (VoIP / IN_COMMUNICATION) to the earpiece (vendor.a6l.audio.media_out=earpiece). -->
    <path name="handset">
        <ctl name="Digital RX1 MIX1 INP1" value="RX1" />
        <ctl name="RDAC2 MUX" value="RX1" />
        <ctl name="Digital RX1 Digital Volume" value="78" />
        <ctl name="EAR_S" value="Switch" />
    </path>

    <!-- rom-v2 (merge): in-call output while vendor.a6l.voice.active=1. Downlink comes from the DSP voice session
         (LPI_MI2S_RX_0 Voice Mixer VoiceMMode1, set by a6l-q6voiced -r). 0 dB digital (raw 84) = level proven on 24 Sep
         (audfix: stock voice-headphones = headphones at 84; optional +3/+6 dB = 87/90, hard cap 90). -->
    <path name="voice-headphones">
        <ctl name="Digital RX1 MIX1 INP1" value="RX1" />
        <ctl name="Digital RX2 MIX1 INP1" value="RX2" />
        <ctl name="RDAC2 MUX" value="RX2" />
        <ctl name="Digital RX1 Digital Volume" value="84" />
        <ctl name="Digital RX2 Digital Volume" value="84" />
        <ctl name="HPHL" value="Switch" />
        <ctl name="HPHR" value="Switch" />
    </path>

    <!-- In-call earpiece (healthy units; the earpiece of Pierre's unit is broken) -->
    <path name="voice-handset">
        <ctl name="Digital RX1 MIX1 INP1" value="RX1" />
        <ctl name="RDAC2 MUX" value="RX1" />
        <ctl name="Digital RX1 Digital Volume" value="84" />
        <ctl name="EAR_S" value="Switch" />
    </path>

    <!-- r5 review F7 (28 Sep 2026): in-call speakerphone (stock "voice-speaker" = TFA Profile voice). The downlink reaches the
         TFA9894 through the DSP voice route TERT_MI2S_RX Voice Mixer VoiceMMode1, set by a6l-q6voiced when the audio HAL
         reports vendor.a6l.audio.call_out=speaker; the codec outputs stay at the reset state (ZERO). -->
    <path name="voice-speaker">
        <ctl name="TFA Profile" value="voice" />
    </path>

    <!-- btcall (29 Sep 2026, docs/android-bt-audio-20260929.md): modem call carried to a Bluetooth headset through the CPU
         (AudioFlinger software bridge, persist.vendor.a6l.btcall.bridge=1). The DSP voice RX stays on LPI_MI2S_RX_0 (it
         clocks the session) but nothing may be audible from the phone, and the phone mic must not reach the uplink:
         reset state (EAR_S/HPHL/HPHR ZERO, DEC1 MUX ZERO); the ctl lines only restate it (libaudioroute needs a path). -->
    <path name="voice-bridge">
        <ctl name="EAR_S" value="ZERO" />
        <ctl name="HPHL" value="ZERO" />
        <ctl name="HPHR" value="ZERO" />
    </path>

    <path name="bridge-mic">
        <ctl name="Digital DEC1 MUX" value="ZERO" />
    </path>

    <!-- audio6 (25 Sep 2026), from stock vendor/etc/mixer_paths.xml (the file the stock HAL loads for "sdm660-snd-card"; the
         _mtp/_skus variants with DMIC3/DMIC4 are for other boards). Stock HAL: handset-mic = voice-rec-mic = unprocessed = adc1;
         camcorder = adc1 + adc3 stereo (not possible here: mono TX path) -> main mic.
         ADC volumes are raw 0..8 as stock (the mainline TLV label "6 dB/step" is not the real step; same register field).
         Bias comes from DAPM through the DT audio-routing: AMIC1 <- MIC BIAS External1, AMIC2 <- MIC BIAS External2,
         AMIC3 <- MIC BIAS External1 (audio6 ROM DT addition; stock: AMIC3 <- MIC BIAS External). -->

    <!-- Main (bottom) microphone: stock "handset-mic" -> "adc1" (ADC1 Volume 8, DEC1 MUX ADC1, ADC1_INP1 Switch = hard-wired
         in mainline). a6l-audio-route selects it whenever no headset mic is detected. -->
    <path name="main-mic">
        <ctl name="Digital DEC1 MUX" value="ADC1" />
        <ctl name="Digital CIC1 MUX" value="AMIC" />
        <ctl name="ADC1 Volume" value="8" />
        <ctl name="Digital TX1 Digital Volume" value="84" />
    </path>

    <!-- Headset microphone: stock "headset-mic" -> "adc2" + override ADC2 Volume 6 (ADC2 MUX INP2, DEC1 MUX ADC2).
         Selected by a6l-audio-route when the "Mic Jack" kcontrol is on (4-pole headset). -->
    <path name="headset-mic">
        <ctl name="ADC2 MUX" value="INP2" />
        <ctl name="Digital DEC1 MUX" value="ADC2" />
        <ctl name="Digital CIC1 MUX" value="AMIC" />
        <ctl name="ADC2 Volume" value="6" />
        <ctl name="Digital TX1 Digital Volume" value="84" />
    </path>

    <!-- Secondary (top) microphone: stock "adc3" (speaker-mic / factory-aux-mic): ADC3 Volume 8, ADC2 MUX INP3, DEC1 MUX ADC2
         (the analog codec puts ADC3 on serial TX2 = digital "ADC2"). Not selected automatically (no ECNS without ACDB). -->
    <path name="secondary-mic">
        <ctl name="ADC2 MUX" value="INP3" />
        <ctl name="Digital DEC1 MUX" value="ADC2" />
        <ctl name="Digital CIC1 MUX" value="AMIC" />
        <ctl name="ADC3 Volume" value="8" />
        <ctl name="Digital TX1 Digital Volume" value="84" />
    </path>
</mixer>
