+bool StreamPrimary::a6lFollowBackEnd() {
+    const int be = a6lSelectedMm1BackEnd();
+    if (be != kA6lBeUnknown && be != mA6lOpenBackEnd && !mAlsaDeviceProxies.empty()) {
+        LOG(INFO) << __func__ << ": A6L MultiMedia1 back end " << a6lBackEndName(mA6lOpenBackEnd) << " -> "
+                  << a6lBackEndName(be) << " under the running PCM: reopening it";
+        StreamAlsaMonoPipe::shutdown();  // Stop, join the I/O thread and close the PCM (as standby does).
+    }
+    if (mAlsaDeviceProxies.empty()) {
+        if (::android::status_t status = StreamAlsaMonoPipe::start(); status != ::android::OK) {
+            LOG_IF(ERROR, !mA6lReopenFailed)
+                    << __func__ << ": A6L PCM reopen failed (" << status << "), dropping audio until it opens";
+            mA6lReopenFailed = true;
+            return false;
+        }
+        mA6lOpenBackEnd = a6lSelectedMm1BackEnd();
+        LOG(INFO) << __func__ << ": A6L PCM reopened on " << a6lBackEndName(mA6lOpenBackEnd);
+        mA6lReopenFailed = false;
+    }
+    return true;
+}
