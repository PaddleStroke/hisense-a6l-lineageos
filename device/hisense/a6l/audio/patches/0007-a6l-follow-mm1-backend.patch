+
+// Hisense A6L audio-20261010 r3 (10 Oct 2026, firmware/extracted/audio-20261010 README section 0): the MultiMedia1
+// playback front end (pcmC0D0p) has ONE DSP back end, chosen by a6l-audio-route from vendor.a6l.audio.media_out:
+// TERT_MI2S_RX (TFA9894 loudspeaker) or LPI_MI2S_RX_0 (WCD codec: wired headset/headphones, earpiece). q6routing opens
+// the ADM COPP on the back end selected when the PCM is prepared (q6routing_stream_open) and never moves a running
+// session, so a back-end switch under a running PCM breaks it. Live test 10 Oct: speaker -> headphones while the PCM ran
+// = every pcm_write failed (-1) until standby (no headset audio); headphones -> speaker = no error but a silent speaker;
+// a PCM opened after the switch played normally. The primary output therefore follows the selected back end: when it
+// differs from the one the PCM was opened on, the PCM is closed and reopened (one HAL buffer is lost at a route change).
+// Off switch for tests: vendor.a6l.audio.media_follow_be=false (read when the PCM is opened;
+// vendor.a6l.audio.media_* = vendor_a6l_audio_prop, which this HAL already sets, so no new SELinux rule).
+enum A6lBackEnd { kA6lBeUnknown = 0, kA6lBeTert = 1, kA6lBeLpi = 2 };
+
+const char* a6lBackEndName(int be) {
+    return be == kA6lBeTert ? "TERT_MI2S_RX" : be == kA6lBeLpi ? "LPI_MI2S_RX_0" : "none";
+}
+
+struct A6lMm1Controls {
+    struct mixer* mixer = nullptr;
+    struct mixer_ctl* tert = nullptr;
+    struct mixer_ctl* lpi = nullptr;
+};
+
+// Opened once per process (the HAL keeps the card open anyway); nullptr mixer = follower disabled.
+const A6lMm1Controls& a6lMm1Controls() {
+    static const A6lMm1Controls controls = [] {
+        A6lMm1Controls c;
+        if (::android::base::GetProperty("ro.product.vendor.device", "") != "a6l") return c;
+        c.mixer = mixer_open(primary::PrimaryMixer::kAlsaCard);
+        if (c.mixer == nullptr) {
+            LOG(ERROR) << "a6lMm1Controls: mixer_open failed, MultiMedia1 back-end follower disabled";
+            return c;
+        }
+        c.tert = mixer_get_ctl_by_name(c.mixer, "TERT_MI2S_RX Audio Mixer MultiMedia1");
+        c.lpi = mixer_get_ctl_by_name(c.mixer, "LPI_MI2S_RX_0 Audio Mixer MultiMedia1");
+        if (c.tert == nullptr || c.lpi == nullptr) {
+            LOG(WARNING) << "a6lMm1Controls: no MultiMedia1 routing controls, back-end follower disabled";
+            mixer_close(c.mixer);
+            return A6lMm1Controls{};
+        }
+        LOG(INFO) << "a6lMm1Controls: A6L MultiMedia1 back-end follower ready";
+        return c;
+    }();
+    return controls;
+}
+
+// q6routing reports 1 only for the back end the session is routed to, so at most one control reads 1. Both 0 = being
+// switched (or no back end): undecided, looked at again at the next buffer.
+int a6lSelectedMm1BackEnd() {
+    const A6lMm1Controls& c = a6lMm1Controls();
+    if (c.mixer == nullptr) return kA6lBeUnknown;
+    const int tert = mixer_ctl_get_value(c.tert, 0);
+    const int lpi = mixer_ctl_get_value(c.lpi, 0);
+    if (tert == 1 && lpi == 0) return kA6lBeTert;
+    if (lpi == 1 && tert == 0) return kA6lBeLpi;
+    return kA6lBeUnknown;
+}
 }  // namespace
 
