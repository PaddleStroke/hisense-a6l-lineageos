 namespace aidl::android::hardware::audio::core {
 
+// A6L-F37-BEGIN (host-tested by device/hisense/a6l/audio/tests/test-telephony-volume.sh)
+// Hisense A6L r5 review round4 F37 (28 Sep 2026): Android's in-call volume (TelecomConfig.voiceVolume, from
+// DeviceHalAidl::setVoiceVolume) is applied to the modem call downlink in the ADSP: a6l-q6voiced request
+// "volume <0..1>" -> kernel control "VoiceMMode1 RX Volume Step" (CVP VSS_IVOLUME_CMD_SET_STEP, kept and restored at
+// every call start). Reply "OK volume=<step>" or "ERR <errno> <text>". Returns 0 or a positive errno.
+static int a6lQ6voicedVolume(float volume, std::string* reply, const char* path = "/dev/socket/a6l_q6voiced") {
+    if (!(volume >= 0.0f && volume <= 1.0f)) return EINVAL;
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return errno;
+    sockaddr_un sa{};
+    sa.sun_family = AF_UNIX;
+    strncpy(sa.sun_path, path, sizeof(sa.sun_path) - 1);
+    char cmd[40];
+    const int len = snprintf(cmd, sizeof(cmd), "volume %.4f\n", static_cast<double>(volume));
+    int err = 0;
+    if (connect(fd, reinterpret_cast<sockaddr*>(&sa), sizeof(sa)) < 0 || write(fd, cmd, len) != len) {
+        err = errno ? errno : EIO;
+    } else {
+        pollfd p{fd, POLLIN, 0};
+        char buf[128] = {};
+        ssize_t n = poll(&p, 1, 4000) > 0 ? read(fd, buf, sizeof(buf) - 1) : -1;
+        if (n <= 0) {
+            err = ETIMEDOUT;
+        } else {
+            *reply = std::string(buf, static_cast<size_t>(n));
+            if (reply->rfind("OK volume=", 0) == 0) err = 0;
+            else if (reply->rfind("ERR ", 0) == 0) err = atoi(reply->c_str() + 4) > 0 ? atoi(reply->c_str() + 4) : EPROTO;
+            else err = EPROTO;
+        }
+    }
+    close(fd);
+    return err;
+}
+// A6L-F37-END
