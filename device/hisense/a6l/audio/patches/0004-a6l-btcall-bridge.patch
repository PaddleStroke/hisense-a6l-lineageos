Hisense A6L btcall (29 Sep 2026, docs/android-bt-audio-20260929.md) for the AOSP AIDL example audio HAL (StreamPrimary),
on top of 0001..0003 (touches only AOSP lines, so every patch of the series still reverse-applies for the pipeline's
"already applied" check). Dormant unless the bridge is enabled:
  - with persist.vendor.a6l.btcall.bridge=1 the Telephony Rx input and Telephony Tx output streams of the AudioFlinger
    software call bridge (bridge policy audio/bluetooth/btcall/audio_policy_configuration_btcall.xml) open ALSA
    pcmC0D<persist.vendor.a6l.btcall.dl_pcm>c (in-call record front end = downlink) and
    pcmC0D<persist.vendor.a6l.btcall.ul_pcm>p (in-call music front end = uplink) instead of the stub driver.
    Property unset/0 or no valid pcm number (1..31): AOSP behaviour (stub driver).
  - the "call is bridged" state is not published by the HAL: a6l-q6voiced and a6l-audio-route see the downlink front end
    running in /proc/asound (no new IPC, no change to the 0002 publisher).
Applied in hardware/interfaces by tools/rom-v2-pipeline.sh (audio/patches/*.patch, in order).

--- a/audio/aidl/default/primary/StreamPrimary.cpp
+++ b/audio/aidl/default/primary/StreamPrimary.cpp
@@ -39,6 +39,23 @@
 
 namespace aidl::android::hardware::audio::core {
 
+namespace {
+// Hisense A6L btcall (29 Sep 2026, docs/android-bt-audio-20260929.md): with persist.vendor.a6l.btcall.bridge=1 the
+// Telephony Rx input / Telephony Tx output streams of the AudioFlinger software call bridge (bridge policy
+// audio/bluetooth/btcall) run on real ALSA PCMs of card 0 instead of the stub driver:
+// persist.vendor.a6l.btcall.dl_pcm (in-call record front end, downlink, capture) and
+// persist.vendor.a6l.btcall.ul_pcm (in-call music front end, uplink, playback). -1 = AOSP behaviour (stub).
+int a6lBtcallPcm(const AudioDevice& device) {
+    const auto t = device.type.type;
+    if (t != AudioDeviceType::IN_TELEPHONY_RX && t != AudioDeviceType::OUT_TELEPHONY_TX) return -1;
+    if (!GetBoolProperty("persist.vendor.a6l.btcall.bridge", false)) return -1;
+    return ::android::base::GetIntProperty<int>(t == AudioDeviceType::IN_TELEPHONY_RX
+                                                        ? "persist.vendor.a6l.btcall.dl_pcm"
+                                                        : "persist.vendor.a6l.btcall.ul_pcm",
+                                                -1, 1, 31);
+}
+}  // namespace
