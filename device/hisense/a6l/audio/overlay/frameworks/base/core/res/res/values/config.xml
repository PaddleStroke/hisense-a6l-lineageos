<?xml version="1.0" encoding="utf-8"?>
<!-- audio3 (24 Sep 2026): the ASoC headset jack of the Hisense A6L card is an input device (SW_HEADPHONE_INSERT /
     SW_MICROPHONE_INSERT, "Hisense A6L Headset Jack"); there is no h2w switch class / extcon. -->
<resources>
    <bool name="config_useDevInputEventForAudioJack">true</bool>
    <!-- audio-20261010: Pierre's rule, no volume reduction anywhere. Without this, the safe-media-volume feature drops the
         music volume on the wired headset to the "safe" index as soon as it is used above it (live test 10 Oct:
         volume_changed [3,15,8,15,com.android.systemui] twice) until the warning is confirmed, and re-arms after 20 h of
         music. Disabled: the persisted state becomes SAFE_MEDIA_VOLUME_DISABLED. Sound dosage (CSD) stays off (AOSP
         default false, set explicitly). -->
    <bool name="config_safe_media_volume_enabled">false</bool>
    <bool name="config_safe_sound_dosage_enabled">false</bool>
</resources>
